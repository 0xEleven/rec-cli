#!/usr/bin/env python3
"""rec-capture — Screen, area, dual-audio (mic + system), webcam & cursor recorder for rec-cli v2.0.0.

Backends (auto-detected):
  1. GNOME Wayland native DBus Screencast (org.gnome.Shell.Screencast)
  2. wlroots Wayland (wf-recorder + optional slurp)
  3. X11 (ffmpeg x11grab)

Produces:
  - <out>.mp4            (universal H.264 + AAC MP4)
  - <out>.cursor.json    (cursor track + manual zoom flags from SIGUSR2)
  - <out>.webcam.mp4     (optional synchronized webcam sidecar for dynamic bubble)
  - <out>.recproj        (ready-to-edit Studio project with flagged zoom points)
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or "/tmp") / f"rec-cli-{os.getuid()}"
CAP_STATE_FILE = RUNTIME_DIR / "screen_capture.json"


def detect_screen_size() -> tuple[int, int]:
    """Return primary display (width, height)."""
    for cmd in (
        ["xrandr", "--current"],
    ):
        if shutil.which(cmd[0]):
            try:
                out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, text=True, timeout=2)
                m = re.search(r"(\d{3,4})x(\d{3,4})\s+[^\n]*\*", out)
                if m:
                    return (int(m.group(1)), int(m.group(2)))
            except Exception:
                pass
    best = (1920, 1080)
    best_area = 0
    for st in Path("/sys/class/drm").glob("*/status"):
        try:
            if st.read_text().strip() != "connected":
                continue
            mode = (st.parent / "modes").read_text().splitlines()[0].strip()
            m = re.match(r"(\d+)x(\d+)", mode)
            if m:
                w, h = int(m.group(1)), int(m.group(2))
                if w * h > best_area:
                    best_area = w * h
                    best = (w, h)
        except Exception:
            continue
    return best


def list_webcams() -> list[str]:
    cams = []
    for p in sorted(Path("/dev").glob("video*")):
        # Typically even-numbered v4l2 nodes are capture devices
        idx_str = p.name.replace("video", "")
        if idx_str.isdigit() and int(idx_str) % 2 == 0:
            cams.append(str(p))
    return cams


def detect_backend() -> str:
    sess = os.environ.get("XDG_SESSION_TYPE", "").lower()
    desk = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    if sess == "wayland" or os.environ.get("WAYLAND_DISPLAY"):
        if "gnome" in desk and shutil.which("gdbus"):
            return "gnome-dbus"
        if shutil.which("wf-recorder"):
            return "wf-recorder"
        if shutil.which("gdbus"):
            return "gnome-dbus"
    if os.environ.get("DISPLAY") and shutil.which("ffmpeg"):
        return "x11grab"
    if shutil.which("wf-recorder"):
        return "wf-recorder"
    return "x11grab"


def get_cursor_xy() -> tuple[int, int] | None:
    if shutil.which("xdotool"):
        try:
            out = subprocess.check_output(
                ["xdotool", "getmouselocation", "--shell"],
                stderr=subprocess.DEVNULL, text=True, timeout=0.4,
            )
            mx = re.search(r"X=(\d+)", out)
            my = re.search(r"Y=(\d+)", out)
            if mx and my:
                return (int(mx.group(1)), int(my.group(2)))
        except Exception:
            pass
    return None


def get_pipewire_monitor_target() -> str:
    """Find default audio sink monitor node for system audio capture."""
    if shutil.which("pactl"):
        try:
            sink = subprocess.check_output(
                ["pactl", "get-default-sink"], stderr=subprocess.DEVNULL, text=True, timeout=2
            ).strip()
            if sink:
                return f"{sink}.monitor"
        except Exception:
            pass
    return ""


class ScreenCaptureSession:
    def __init__(self, args: argparse.Namespace):
        self.args = args
        self.backend = args.backend if args.backend != "auto" else detect_backend()
        self.screen_w, self.screen_h = detect_screen_size()
        self.stop_event = threading.Event()
        self.zoom_flags: list[tuple[float, float, float]] = []
        self.cursor_track: list[list] = []
        self.t0 = 0.0
        self.procs: list[subprocess.Popen] = []
        self.gnome_active = False

    def _on_stop_sig(self, _sig, _frame):
        self.stop_event.set()

    def _on_zoom_flag(self, _sig, _frame):
        """SIGUSR2: mark a manual zoom point at the current timestamp + cursor position."""
        rel_t = max(0.0, time.monotonic() - self.t0)
        xy = get_cursor_xy()
        if xy:
            nx = max(0.1, min(0.9, xy[0] / max(1, self.screen_w)))
            ny = max(0.1, min(0.9, xy[1] / max(1, self.screen_h)))
        else:
            nx, ny = 0.5, 0.5
        self.zoom_flags.append((round(rel_t, 2), round(nx, 3), round(ny, 3)))
        self.cursor_track.append([round(rel_t, 3), round(nx, 4), round(ny, 4), 1])

    def _cursor_loop(self):
        while not self.stop_event.is_set():
            rel_t = max(0.0, time.monotonic() - self.t0)
            xy = get_cursor_xy()
            if xy:
                nx = max(0.0, min(1.0, xy[0] / max(1, self.screen_w)))
                ny = max(0.0, min(1.0, xy[1] / max(1, self.screen_h)))
                self.cursor_track.append([round(rel_t, 3), round(nx, 4), round(ny, 4), 0])
            self.stop_event.wait(0.05)

    def _start_video(self, raw_vid: Path) -> bool:
        fps = int(self.args.fps)
        area = self.args.area  # "x,y,w,h" or ""

        if self.backend == "gnome-dbus":
            draw_cur = "false" if self.args.hide_os_cursor else "true"
            opts = f"{{'framerate': <uint32 {fps}>, 'draw-cursor': <{draw_cur}>}}"
            if area and re.match(r"^\d+,\d+,\d+,\d+$", area):
                x, y, w, h = [int(v) for v in area.split(",")]
                cmd = [
                    "gdbus", "call", "--session",
                    "--dest", "org.gnome.Shell.Screencast",
                    "--object-path", "/org/gnome/Shell/Screencast",
                    "--method", "org.gnome.Shell.Screencast.ScreencastArea",
                    str(x), str(y), str(w), str(h), str(raw_vid), opts,
                ]
            else:
                cmd = [
                    "gdbus", "call", "--session",
                    "--dest", "org.gnome.Shell.Screencast",
                    "--object-path", "/org/gnome/Shell/Screencast",
                    "--method", "org.gnome.Shell.Screencast.Screencast",
                    str(raw_vid), opts,
                ]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if res.returncode == 0 and "true" in res.stdout.lower():
                self.gnome_active = True
                return True
            print(f"GNOME Screencast unavailable ({res.stderr.strip() or res.stdout.strip()}), trying fallback...", file=sys.stderr)
            self.backend = "wf-recorder" if shutil.which("wf-recorder") else "x11grab"

        if self.backend == "wf-recorder" and shutil.which("wf-recorder"):
            cmd = ["wf-recorder", "-f", str(raw_vid), "-r", str(fps)]
            if area and re.match(r"^\d+,\d+,\d+,\d+$", area):
                x, y, w, h = area.split(",")
                cmd.extend(["-g", f"{x},{y} {w}x{h}"])
            self.procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            return True

        if shutil.which("ffmpeg") and os.environ.get("DISPLAY"):
            disp = os.environ.get("DISPLAY", ":0")
            if area and re.match(r"^\d+,\d+,\d+,\d+$", area):
                x, y, w, h = [int(v) for v in area.split(",")]
                w -= w % 2
                h -= h % 2
                inp = f"{disp}+{x},{y}"
                sz = f"{w}x{h}"
            else:
                inp = disp
                sz = f"{self.screen_w}x{self.screen_h}"
            cmd = [
                "ffmpeg", "-y", "-v", "error",
                "-f", "x11grab", "-framerate", str(fps),
                "-video_size", sz,
                "-draw_mouse", "0" if self.args.hide_os_cursor else "1",
                "-i", inp,
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "18",
                "-pix_fmt", "yuv420p", str(raw_vid),
            ]
            self.procs.append(subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            return True

        return False

    def _start_audio(self, mic_wav: Path, sys_wav: Path):
        if self.args.mic:
            if shutil.which("pw-record"):
                self.procs.append(subprocess.Popen(
                    ["pw-record", "--format", "s16", "--rate", "48000", "--channels", "2", str(mic_wav)],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                ))
            elif shutil.which("ffmpeg"):
                self.procs.append(subprocess.Popen(
                    ["ffmpeg", "-y", "-v", "error", "-f", "pulse", "-i", "default", str(mic_wav)],
                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                ))
        if self.args.system_audio:
            mon = get_pipewire_monitor_target()
            if shutil.which("pw-record"):
                cmd = ["pw-record", "--format", "s16", "--rate", "48000", "--channels", "2"]
                if mon:
                    cmd.extend(["--target", mon])
                else:
                    cmd.extend(["-P", "stream.capture.sink=true"])
                cmd.append(str(sys_wav))
                self.procs.append(subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
            elif mon and shutil.which("ffmpeg"):
                self.procs.append(subprocess.Popen(
                    ["ffmpeg", "-y", "-v", "error", "-f", "pulse", "-i", mon, str(sys_wav)],
                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                ))

    def _start_webcam(self, webcam_mp4: Path):
        if not self.args.webcam:
            return
        dev = self.args.webcam_device or "/dev/video0"
        if not os.path.exists(dev) or not shutil.which("ffmpeg"):
            return
        self.procs.append(subprocess.Popen(
            [
                "ffmpeg", "-y", "-v", "error",
                "-f", "v4l2", "-framerate", "30", "-video_size", "640x480",
                "-i", dev,
                "-c:v", "libx264", "-preset", "ultrafast", "-crf", "20",
                "-pix_fmt", "yuv420p", str(webcam_mp4),
            ],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ))

    def _stop_all(self):
        if self.gnome_active and shutil.which("gdbus"):
            try:
                subprocess.run(
                    [
                        "gdbus", "call", "--session",
                        "--dest", "org.gnome.Shell.Screencast",
                        "--object-path", "/org/gnome/Shell/Screencast",
                        "--method", "org.gnome.Shell.Screencast.StopScreencast",
                    ],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=4,
                )
            except Exception:
                pass
            self.gnome_active = False

        for p in self.procs:
            try:
                if p.poll() is None:
                    if p.stdin:
                        try:
                            p.stdin.write(b"q\n")
                            p.stdin.flush()
                        except Exception:
                            pass
                    p.send_signal(signal.SIGINT)
            except Exception:
                pass
        for p in self.procs:
            try:
                p.wait(timeout=5)
            except Exception:
                try:
                    p.terminate()
                    p.wait(timeout=2)
                except Exception:
                    pass

    def run(self) -> int:
        signal.signal(signal.SIGINT, self._on_stop_sig)
        signal.signal(signal.SIGTERM, self._on_stop_sig)
        signal.signal(signal.SIGUSR1, self._on_stop_sig)
        signal.signal(signal.SIGUSR2, self._on_zoom_flag)

        out_mp4 = Path(self.args.output)
        out_mp4.parent.mkdir(parents=True, exist_ok=True)
        work_dir = Path(tempfile.mkdtemp(prefix="rec-cap-"))
        raw_vid = work_dir / ("raw.webm" if self.backend == "gnome-dbus" else "raw.mp4")
        mic_wav = work_dir / "mic.wav"
        sys_wav = work_dir / "sys.wav"
        webcam_mp4 = out_mp4.with_suffix(".webcam.mp4")

        RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
        self.t0 = time.monotonic()

        if not self._start_video(raw_vid):
            print("Error: could not start screen capture backend.", file=sys.stderr)
            shutil.rmtree(work_dir, ignore_errors=True)
            return 1

        self._start_audio(mic_wav, sys_wav)
        self._start_webcam(webcam_mp4)

        CAP_STATE_FILE.write_text(json.dumps({
            "pid": os.getpid(),
            "output": str(out_mp4),
            "backend": self.backend,
            "started_at": time.time(),
            "mic": bool(self.args.mic),
            "system_audio": bool(self.args.system_audio),
            "webcam": bool(self.args.webcam),
        }), encoding="utf-8")

        cur_thread = threading.Thread(target=self._cursor_loop, daemon=True)
        cur_thread.start()

        try:
            if self.args.duration > 0:
                self.stop_event.wait(self.args.duration)
            else:
                while not self.stop_event.is_set():
                    self.stop_event.wait(0.25)
        finally:
            self.stop_event.set()
            self._stop_all()
            CAP_STATE_FILE.unlink(missing_ok=True)

        # Wait briefly for GNOME Screencast to flush WebM file
        for _ in range(20):
            if raw_vid.is_file() and raw_vid.stat().st_size > 1000:
                break
            time.sleep(0.15)

        if not raw_vid.is_file() or raw_vid.stat().st_size < 500:
            print("Error: screen recording produced no video data.", file=sys.stderr)
            shutil.rmtree(work_dir, ignore_errors=True)
            return 1

        # Transcode & mux into universal CFR H.264 + AAC MP4
        cmd = ["ffmpeg", "-y", "-v", "error", "-i", str(raw_vid)]
        a_inputs = []
        if mic_wav.is_file() and mic_wav.stat().st_size > 512:
            cmd.extend(["-i", str(mic_wav)])
            a_inputs.append(len(a_inputs) + 1)
        if sys_wav.is_file() and sys_wav.stat().st_size > 512:
            cmd.extend(["-i", str(sys_wav)])
            a_inputs.append(len(a_inputs) + 1)

        if len(a_inputs) == 2:
            cmd.extend([
                "-filter_complex", f"[{a_inputs[0]}:a][{a_inputs[1]}:a]amix=inputs=2:duration=longest[aout]",
                "-map", "0:v:0", "-map", "[aout]",
                "-c:v", "libx264", "-preset", "veryfast", "-crf", "18",
                "-pix_fmt", "yuv420p", "-r", str(self.args.fps),
                "-c:a", "aac", "-b:a", "192k", "-shortest",
                "-movflags", "+faststart", str(out_mp4),
            ])
        elif len(a_inputs) == 1:
            cmd.extend([
                "-map", "0:v:0", "-map", f"{a_inputs[0]}:a:0",
                "-c:v", "libx264", "-preset", "veryfast", "-crf", "18",
                "-pix_fmt", "yuv420p", "-r", str(self.args.fps),
                "-c:a", "aac", "-b:a", "192k", "-shortest",
                "-movflags", "+faststart", str(out_mp4),
            ])
        else:
            cmd.extend([
                "-c:v", "libx264", "-preset", "veryfast", "-crf", "18",
                "-pix_fmt", "yuv420p", "-r", str(self.args.fps),
                "-an", "-movflags", "+faststart", str(out_mp4),
            ])

        res = subprocess.run(cmd, capture_output=True, text=True)
        shutil.rmtree(work_dir, ignore_errors=True)
        if res.returncode != 0:
            print(f"Error finalizing screen recording: {res.stderr.strip()}", file=sys.stderr)
            return 1

        # Save cursor track & zoom flags sidecar for Recordly-style Studio Editor
        if self.cursor_track:
            cur_file = out_mp4.with_suffix(".cursor.json")
            cur_file.write_text(json.dumps({
                "screen_w": self.screen_w,
                "screen_h": self.screen_h,
                "zoom_flags": self.zoom_flags,
                "track": self.cursor_track,
            }), encoding="utf-8")

        print(f"SAVED:{out_mp4}")
        return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Screen, audio & webcam capture for rec-cli")
    parser.add_argument("-o", "--output", default="", help="Output MP4 path")
    parser.add_argument("--fps", type=int, default=30, help="Capture framerate (default: 30)")
    parser.add_argument("--area", default="", help="Optional capture area x,y,w,h")
    parser.add_argument("--mic", action="store_true", help="Capture microphone audio")
    parser.add_argument("--system-audio", action="store_true", help="Capture system audio")
    parser.add_argument("--webcam", action="store_true", help="Capture synchronized webcam bubble sidecar")
    parser.add_argument("--webcam-device", default="/dev/video0", help="V4L2 webcam device")
    parser.add_argument("--hide-os-cursor", action="store_true", help="Hide OS cursor for Studio vector cursor")
    parser.add_argument("--backend", default="auto", choices=["auto", "gnome-dbus", "wf-recorder", "x11grab"])
    parser.add_argument("--duration", type=float, default=0.0, help="Optional max seconds (0 = until SIGINT/SIGUSR1)")
    parser.add_argument("--probe", action="store_true", help="Print detected backend, screen size & webcams as JSON")
    args = parser.parse_args()

    if args.probe:
        w, h = detect_screen_size()
        print(json.dumps({
            "backend": detect_backend(),
            "screen_w": w,
            "screen_h": h,
            "webcams": list_webcams(),
            "has_mic_tool": bool(shutil.which("pw-record") or shutil.which("ffmpeg")),
        }))
        return 0

    if not args.output:
        vdir = Path(os.environ.get("REC_VIDEO_DIR") or (Path.home() / "Videos/content"))
        vdir.mkdir(parents=True, exist_ok=True)
        args.output = str(vdir / f"screen_{time.strftime('%Y%m%d-%H%M%S')}.mp4")

    return ScreenCaptureSession(args).run()


if __name__ == "__main__":
    sys.exit(main())
