        hdr.addWidget(refresh_btn)

        launch_btn = QPushButton("+ New Recorded Terminal")
        launch_btn.setObjectName("recBtn")
        launch_btn.clicked.connect(lambda: self._launch_recorded_terminal())
        hdr.addWidget(launch_btn)
        lay.addLayout(hdr)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.sessions_container = QWidget()
        self.sessions_lay = QVBoxLayout(self.sessions_container)
        self.sessions_lay.setContentsMargins(0, 0, 4, 0)
        self.sessions_lay.setSpacing(10)
        self.sessions_lay.addStretch()
        scroll.setWidget(self.sessions_container)
        lay.addWidget(scroll, 1)
        return page

    # ---------------- Page 1: Terminal Selector ----------------
    def _build_terminals_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(24, 22, 24, 20)
        lay.setSpacing(14)

        hdr = QHBoxLayout()
        title_col = QVBoxLayout()
        title_col.setSpacing(2)
        t = QLabel("Terminals")
        t.setObjectName("pageTitle")
        sub = QLabel("Select which terminals auto-record when opened.")
        sub.setObjectName("muted")
        title_col.addWidget(t)
        title_col.addWidget(sub)
        hdr.addLayout(title_col)
        hdr.addStretch()

        all_lbl = QLabel("Record all")
        all_lbl.setObjectName("muted")
        selected_set = {x.strip().lower() for x in self.cfg.get("REC_TERMINALS", "kitty,tabby").split(",") if x.strip()}
        is_all = "all" in selected_set
        self.all_terms_sw = self._register_switch(ToggleSwitch(is_all))
        self.all_terms_sw.toggled.connect(self._on_all_terms_toggled)
        hdr.addWidget(all_lbl)
        hdr.addSpacing(6)
        hdr.addWidget(self.all_terms_sw)
        lay.addLayout(hdr)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        inner = QWidget()
        grid = QGridLayout(inner)
        grid.setContentsMargins(0, 0, 4, 0)
        grid.setHorizontalSpacing(10)
        grid.setVerticalSpacing(10)

        for idx, (tid, label, bins) in enumerate(TERMINALS):
            installed = any(shutil.which(b) for b in bins)
            card = QFrame()
            card.setObjectName("panel")
            cl = QHBoxLayout(card)
            cl.setContentsMargins(14, 13, 14, 13)
            cl.setSpacing(10)

            info = QVBoxLayout()
            info.setSpacing(4)
            name_lbl = QLabel(label)
            name_lbl.setObjectName("rowTitle")
            st_row = QHBoxLayout()
            st_row.setContentsMargins(0, 0, 0, 0)
            st_lbl = QLabel("Installed" if installed else "Not installed")
            st_lbl.setObjectName("muted" if installed else "dim")
            st_lbl.setSizePolicy(QSizePolicy.Policy.Maximum, QSizePolicy.Policy.Fixed)
            st_row.addWidget(st_lbl)
            st_row.addStretch()
            self.term_status_lbls[tid] = st_lbl
            info.addWidget(name_lbl)
            info.addLayout(st_row)
            cl.addLayout(info, 1)

            sw = self._register_switch(ToggleSwitch(is_all or (tid in selected_set)))
            sw.setEnabled(not is_all)
            sw.toggled.connect(lambda _c, t_id=tid: self._save_selected_terminals())
            self.term_switches[tid] = sw
            cl.addWidget(sw)

            grid.addWidget(card, idx // 2, idx % 2)

        grid.setRowStretch(len(TERMINALS) // 2 + 1, 1)
        scroll.setWidget(inner)
        lay.addWidget(scroll, 1)
        return page

    # ---------------- Page 2: Clips Library ----------------
    def _build_clips_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
