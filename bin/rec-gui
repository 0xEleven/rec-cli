def make_logo_pixmap(size: int = 32, dark: bool = True) -> QPixmap:
    """Render our crisp minimal `> ●` vector badge directly via QPainter."""
    w = int(size * 1.5)
    h = size
    pm = QPixmap(w, h)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    bg = QColor("#1a1b26") if dark else QColor("#171923")
    border = QColor("#2f344a") if dark else QColor("#2a2e3f")
    p.setBrush(bg)
    p.setPen(QPen(border, 1.5))
    p.drawRoundedRect(QRectF(1, 1, w - 2, h - 2), h * 0.24, h * 0.24)

    # Crisp `>` chevron
    path = QPainterPath()
    path.moveTo(w * 0.24, h * 0.30)
    path.lineTo(w * 0.43, h * 0.50)
    path.lineTo(w * 0.24, h * 0.70)
    pen = QPen(QColor("#e4e7f2"), max(2.2, h * 0.10))
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.BrushStyle.NoBrush)
    p.drawPath(path)

    # Red recording dot
    r = h * 0.14
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#f0657a"))
    p.drawEllipse(QRectF(w * 0.69 - r, h * 0.50 - r, r * 2, r * 2))
    p.end()
    return pm


def read_config() -> dict[str, str]:
    cfg = {
        "REC_RESOLUTION": "auto",
        "REC_SPEED": "2",
        "REC_MAX_SECS": "300",
        "REC_FRAME": "on",
        "REC_REDACT": "on",
        "REC_REELS_COPY": "off",
        "REC_THEME": "tokyo-night",
        "REC_TERMINALS": "kitty,tabby",
        "REC_VIDEO_DIR": str(Path.home() / "Videos/content"),
        "REC_UI_THEME": "dark",
    }
    if CONF_FILE.is_file():
        for line in CONF_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.strip()
            try:
                v = shlex.split(v)[0] if v.strip() else ""
            except ValueError:
                v = v.strip().strip("'\"")
            cfg[k] = v
    return cfg


def write_config_key(key: str, val: str) -> None:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    lines = []
    if CONF_FILE.is_file():
        lines = [
            ln for ln in CONF_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
            if not ln.startswith(f"{key}=")
        ]
    lines.append(f"{key}={shlex.quote(val)}")
    tmp = CONF_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.replace(tmp, CONF_FILE)


def is_auto_enabled() -> bool:
    return not (AUTO_OFF_FLAG.exists() or LEGACY_AUTO_OFF.exists())


def set_auto_enabled(enabled: bool) -> None:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    if enabled:
        AUTO_OFF_FLAG.unlink(missing_ok=True)
        LEGACY_AUTO_OFF.unlink(missing_ok=True)
    else:
        AUTO_OFF_FLAG.touch()


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def load_legacy_asciinema() -> list[dict]:
    uid = os.getuid()
    found = []
    try:
        for entry in os.scandir("/proc"):
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            try:
                if os.stat(entry.path).st_uid != uid:
                    continue
                with open(f"{entry.path}/cmdline", "rb") as f:
                    parts = [x.decode("utf-8", "replace") for x in f.read().split(b"\x00") if x]
                if not parts:
                    continue
                if "asciinema" not in os.path.basename(parts[0]) and not any("asciinema" in p for p in parts[:2]):
                    continue
                if "rec" not in parts[1:4]:
                    continue
                cast = next((p for p in reversed(parts) if p.endswith(".cast")), "")
                started_at = os.path.getmtime(cast) if cast and os.path.exists(cast) else 0.0
                cast_size = os.path.getsize(cast) if cast and os.path.exists(cast) else 0
                try:
                    cwd = os.readlink(f"{entry.path}/cwd")
                except OSError:
                    cwd = ""
                found.append({
                    "pid": pid,
                    "child_pid": 0,
                    "state": "recording",
                    "name": "legacy-tab",
                    "terminal": "old-tab",
                    "cast": cast,
                    "meta": "",
                    "cwd": cwd,
                    "fg_cmd": "asciinema rec (pre-v1.3.0 tab — type exit in tab to save)",
                    "last_cmd": "",
                    "started_at": started_at,
                    "cast_size": cast_size,
                    "legacy": True,
                })
            except OSError:
                continue
    except OSError:
        pass
    return found


def load_live_sessions() -> list[dict]:
    out = []
    if SESS_DIR.is_dir():
        for p in sorted(SESS_DIR.glob("*.json")):
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                pid = int(data.get("pid", 0))
                if pid <= 0 or not is_pid_alive(pid):
                    p.unlink(missing_ok=True)
                    (ACTIVE_DIR / str(pid)).unlink(missing_ok=True)
                    continue
                cast = data.get("cast", "")
                if cast and os.path.exists(cast):
                    data["cast_size"] = os.path.getsize(cast)
                out.append(data)
            except Exception:
                continue
    out.extend(load_legacy_asciinema())
    order = {"recording": 0, "paused": 1, "standby": 2}
    out.sort(key=lambda x: (order.get(x.get("state", "standby"), 2), x.get("pid", 0)))
    return out


def send_session_cmd(pid: int, cmd_line: str) -> bool:
    try:
        SESS_DIR.mkdir(parents=True, exist_ok=True)
        with open(SESS_DIR / f"{pid}.cmd", "a", encoding="utf-8") as f:
            f.write(cmd_line.strip() + "\n")
        os.kill(pid, signal.SIGUSR1)
        return True
    except OSError:
        return False


def detect_display_label() -> str:
    try:
        out = subprocess.check_output(["rec-cli", "config"], stderr=subprocess.DEVNULL, text=True, timeout=2)
        for line in out.splitlines():
            if "detected" in line and "=" in line:
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return "auto"


def fmt_elapsed(started_at: float) -> str:
    if not started_at or started_at <= 0:
        return "00:00"
    sec = max(0, int(time.time() - started_at))
    m, s = divmod(sec, 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_size(n: int) -> str:
    if n <= 0:
        return "0 B"
    val = float(n)
    for u in ("B", "KB", "MB", "GB"):
        if val < 1024:
            return f"{int(val)} {u}" if u == "B" else f"{val:.1f} {u}"
        val /= 1024
    return f"{val:.1f} TB"


class WorkerThread(QThread):
    done = Signal(bool, str)

    def __init__(self, cmd: list[str], label: str):
        super().__init__()
        self.cmd = cmd
        self.label = label

    def run(self):
        try:
            proc = subprocess.run(self.cmd, capture_output=True, text=True)
            if proc.returncode == 0:
                self.done.emit(True, f"{self.label} complete")
            else:
                err = (proc.stderr or proc.stdout or "command failed").strip().splitlines()[-1]
                self.done.emit(False, f"{self.label} failed: {err}")
        except Exception as exc:
            self.done.emit(False, f"{self.label} error: {exc}")


class RecGuiWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.cfg = read_config()
        self.ui_mode = self.cfg.get("REC_UI_THEME", "dark")
        if self.ui_mode not in ("dark", "light"):
            self.ui_mode = "dark"
        self.workers: list[WorkerThread] = []
        self.last_sessions_sig = None
        self.last_clips_sig = None

        self.setWindowTitle("rec-cli")
        self.setMinimumSize(820, 580)
        self.resize(920, 640)
        self.setWindowIcon(QIcon(make_logo_pixmap(48, dark=True)))

        self._build_ui()
        self._apply_theme()
        self._refresh_sessions(force=True)
        self._refresh_clips(force=True)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self._on_tick)
        self.timer.start(1000)

    def _build_ui(self):
        root = QWidget()
        root.setObjectName("root")
        self.setCentralWidget(root)
        outer = QVBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # --- Top Header Bar ---
        top_bar = QFrame()
        top_bar.setObjectName("topBar")
        top_lay = QHBoxLayout(top_bar)
        top_lay.setContentsMargins(20, 14, 20, 14)
        top_lay.setSpacing(12)

        self.logo_lbl = QLabel()
        top_lay.addWidget(self.logo_lbl)

        title_col = QVBoxLayout()
        title_col.setSpacing(1)
        title_lbl = QLabel("rec-cli")
        title_lbl.setObjectName("appTitle")
        sub_lbl = QLabel(f"v{VERSION}")
        sub_lbl.setObjectName("dim")
        title_col.addWidget(title_lbl)
        title_col.addWidget(sub_lbl)
        top_lay.addLayout(title_col)

        self.live_pill = QLabel("Idle")
        self.live_pill.setObjectName("idlePill")
        top_lay.addWidget(self.live_pill)

        self.toast_pill = QLabel("")
        self.toast_pill.setObjectName("savedPill")
        self.toast_pill.hide()
        top_lay.addWidget(self.toast_pill)

        top_lay.addStretch()

        self.stop_all_btn = QPushButton("Stop All")
        self.stop_all_btn.setObjectName("dangerBtn")
        self.stop_all_btn.clicked.connect(self._stop_all)
        self.stop_all_btn.hide()
        top_lay.addWidget(self.stop_all_btn)

        self.auto_chk = QCheckBox("Auto-record")
        self.auto_chk.setChecked(is_auto_enabled())
        self.auto_chk.toggled.connect(self._on_auto_toggled)
        top_lay.addWidget(self.auto_chk)

        self.theme_btn = QPushButton("Light Mode" if self.ui_mode == "dark" else "Dark Mode")
        self.theme_btn.clicked.connect(self._toggle_theme)
        top_lay.addWidget(self.theme_btn)

        outer.addWidget(top_bar)

        # --- Navigation Tabs ---
        nav_bar = QFrame()
        nav_bar.setObjectName("navBar")
        nav_lay = QHBoxLayout(nav_bar)
        nav_lay.setContentsMargins(16, 0, 16, 0)
        nav_lay.setSpacing(4)

        self.nav_btns: list[QPushButton] = []
        for idx, label in enumerate(("Live Sessions", "Terminals & Settings", "Clips")):
            btn = QPushButton(label)
            btn.setObjectName("navBtn")
            btn.setProperty("active", idx == 0)
            btn.clicked.connect(lambda _checked=False, i=idx: self._switch_page(i))
            nav_lay.addWidget(btn)
            self.nav_btns.append(btn)
        nav_lay.addStretch()

        outer.addWidget(nav_bar)

        # --- Pages ---
        self.stack = QStackedWidget()
        self.stack.addWidget(self._build_sessions_page())
        self.stack.addWidget(self._build_settings_page())
        self.stack.addWidget(self._build_clips_page())
        outer.addWidget(self.stack, 1)

    def _switch_page(self, idx: int):
        self.stack.setCurrentIndex(idx)
        for i, b in enumerate(self.nav_btns):
            b.setProperty("active", i == idx)
            b.style().unpolish(b)
            b.style().polish(b)
        if idx == 0:
            self._refresh_sessions(force=True)
        elif idx == 2:
            self._refresh_clips(force=True)

    # ---------------- Page 1: Live Sessions ----------------
    def _build_sessions_page(self) -> QWidget:
        page = QWidget()
        lay = QVBoxLayout(page)
        lay.setContentsMargins(24, 20, 24, 20)
        lay.setSpacing(14)

        hdr = QHBoxLayout()
        t = QLabel("Active Terminal Sessions")
        t.setObjectName("sectionTitle")
        hdr.addWidget(t)
        hdr.addStretch()

        launch_btn = QPushButton("+ New Recorded Terminal")
        launch_btn.setObjectName("primaryBtn")
        launch_btn.clicked.connect(self._launch_recorded_terminal)
        hdr.addWidget(launch_btn)

        refresh_btn = QPushButton("Refresh")
        refresh_btn.clicked.connect(lambda: self._refresh_sessions(force=True))
        hdr.addWidget(refresh_btn)
        lay.addLayout(hdr)

        hint = QLabel("Control parallel recordings across Kitty, Tabby, and remote SSH sessions by PID without dropping connections.")
        hint.setObjectName("muted")
        hint.setWordWrap(True)
        lay.addWidget(hint)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        self.sessions_container = QWidget()
        self.sessions_lay = QVBoxLayout(self.sessions_container)
        self.sessions_lay.setContentsMargins(0, 0, 4, 0)
        self.sessions_lay.setSpacing(10)
        self.sessions_lay.addStretch()
        scroll.setWidget(self.sessions_container)
        lay.addWidget(scroll, 1)
        return page

