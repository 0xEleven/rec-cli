        self.frame_chk.toggled.connect(lambda c: self._save_setting("REC_FRAME", "on" if c else "off"))

        self.redact_chk = QCheckBox("Auto-redact secrets (API keys / tokens)")
        self.redact_chk.setChecked(self.cfg.get("REC_REDACT", "on").lower() not in ("off", "0", "false"))
        self.redact_chk.toggled.connect(lambda c: self._save_setting("REC_REDACT", "on" if c else "off"))

        self.reels_copy_chk = QCheckBox("Also export 9:16 Reels copy")
        self.reels_copy_chk.setChecked(self.cfg.get("REC_REELS_COPY", "off").lower() in ("on", "1", "true"))
        self.reels_copy_chk.toggled.connect(lambda c: self._save_setting("REC_REELS_COPY", "on" if c else "off"))

        toggles.addWidget(self.frame_chk)
        toggles.addWidget(self.redact_chk)
        toggles.addWidget(self.reels_copy_chk)
        toggles.addStretch()
        vc_lay.addLayout(toggles)

        lay.addWidget(vid_card)
        lay.addStretch()
        scroll.setWidget(inner)
        return scroll

