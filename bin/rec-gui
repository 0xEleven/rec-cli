        self.theme_combo.currentIndexChanged.connect(
            lambda: self._save_setting("REC_THEME", self.theme_combo.currentData())
        )

        form.addWidget(self._field_label("Resolution"), 0, 0)
        form.addWidget(self.res_combo, 1, 0)
        form.addWidget(self._field_label("Playback Speed"), 0, 1)
        form.addWidget(self.speed_combo, 1, 1)
        form.addWidget(self._field_label("Max Clip Length"), 2, 0)
        form.addWidget(self.maxlen_combo, 3, 0)
        form.addWidget(self._field_label("Terminal Video Theme"), 2, 1)
        form.addWidget(self.theme_combo, 3, 1)
        vc_lay.addLayout(form)

        # Output folder row
        dir_row = QHBoxLayout()
        dir_row.setSpacing(8)
        self.dir_edit = QLineEdit(self.cfg.get("REC_VIDEO_DIR", str(Path.home() / "Videos/content")))
        self.dir_edit.setReadOnly(True)
        browse_btn = QPushButton("Browse…")
        browse_btn.clicked.connect(self._browse_video_dir)
        open_dir_btn = QPushButton("Open Folder")
        open_dir_btn.clicked.connect(self._open_video_dir)
        dir_row.addWidget(self._field_label("Save Clips To"))
        dir_row.addWidget(self.dir_edit, 1)
        dir_row.addWidget(browse_btn)
