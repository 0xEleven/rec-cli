    # ---------------- Theme & Visual Updates ----------------
    def _field_label(self, text: str) -> QLabel:
        lbl = QLabel(text)
        lbl.setObjectName("muted")
        return lbl

    def _select_combo_data(self, combo: QComboBox, target: str):
        for i in range(combo.count()):
            if str(combo.itemData(i)).lower() == str(target).lower():
                combo.setCurrentIndex(i)
                return

    def _show_toast(self, msg: str):
        self.toast_pill.setText(msg)
        self.toast_pill.show()
        QTimer.singleShot(2400, self.toast_pill.hide)

    def _update_nav_icons(self):
        t = THEMES["light" if self.ui_mode == "light" else "dark"]
        cur = self.stack.currentIndex()
        for i, (kind, _label) in enumerate(self.nav_defs):
            col = t["text"] if i == cur else t["text_muted"]
            self.nav_btns[i].setIcon(make_nav_icon(kind, col, 16))
        self.dark_btn.setIcon(make_nav_icon("moon", t["text"] if self.ui_mode == "dark" else t["text_muted"], 13))
        self.light_btn.setIcon(make_nav_icon("sun", t["text"] if self.ui_mode == "light" else t["text_muted"], 13))

    def _apply_theme(self):
        self.setStyleSheet(build_stylesheet(self.ui_mode))
        self.logo_lbl.setPixmap(make_logo_pixmap(26, dark=(self.ui_mode == "dark")))
        self.dark_btn.setProperty("active", self.ui_mode == "dark")
        self.light_btn.setProperty("active", self.ui_mode == "light")
        for b in (self.dark_btn, self.light_btn):
            b.style().unpolish(b)
            b.style().polish(b)
        for sw, red in self.switches:
            sw.set_theme(self.ui_mode, accent_red=red)
        for cb in self.combos:
            cb.set_theme(self.ui_mode)
        self._update_nav_icons()

    def _set_theme(self, mode: str):
        if mode not in ("dark", "light") or mode == self.ui_mode:
            return
        self.ui_mode = mode
        write_config_key("REC_UI_THEME", self.ui_mode)
        self._apply_theme()

    def _toggle_theme(self):
        self._set_theme("light" if self.ui_mode == "dark" else "dark")

    # ---------------- Config Actions ----------------
    def _on_auto_toggled(self, checked: bool):
        set_auto_enabled(checked)
        self._show_toast("Auto-record ON" if checked else "Auto-record OFF")

    def _on_all_terms_toggled(self, checked: bool):
        for sw in self.term_switches.values():
            sw.setEnabled(not checked)
            if checked:
                sw.setChecked(True)
        if checked:
            self._save_setting("REC_TERMINALS", "all")
        else:
            self._save_selected_terminals()

    def _save_selected_terminals(self):
        chosen = [tid for tid, sw in self.term_switches.items() if sw.isChecked()]
        self._save_setting("REC_TERMINALS", ",".join(chosen) if chosen else "none")

    def _save_setting(self, key: str, val: str):
        self.cfg[key] = val
        write_config_key(key, val)
        self._show_toast("Saved")

    def _browse_video_dir(self):
        chosen = QFileDialog.getExistingDirectory(self, "Choose Clips Output Folder", self.dir_edit.text())
        if chosen:
            self.dir_edit.setText(chosen)
            self._save_setting("REC_VIDEO_DIR", chosen)
            self._refresh_clips(force=True)

    def _open_video_dir(self):
        vdir = Path(self.cfg.get("REC_VIDEO_DIR", str(Path.home() / "Videos/content")))
        vdir.mkdir(parents=True, exist_ok=True)
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", str(vdir)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    # ---------------- Session & Terminal Actions ----------------
    def _launch_recorded_terminal(self, preferred_term: str = "", cwd: str = ""):
        name, ok = QInputDialog.getText(self, "New Recorded Terminal", "Clip name (leave blank to auto-name):")
        if not ok:
            return
        name = name.strip()
        shell = os.environ.get("SHELL", "/bin/bash")
        rec_cmd = ["rec-pty"] + (["--name", name] if name else []) + ["--", shell]
        work_dir = cwd if (cwd and os.path.isdir(cwd)) else None

        preferred = ([preferred_term] if preferred_term else []) + [
            x.strip().lower() for x in self.cfg.get("REC_TERMINALS", "kitty,tabby").split(",")
        ]
        candidates = preferred + ["kitty", "alacritty", "wezterm", "ghostty", "konsole", "gnome-terminal", "xterm"]

        launched = False
        for term in candidates:
            if term == "kitty" and shutil.which("kitty"):
                cmd = ["kitty"] + (["--directory", work_dir] if work_dir else []) + ["-e", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "alacritty" and shutil.which("alacritty"):
                cmd = ["alacritty"] + (["--working-directory", work_dir] if work_dir else []) + ["-e", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "wezterm" and shutil.which("wezterm"):
                cmd = ["wezterm", "start"] + (["--cwd", work_dir] if work_dir else []) + ["--", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "ghostty" and shutil.which("ghostty"):
                cmd = ["ghostty"] + ([f"--working-directory={work_dir}"] if work_dir else []) + ["-e", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "konsole" and shutil.which("konsole"):
                cmd = ["konsole"] + (["--workdir", work_dir] if work_dir else []) + ["-e", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "gnome-terminal" and shutil.which("gnome-terminal"):
                cmd = ["gnome-terminal"] + ([f"--working-directory={work_dir}"] if work_dir else []) + ["--", *rec_cmd]
                subprocess.Popen(cmd, start_new_session=True)
                launched = True
                break
            if term == "tabby" and shutil.which("tabby"):
                subprocess.Popen(["tabby"], cwd=work_dir, start_new_session=True)
                launched = True
                break

        if launched:
            self._show_toast("Launched terminal")
            QTimer.singleShot(800, lambda: self._refresh_sessions(force=True))
        else:
            QMessageBox.information(self, "rec-cli", "Open a terminal and run: rec start")

    def _attach_open_terminal(self, info: dict):
        """Start recording in-place via kitty remote / tmux if available, else copy `exec zsh` / `rec start`."""
        sock = info.get("kitty_sock", "")
        win_id = info.get("kitty_win", "")
        if sock and win_id and shutil.which("kitty"):
            try:
                subprocess.run(
                    ["kitty", "@", "--to", sock, "send-text", "--match", f"id:{win_id}", "rec start\r"],
                    check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2,
                )
                self._show_toast(f"Recording in Kitty #{win_id}")
                QTimer.singleShot(600, lambda: self._refresh_sessions(force=True))
                return
            except Exception:
                pass
        tmux_pane = info.get("tmux_pane", "")
        if tmux_pane and shutil.which("tmux"):
            try:
                subprocess.run(
                    ["tmux", "send-keys", "-t", tmux_pane, "rec start", "Enter"],
                    check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2,
                )
                self._show_toast(f"Recording in tmux {tmux_pane}")
                QTimer.singleShot(600, lambda: self._refresh_sessions(force=True))
                return
            except Exception:
                pass
        cb = QApplication.clipboard()
        if cb is not None:
            cb.setText("rec start")
        self._show_toast("Copied: rec start")

    def _stop_all(self):
        managed, _, _ = discover_all_terminals()
        count = 0
        for s in managed:
            if s.get("legacy"):
                continue
            if s.get("state") in ("recording", "paused"):
                if send_session_cmd(s["pid"], "stop"):
                    count += 1
        self._show_toast(f"Stopped {count} session(s)")
        QTimer.singleShot(300, lambda: self._refresh_sessions(force=True))

    def _session_action(self, pid: int, verb: str):
        if verb == "mark":
            label, ok = QInputDialog.getText(self, f"Chapter Marker (PID {pid})", "Chapter label:")
            if not ok or not label.strip():
                return
            send_session_cmd(pid, f"mark {label.strip()}")
            self._show_toast("Marker added")
        elif verb == "start":
            # Instant 1-click in-place recording on this live terminal (no modal popup)
            send_session_cmd(pid, "start")
            self._show_toast(f"Recording PID {pid}")
        elif verb == "kill":
            ans = QMessageBox.question(self, "Terminate Session", f"Terminate process PID {pid}?")
            if ans != QMessageBox.StandardButton.Yes:
                return
            try:
                os.kill(pid, signal.SIGTERM)
                self._show_toast(f"Terminated {pid}")
            except OSError:
                pass
        else:
            send_session_cmd(pid, verb)
            labels = {"stop": "Stopped & rendering", "pause": "Paused", "resume": "Resumed", "cancel": "Discarded"}
            self._show_toast(labels.get(verb, verb))
        QTimer.singleShot(250, lambda: self._refresh_sessions(force=True))

    def _run_bg(self, cmd: list[str], label: str):
        self._show_toast(f"{label}...")
        w = WorkerThread(cmd, label)
        w.done.connect(lambda _ok, msg: (self._show_toast(msg), self._refresh_clips(force=True)))
        self.workers.append(w)
        w.finished.connect(lambda: self.workers.remove(w) if w in self.workers else None)
        w.start()

    def _render_pending(self):
        self._run_bg(["casts2mp4"], "Render pending")

    def _play_clip(self, path: Path):
        for player in ("mpv", "parole", "vlc", "xdg-open"):
            if shutil.which(player):
                subprocess.Popen([player, str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                return

    def _delete_clip(self, path: Path):
        ans = QMessageBox.question(self, "Delete Clip", f"Delete {path.name}?")
        if ans == QMessageBox.StandardButton.Yes:
            path.unlink(missing_ok=True)
            self._show_toast("Deleted")
            self._refresh_clips(force=True)

    # ---------------- Periodic Refresh ----------------
    def _on_tick(self):
        self._refresh_sessions(force=False)
        if self.stack.currentIndex() == 2:
            self._refresh_clips(force=False)

    def _clear_layout(self, layout: QVBoxLayout):
        while layout.count():
            item = layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.hide()
                w.setParent(None)
                w.deleteLater()

    def _update_terminal_badges(self, running_counts: dict[str, int]):
        for tid, _label, bins in TERMINALS:
            lbl = self.term_status_lbls.get(tid)
            if not lbl:
                continue
            installed = any(shutil.which(b) for b in bins)
            if tid in running_counts:
                cnt = running_counts[tid]
                lbl.setText(f"● Running ({cnt} tab{'s' if cnt != 1 else ''})" if cnt > 0 else "● Running")
                lbl.setObjectName("okBadge")
            elif installed:
                lbl.setText("Installed")
                lbl.setObjectName("muted")
            else:
                lbl.setText("Not installed")
                lbl.setObjectName("dim")
            lbl.style().unpolish(lbl)
            lbl.style().polish(lbl)

    def _refresh_sessions(self, force: bool = False):
        managed, open_terms, running_counts = discover_all_terminals()
        self.running_counts = running_counts
        self._update_terminal_badges(running_counts)

        rec_n = sum(1 for s in managed if s.get("state") == "recording")
        paused_n = sum(1 for s in managed if s.get("state") == "paused")
        total_open = len(managed) + len(open_terms)

        # Update sidebar status pill & nav label
        self.nav_btns[0].setText(f"  Sessions ({total_open})" if total_open else "  Sessions")

        if rec_n > 0:
            self.live_pill.setText(f"● {rec_n} Recording")
            self.live_pill.setObjectName("recBadge")
            self.stop_all_btn.setVisible(any(not s.get("legacy") and s.get("state") in ("recording", "paused") for s in managed))
        elif paused_n > 0:
            self.live_pill.setText(f"❚❚ {paused_n} Paused")
            self.live_pill.setObjectName("pausedBadge")
            self.stop_all_btn.show()
        elif total_open > 0:
            self.live_pill.setText(f"{total_open} Terminal{'s' if total_open != 1 else ''} Open")
            self.live_pill.setObjectName("neutralBadge")
            self.stop_all_btn.hide()
        else:
            self.live_pill.setText("Idle")
            self.live_pill.setObjectName("neutralBadge")
            self.stop_all_btn.hide()
        self.live_pill.style().unpolish(self.live_pill)
        self.live_pill.style().polish(self.live_pill)

        sig = (
            [
                (s.get("pid"), s.get("state"), s.get("name"), s.get("fg_cmd"), s.get("cast_size"),
                 int(time.time() - s.get("started_at", 0)) if s.get("state") == "recording" else 0)
                for s in managed
            ],
            [(o["pid"], o["terminal"], o["cwd"], o["fg_cmd"]) for o in open_terms],
        )
        if not force and sig == self.last_sessions_sig:
            return
        self.last_sessions_sig = sig

        self._clear_layout(self.sessions_lay)

        if not managed and not open_terms:
            empty = QFrame()
            empty.setObjectName("panel")
            el = QVBoxLayout(empty)
            el.setContentsMargins(24, 42, 24, 42)
            el.setSpacing(6)
            l1 = QLabel("No terminals detected")
            l1.setObjectName("rowTitle")
            l1.setAlignment(Qt.AlignmentFlag.AlignCenter)
            l2 = QLabel("Open Kitty, Tabby, or any terminal — or click + New Recorded Terminal above.")
            l2.setObjectName("muted")
            l2.setAlignment(Qt.AlignmentFlag.AlignCenter)
            el.addWidget(l1)
            el.addWidget(l2)
            self.sessions_lay.addWidget(empty)
            self.sessions_lay.addStretch()
            return

        if managed:
            sec = QLabel("LIVE TERMINALS (1-CLICK RECORD)")
            sec.setObjectName("sectionLabel")
            self.sessions_lay.addWidget(sec)

            for s in managed:
                self.sessions_lay.addWidget(self._make_managed_card(s))

        if open_terms:
            if managed:
                self.sessions_lay.addSpacing(8)
            sec2 = QLabel("PRE-HOOK TABS (REOPEN OR RUN EXEC ZSH ONCE FOR 1-CLICK)")
            sec2.setObjectName("sectionLabel")
            self.sessions_lay.addWidget(sec2)

            for o in open_terms:
                self.sessions_lay.addWidget(self._make_open_term_card(o))

        self.sessions_lay.addStretch()

    def _make_managed_card(self, s: dict) -> QFrame:
        pid = s["pid"]
        state = s.get("state", "standby")
        legacy = bool(s.get("legacy"))
        name = s.get("name") or (s.get("last_cmd", "").split()[0] if s.get("last_cmd") else "session")
        term = s.get("terminal", "tty")
        cwd = short_cwd(s.get("cwd", ""))
        cmd_txt = s.get("fg_cmd") or s.get("last_cmd") or cwd
        elapsed = fmt_elapsed(s.get("started_at", 0)) if state != "standby" else "ready"
        sz = fmt_size(s.get("cast_size", 0)) if state != "standby" else ""

        card = QFrame()
        card.setObjectName("panelRec" if state == "recording" else "panel")
        cl = QHBoxLayout(card)
        cl.setContentsMargins(14, 12, 14, 12)
        cl.setSpacing(12)

        left = QVBoxLayout()
        left.setSpacing(5)

        row1 = QHBoxLayout()
        row1.setSpacing(7)
        if state == "recording":
            pill = QLabel("● REC" if not legacy else "● REC (OLD)")
            pill.setObjectName("recBadge")
        elif state == "paused":
            pill = QLabel("❚❚ PAUSED")
            pill.setObjectName("pausedBadge")
        else:
            pill = QLabel("○ READY")
            pill.setObjectName("neutralBadge")
        row1.addWidget(pill)

        name_lbl = QLabel(name)
        name_lbl.setObjectName("rowTitle")
        row1.addWidget(name_lbl)

        for txt in (f"PID {pid}", term):
            tag = QLabel(txt)
            tag.setObjectName("monoTag")
            row1.addWidget(tag)

        meta = QLabel(f"{elapsed} · {sz}" if sz else elapsed)
        meta.setObjectName("muted")
        row1.addWidget(meta)
        row1.addStretch()
        left.addLayout(row1)

        sub = ElidedLabel(f"{cmd_txt}  ·  {cwd}" if cmd_txt != cwd else cwd)
        sub.setObjectName("muted")
        left.addWidget(sub)
        cl.addLayout(left, 1)

        btns = QHBoxLayout()
        btns.setSpacing(6)
        if legacy:
            b_kill = QPushButton("Kill")
            b_kill.setObjectName("dangerBtn")
            b_kill.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "kill"))
            btns.addWidget(b_kill)
        elif state == "recording":
            b_pause = QPushButton("Pause")
            b_pause.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "pause"))
            b_mark = QPushButton("Mark")
            b_mark.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "mark"))
            b_stop = QPushButton("Stop")
            b_stop.setObjectName("primaryBtn")
            b_stop.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "stop"))
            b_cancel = QPushButton("Discard")
            b_cancel.setObjectName("dangerBtn")
            b_cancel.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "cancel"))
            for b in (b_pause, b_mark, b_stop, b_cancel):
                btns.addWidget(b)
        elif state == "paused":
            b_res = QPushButton("Resume")
            b_res.setObjectName("recBtn")
            b_res.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "resume"))
            b_stop = QPushButton("Stop")
            b_stop.setObjectName("primaryBtn")
            b_stop.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "stop"))
            b_cancel = QPushButton("Discard")
            b_cancel.setObjectName("dangerBtn")
            b_cancel.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "cancel"))
            for b in (b_res, b_stop, b_cancel):
                btns.addWidget(b)
        else:
            b_start = QPushButton("Record")
            b_start.setObjectName("recBtn")
            b_start.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "start"))
            b_kill = QPushButton("Kill")
            b_kill.setObjectName("dangerBtn")
            b_kill.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "kill"))
            for b in (b_start, b_kill):
                btns.addWidget(b)

        # Tighten card buttons so all controls always fit cleanly without clipping
        for i in range(btns.count()):
            w = btns.itemAt(i).widget()
            if isinstance(w, QPushButton):
                w.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        cl.addLayout(btns)
        return card

    def _make_open_term_card(self, o: dict) -> QFrame:
        pid = o["pid"]
        term = o["terminal"]
        cwd = short_cwd(o.get("cwd", ""))
        cmd = o.get("fg_cmd") or o.get("shell", "shell")

        card = QFrame()
        card.setObjectName("panel")
        cl = QHBoxLayout(card)
        cl.setContentsMargins(14, 11, 14, 11)
        cl.setSpacing(12)

        left = QVBoxLayout()
        left.setSpacing(4)

        row1 = QHBoxLayout()
        row1.setSpacing(7)
        badge = QLabel("● OPEN")
        badge.setObjectName("okBadge")
        row1.addWidget(badge)

        tname = QLabel(term)
        tname.setObjectName("rowTitle")
        row1.addWidget(tname)

        pid_tag = QLabel(f"PID {pid}")
        pid_tag.setObjectName("monoTag")
        row1.addWidget(pid_tag)

        sh_tag = QLabel(o.get("shell", "sh"))
        sh_tag.setObjectName("monoTag")
        row1.addWidget(sh_tag)
        row1.addStretch()
        left.addLayout(row1)

        sub = ElidedLabel(f"{cmd}  ·  {cwd}" if cmd != cwd else cwd)
        sub.setObjectName("muted")
        left.addWidget(sub)
        cl.addLayout(left, 1)

        btns = QHBoxLayout()
        btns.setSpacing(6)

        can_remote = bool((o.get("kitty_sock") and o.get("kitty_win")) or o.get("tmux_pane"))
        if can_remote:
            b_attach = QPushButton("Record")
            b_attach.setObjectName("recBtn")
            b_attach.setToolTip("Start recording directly inside this existing tab")
            b_attach.clicked.connect(lambda _c=False, info=o: self._attach_open_terminal(info))
            btns.addWidget(b_attach)
        else:
            b_copy = QPushButton("Copy rec start")
            b_copy.setToolTip("Linux cannot inject into a shell opened before rec-cli standby. Run 'rec start' or 'exec zsh' once, and all future tabs get 1-click Record.")
            b_copy.clicked.connect(lambda _c=False, info=o: self._attach_open_terminal(info))
            btns.addWidget(b_copy)

        # Tighten card buttons so all controls always fit cleanly without clipping
        for i in range(btns.count()):
            w = btns.itemAt(i).widget()
            if isinstance(w, QPushButton):
                w.setSizePolicy(QSizePolicy.Policy.Fixed, QSizePolicy.Policy.Fixed)
        cl.addLayout(btns)
        return card

    def _refresh_clips(self, force: bool = False):
        vdir = Path(self.cfg.get("REC_VIDEO_DIR", str(Path.home() / "Videos/content")))
        vdir.mkdir(parents=True, exist_ok=True)
        query = self.clip_search.text().strip().lower() if hasattr(self, "clip_search") else ""

        mp4s = sorted(vdir.glob("*.mp4"), key=lambda p: p.stat().st_mtime, reverse=True)
        if query:
            mp4s = [p for p in mp4s if query in p.name.lower()]

        sig = [(p.name, p.stat().st_size, int(p.stat().st_mtime)) for p in mp4s]
        if not force and sig == self.last_clips_sig:
            return
        self.last_clips_sig = sig

        total_bytes = sum(s for _, s, _ in sig)
        self.clips_title.setText(f"Clips  ({len(mp4s)} · {fmt_size(total_bytes)})" if mp4s else "Clips")
        self.nav_btns[2].setText(f"  Clips ({len(mp4s)})" if mp4s else "  Clips")

        self._clear_layout(self.clips_lay)

        if not mp4s:
            empty = QFrame()
            empty.setObjectName("panel")
            el = QVBoxLayout(empty)
            el.setContentsMargins(24, 38, 24, 38)
            lbl = QLabel("No matching clips" if query else f"No clips in {short_cwd(str(vdir))} yet")
            lbl.setObjectName("muted")
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            el.addWidget(lbl)
            self.clips_lay.addWidget(empty)
            self.clips_lay.addStretch()
            return

        for p in mp4s[:40]:
            st = p.stat()
            mtime = time.strftime("%b %d · %H:%M", time.localtime(st.st_mtime))
            card = QFrame()
            card.setObjectName("panel")
            rl = QHBoxLayout(card)
            rl.setContentsMargins(14, 10, 14, 10)
            rl.setSpacing(10)

            info = QVBoxLayout()
            info.setSpacing(2)
            name_lbl = ElidedLabel(p.name)
            name_lbl.setObjectName("rowTitle")
            meta_lbl = QLabel(f"{fmt_size(st.st_size)} · {mtime}")
            meta_lbl.setObjectName("muted")
            info.addWidget(name_lbl)
            info.addWidget(meta_lbl)
            rl.addLayout(info, 1)

            b_play = QPushButton("Play")
            b_play.setObjectName("primaryBtn")
            b_play.clicked.connect(lambda _c=False, path=p: self._play_clip(path))
            b_gif = QPushButton("GIF")
            b_gif.clicked.connect(lambda _c=False, path=p: self._run_bg(["rec-cli", "gif", str(path)], "GIF"))
            b_thumb = QPushButton("Thumb")
            b_thumb.clicked.connect(lambda _c=False, path=p: self._run_bg(["rec-cli", "thumb", str(path)], "Thumb"))
            b_del = QPushButton("Delete")
            b_del.setObjectName("dangerBtn")
            b_del.clicked.connect(lambda _c=False, path=p: self._delete_clip(path))

            for b in (b_play, b_gif, b_thumb, b_del):
                rl.addWidget(b)
            self.clips_lay.addWidget(card)

        self.clips_lay.addStretch()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("rec-cli")
    win = RecGuiWindow()
    if "--smoke-test" in sys.argv:
        win.show()
        win._toggle_theme()
        win._toggle_theme()
        app.processEvents()
        win.close()
        print(f"SMOKE_OK ({QT_BINDING})")
        return 0
    win.show()
    return app.exec() if hasattr(app, "exec") else app.exec_()


if __name__ == "__main__":
    sys.exit(main())
