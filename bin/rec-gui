        self.dark_btn.setObjectName("segBtn")
        self.dark_btn.setIconSize(QSize(13, 13))
        self.dark_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.dark_btn.clicked.connect(lambda: self._set_theme("dark"))

        self.light_btn = QPushButton(" Light")
        self.light_btn.setObjectName("segBtn")
        self.light_btn.setIconSize(QSize(13, 13))
        self.light_btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        self.light_btn.clicked.connect(lambda: self._set_theme("light"))

        seg_lay.addWidget(self.dark_btn, 1)
        seg_lay.addWidget(self.light_btn, 1)
