class RecGuiWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.cfg = read_config()
        self.ui_mode = self.cfg.get("REC_UI_THEME", "dark")
        if self.ui_mode not in ("dark", "light"):
            self.ui_mode = "dark"

        self.workers: list[WorkerThread] = []
        self.switches: list[tuple[ToggleSwitch, bool]] = []
        self.combos: list[CleanComboBox] = []
        self.term_switches: dict[str, ToggleSwitch] = {}
        self.term_status_lbls: dict[str, QLabel] = {}
        self.last_sessions_sig = None
        self.last_clips_sig = None
        self.running_counts: dict[str, int] = {}

        self.setWindowTitle("rec-cli")
        self.setMinimumSize(920, 560)
        self.resize(1040, 640)
        self.setWindowIcon(QIcon(make_logo_pixmap(48, dark=True)))

        self._build_ui()
        self._apply_theme()
        self._refresh_sessions(force=True)
        self._refresh_clips(force=True)

        self.timer = QTimer(self)
        self.timer.timeout.connect(self._on_tick)
        self.timer.start(1000)

    def _register_switch(self, sw: ToggleSwitch, accent_red: bool = False) -> ToggleSwitch:
        self.switches.append((sw, accent_red))
        return sw

    def _register_combo(self, cb: CleanComboBox) -> CleanComboBox:
        self.combos.append(cb)
        return cb

    def _build_ui(self):
        root = QWidget()
        root.setObjectName("root")
        self.setCentralWidget(root)

        outer = QHBoxLayout(root)
        outer.setContentsMargins(0, 0, 0, 0)
        outer.setSpacing(0)

        # ---- Left Sidebar (216px) ----
        sidebar = QFrame()
        sidebar.setObjectName("sidebar")
        sidebar.setFixedWidth(216)
        sb = QVBoxLayout(sidebar)
        sb.setContentsMargins(14, 16, 14, 14)
        sb.setSpacing(6)

        # Brand header
        brand = QHBoxLayout()
        brand.setSpacing(10)
        self.logo_lbl = QLabel()
        brand.addWidget(self.logo_lbl)

        bcol = QVBoxLayout()
        bcol.setSpacing(0)
        b_title = QLabel("rec-cli")
        b_title.setObjectName("appTitle")
        b_ver = QLabel(f"v{VERSION}")
        b_ver.setObjectName("dim")
        bcol.addWidget(b_title)
        bcol.addWidget(b_ver)
        brand.addLayout(bcol)
        brand.addStretch()
        sb.addLayout(brand)

        sb.addSpacing(10)

        # Live status pill in sidebar
        self.live_pill = QLabel("Idle")
        self.live_pill.setObjectName("neutralBadge")
        self.live_pill.setAlignment(Qt.AlignmentFlag.AlignCenter)
        sb.addWidget(self.live_pill)

        sb.addSpacing(10)

        # Navigation items
        self.nav_defs = [
            ("sessions", "Sessions"),
            ("terminals", "Terminals"),
            ("clips", "Clips"),
            ("settings", "Settings"),
        ]
        self.nav_btns: list[QPushButton] = []
        for idx, (icon_kind, label) in enumerate(self.nav_defs):
            btn = QPushButton(f"  {label}")
            btn.setObjectName("navItem")
            btn.setProperty("active", idx == 0)
            btn.setIconSize(QSize(16, 16))
            btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
            btn.clicked.connect(lambda _c=False, i=idx: self._switch_page(i))
            sb.addWidget(btn)
            self.nav_btns.append(btn)

        sb.addStretch()

        # Toast pill (subtle feedback)
        self.toast_pill = QLabel("")
        self.toast_pill.setObjectName("toastPill")
        self.toast_pill.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.toast_pill.hide()
