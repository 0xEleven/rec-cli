        QApplication, QCheckBox, QComboBox, QFileDialog, QFrame, QGridLayout,
        QHBoxLayout, QInputDialog, QLabel, QLineEdit, QMainWindow, QMessageBox,
        QPushButton, QScrollArea, QSizePolicy, QStackedWidget, QVBoxLayout, QWidget,
    )
    QT_BINDING = "PyQt6"
except ImportError:
    try:
        from PySide6.QtCore import Qt, QTimer, QThread, Signal, QSize, QRectF
        from PySide6.QtGui import QColor, QFont, QIcon, QPainter, QPainterPath, QPen, QPixmap
        from PySide6.QtWidgets import (
            QApplication, QCheckBox, QComboBox, QFileDialog, QFrame, QGridLayout,
            QHBoxLayout, QInputDialog, QLabel, QLineEdit, QMainWindow, QMessageBox,
            QPushButton, QScrollArea, QSizePolicy, QStackedWidget, QVBoxLayout, QWidget,
        )
        QT_BINDING = "PySide6"
    except ImportError:
        try:
            from PyQt5.QtCore import Qt, QTimer, QThread, pyqtSignal as Signal, QSize, QRectF
            from PyQt5.QtGui import QColor, QFont, QIcon, QPainter, QPainterPath, QPen, QPixmap
            from PyQt5.QtWidgets import (
                QApplication, QCheckBox, QComboBox, QFileDialog, QFrame, QGridLayout,
                QHBoxLayout, QInputDialog, QLabel, QLineEdit, QMainWindow, QMessageBox,
                QPushButton, QScrollArea, QSizePolicy, QStackedWidget, QVBoxLayout, QWidget,
            )
            QT_BINDING = "PyQt5"
        except ImportError:
            print(
                "Error: No Qt Python binding found.\n"
                "Install one with:\n"
                "  Debian/Ubuntu/Kali: sudo apt install python3-pyqt6\n"
                "  Arch/Manjaro:       sudo pacman -S python-pyqt6\n"
                "  Fedora/RHEL:        sudo dnf install python3-pyqt6",
                file=sys.stderr,
            )
            sys.exit(1)

