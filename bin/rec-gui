# ---------------------------------------------------------------------------
# Custom-painted native controls (crisp vectors, no broken QSS hacks)
# ---------------------------------------------------------------------------

class ToggleSwitch(QWidget):
    """Crisp pill toggle switch with custom-painted track and thumb."""
    toggled = Signal(bool)

    def __init__(self, checked: bool = False, parent: QWidget | None = None):
        super().__init__(parent)
        self._checked = checked
        self._mode = "dark"
        self._accent_red = False
        self.setFixedSize(36, 20)
        self.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))

    def set_theme(self, mode: str, accent_red: bool = False) -> None:
        self._mode = mode
        self._accent_red = accent_red
        self.update()

    def isChecked(self) -> bool:
        return self._checked

    def setChecked(self, val: bool) -> None:
        val = bool(val)
        if self._checked != val:
            self._checked = val
            self.update()

    def mouseReleaseEvent(self, event):
        if self.isEnabled() and event.button() == Qt.MouseButton.LeftButton:
            self._checked = not self._checked
            self.update()
            self.toggled.emit(self._checked)
        super().mouseReleaseEvent(event)

    def paintEvent(self, _event):
        t = THEMES["light" if self._mode == "light" else "dark"]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        w, h = self.width(), self.height()
        r = h / 2.0
        enabled = self.isEnabled()

        if self._checked:
            track_col = QColor(t["rec"] if self._accent_red else t["track_on"])
            thumb_col = QColor("#ffffff" if self._accent_red else t["thumb_on"])
        else:
            track_col = QColor(t["track_off"])
            thumb_col = QColor(t["thumb_off"])

        if not enabled:
            track_col.setAlpha(110)
            thumb_col.setAlpha(160)

        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(track_col)
        p.drawRoundedRect(QRectF(0, 0, w, h), r, r)

        pad = 3.0
        d = h - pad * 2
        x = (w - pad - d) if self._checked else pad
        p.setBrush(thumb_col)
        p.drawEllipse(QRectF(x, pad, d, d))
        p.end()


class ElidedLabel(QLabel):
    """Single-line QLabel that cleanly elides overflowing text instead of widening layouts."""

    def __init__(self, text: str = "", parent: QWidget | None = None):
        super().__init__(text, parent)
        self._full_text = text
        self.setMinimumWidth(0)
        self.setSizePolicy(QSizePolicy.Policy.Ignored, QSizePolicy.Policy.Preferred)

    def setText(self, text: str) -> None:
        self._full_text = text
        self.setToolTip(text)
        self._apply_elide()

    def resizeEvent(self, event):
        super().resizeEvent(event)
        self._apply_elide()

    def _apply_elide(self):
        fm = self.fontMetrics()
        w = max(40, self.width() - 2)
        super().setText(fm.elidedText(self._full_text, Qt.TextElideMode.ElideRight, w))


class CleanComboBox(QComboBox):
    """QComboBox with a crisp custom-painted dropdown chevron."""

    def __init__(self, parent: QWidget | None = None):
        super().__init__(parent)
        self._mode = "dark"

    def set_theme(self, mode: str) -> None:
        self._mode = mode
        self.update()

    def paintEvent(self, event):
        super().paintEvent(event)
        t = THEMES["light" if self._mode == "light" else "dark"]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        cx = self.width() - 16
        cy = self.height() / 2.0
        path = QPainterPath()
        path.moveTo(cx - 4, cy - 2)
        path.lineTo(cx, cy + 2.5)
        path.lineTo(cx + 4, cy - 2)
        pen = QPen(QColor(t["text_muted"]), 1.6)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        p.setPen(pen)
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawPath(path)
        p.end()


def make_logo_pixmap(size: int = 26, dark: bool = True) -> QPixmap:
    """Minimal `> ●` vector mark."""
    w = int(size * 1.48)
    h = size
    pm = QPixmap(w, h)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    bg = QColor("#18181d") if dark else QColor("#141418")
    border = QColor("#2c2c34") if dark else QColor("#24242c")
    p.setBrush(bg)
    p.setPen(QPen(border, 1.2))
    p.drawRoundedRect(QRectF(1, 1, w - 2, h - 2), h * 0.25, h * 0.25)

    path = QPainterPath()
    path.moveTo(w * 0.24, h * 0.30)
    path.lineTo(w * 0.43, h * 0.50)
    path.lineTo(w * 0.24, h * 0.70)
    pen = QPen(QColor("#f2f2f5"), max(2.0, h * 0.095))
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.BrushStyle.NoBrush)
    p.drawPath(path)

    r = h * 0.145
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor("#e5484d"))
    p.drawEllipse(QRectF(w * 0.69 - r, h * 0.50 - r, r * 2, r * 2))
    p.end()
    return pm


def make_nav_icon(kind: str, color_hex: str, size: int = 16) -> QIcon:
    """Minimal 1.5px stroke icons for sidebar navigation."""
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    pen = QPen(QColor(color_hex), 1.5)
    pen.setCapStyle(Qt.PenCapStyle.RoundCap)
    pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
    p.setPen(pen)
    p.setBrush(Qt.BrushStyle.NoBrush)

    if kind == "sessions":
        # Circle with inner dot (record / live)
        p.drawEllipse(QRectF(2.5, 2.5, 11, 11))
        p.setBrush(QColor(color_hex))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QRectF(6, 6, 4, 4))
    elif kind == "terminals":
        # Terminal box with >_
        p.drawRoundedRect(QRectF(2, 2.5, 12, 11), 2.5, 2.5)
        path = QPainterPath()
        path.moveTo(4.8, 6.2)
        path.lineTo(7.2, 8.2)
        path.lineTo(4.8, 10.2)
        p.drawPath(path)
        p.drawLine(QPointF(8.6, 10.2), QPointF(11.2, 10.2))
    elif kind == "clips":
        # Play triangle inside frame
        p.drawRoundedRect(QRectF(2, 3, 12, 10), 2.5, 2.5)
        tri = QPainterPath()
        tri.moveTo(6.6, 5.8)
        tri.lineTo(10.4, 8.0)
        tri.lineTo(6.6, 10.2)
        tri.closeSubpath()
        p.setBrush(QColor(color_hex))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawPath(tri)
    elif kind == "settings":
        # Minimal 2 horizontal sliders
        p.drawLine(QPointF(2.5, 5.5), QPointF(13.5, 5.5))
        p.drawLine(QPointF(2.5, 10.5), QPointF(13.5, 10.5))
        p.setBrush(QColor(color_hex))
        p.drawEllipse(QRectF(4.8, 3.8, 3.4, 3.4))
        p.drawEllipse(QRectF(8.2, 8.8, 3.4, 3.4))
    elif kind == "sun":
        p.drawEllipse(QRectF(5.5, 5.5, 5, 5))
        for dx, dy in ((0, -5), (0, 5), (-5, 0), (5, 0), (-3.5, -3.5), (3.5, 3.5), (-3.5, 3.5), (3.5, -3.5)):
            p.drawLine(QPointF(8 + dx * 0.72, 8 + dy * 0.72), QPointF(8 + dx, 8 + dy))
    elif kind == "moon":
        path = QPainterPath()
        path.addEllipse(QRectF(3, 2.5, 10, 10.5))
        cut = QPainterPath()
        cut.addEllipse(QRectF(6.8, 1.8, 8.5, 8.5))
        crescent = path.subtracted(cut)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(QColor(color_hex))
        p.drawPath(crescent)

    p.end()
    return QIcon(pm)


