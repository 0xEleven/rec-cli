# ---------------------------------------------------------------------------
# Config & live process / running terminal discovery
# ---------------------------------------------------------------------------

def read_config() -> dict[str, str]:
    cfg = {
        "REC_RESOLUTION": "auto",
        "REC_SPEED": "2",
        "REC_MAX_SECS": "300",
        "REC_FRAME": "on",
        "REC_REDACT": "on",
        "REC_REELS_COPY": "off",
        "REC_THEME": "tokyo-night",
        "REC_TERMINALS": "kitty,tabby",
        "REC_VIDEO_DIR": str(Path.home() / "Videos/content"),
        "REC_UI_THEME": "dark",
    }
    if CONF_FILE.is_file():
        for line in CONF_FILE.read_text(encoding="utf-8", errors="replace").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            k = k.strip()
            try:
                v = shlex.split(v)[0] if v.strip() else ""
            except ValueError:
                v = v.strip().strip("'\"")
            cfg[k] = v
    return cfg


def write_config_key(key: str, val: str) -> None:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    lines = []
    if CONF_FILE.is_file():
        lines = [
            ln for ln in CONF_FILE.read_text(encoding="utf-8", errors="replace").splitlines()
            if not ln.startswith(f"{key}=")
        ]
    lines.append(f"{key}={shlex.quote(val)}")
    tmp = CONF_FILE.with_suffix(".tmp")
    tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
    os.replace(tmp, CONF_FILE)


def is_auto_enabled() -> bool:
    return not (AUTO_OFF_FLAG.exists() or LEGACY_AUTO_OFF.exists())


def set_auto_enabled(enabled: bool) -> None:
    CONF_DIR.mkdir(parents=True, exist_ok=True)
    if enabled:
        AUTO_OFF_FLAG.unlink(missing_ok=True)
        LEGACY_AUTO_OFF.unlink(missing_ok=True)
    else:
        AUTO_OFF_FLAG.touch()


def is_pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _scan_proc_table() -> dict[int, dict]:
    """Snapshot current user's live (non-zombie) processes from /proc."""
    uid = os.getuid()
    procs: dict[int, dict] = {}
    try:
        for entry in os.scandir("/proc"):
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            try:
                if os.stat(entry.path).st_uid != uid:
                    continue
                with open(f"{entry.path}/stat", "r", encoding="utf-8", errors="replace") as f:
                    st = f.read()
                lp = st.find("(")
                rp = st.rfind(")")
                if lp == -1 or rp == -1:
                    continue
                comm = st[lp + 1:rp]
                fields = st[rp + 2:].split()
                state_ch = fields[0]
                if state_ch in ("Z", "X"):
                    continue
                ppid = int(fields[1])
                tty_nr = int(fields[4])
                with open(f"{entry.path}/cmdline", "rb") as f:
                    parts = [x.decode("utf-8", "replace") for x in f.read().split(b"\x00") if x]
                procs[pid] = {
                    "pid": pid,
                    "ppid": ppid,
                    "tty_nr": tty_nr,
                    "comm": comm,
                    "parts": parts,
                }
            except OSError:
                continue
    except OSError:
        pass
    return procs


def _read_proc_cwd(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def _read_proc_env_var(pid: int, key: str) -> str:
    try:
        prefix = (key + "=").encode("utf-8")
        with open(f"/proc/{pid}/environ", "rb") as f:
            for item in f.read().split(b"\x00"):
                if item.startswith(prefix):
                    return item[len(prefix):].decode("utf-8", "replace")
    except OSError:
        pass
    return ""


def _get_pts_path(pid: int) -> str:
    try:
        target = os.readlink(f"/proc/{pid}/fd/0")
        if target.startswith("/dev/pts/") and not target.endswith("(deleted)"):
            return target
    except OSError:
        pass
    return ""


def _deepest_fg_cmd(root_pid: int, children_map: dict[int, list[int]], procs: dict[int, dict]) -> str:
    cur = root_pid
    visited = {cur}
    while True:
        kids = [k for k in children_map.get(cur, []) if k not in visited]
        if not kids:
            break
        cur = max(kids)
        visited.add(cur)
    if cur != root_pid and cur in procs:
        if procs[cur]["comm"] in SHELL_COMMS:
            return ""
        parts = procs[cur]["parts"]
        if parts and os.path.basename(parts[0]) in SHELL_COMMS and len(parts) == 1:
            return ""
        return " ".join(parts)[:80] if parts else procs[cur]["comm"]
    return ""


def _mark_shell_ancestors(pid: int, covered: set[int], procs: dict[int, dict]) -> None:
    """Also cover parent shell(s) that spawned a recorder without `exec` so tabs never duplicate."""
    cur = pid
    for _ in range(3):
        info = procs.get(cur)
        if not info:
            break
        ppid = info["ppid"]
        pinfo = procs.get(ppid)
        if not pinfo or pinfo["comm"] not in SHELL_COMMS:
            break
        covered.add(ppid)
        cur = ppid


def discover_all_terminals() -> tuple[list[dict], list[dict], dict[str, int]]:
    """Return (managed_sessions, open_unrecorded_terminals, running_counts_by_terminal).

    Only includes processes attached to a live, currently open terminal window —
    orphaned/closed-tab processes and parent-shell duplicates are strictly filtered out.
    """
    procs = _scan_proc_table()
    children_map: dict[int, list[int]] = {}
    for pid, info in procs.items():
        children_map.setdefault(info["ppid"], []).append(pid)

    managed: list[dict] = []
    covered_pids: set[int] = set()
    covered_pts: set[str] = set()
    running_counts: dict[str, int] = {}

    # 1. Live rec-pty managed sessions
    if SESS_DIR.is_dir():
        for p in sorted(SESS_DIR.glob("*.json")):
            try:
                data = json.loads(p.read_text(encoding="utf-8"))
                pid = int(data.get("pid", 0))
                if pid <= 0 or pid not in procs or not is_pid_alive(pid):
                    p.unlink(missing_ok=True)
                    (ACTIVE_DIR / str(pid)).unlink(missing_ok=True)
                    continue
                cast = data.get("cast", "")
                if cast and os.path.exists(cast):
                    data["cast_size"] = os.path.getsize(cast)
                managed.append(data)
                covered_pids.add(pid)
                _mark_shell_ancestors(pid, covered_pids, procs)
                pts = _get_pts_path(pid)
                if pts:
                    covered_pts.add(pts)
                cpid = int(data.get("child_pid", 0))
                if cpid > 0:
                    covered_pids.add(cpid)
                    cpts = _get_pts_path(cpid)
                    if cpts:
                        covered_pts.add(cpts)
                term = (data.get("terminal") or "").lower()
                if term:
                    running_counts[term] = running_counts.get(term, 0) + 1
            except Exception:
                continue

    # 2. Legacy pre-v1.3.0 asciinema rec sessions — ONLY if attached to a currently open terminal window
    for pid, info in procs.items():
        if pid in covered_pids:
            continue
        parts = info["parts"]
        if not parts:
            continue
        base0 = os.path.basename(parts[0])
        if ("asciinema" in base0 or any("asciinema" in x for x in parts[:2])) and "rec" in parts[1:4]:
            term = _detect_ancestor_terminal(pid, procs)
            pts = _get_pts_path(pid)
            # Skip orphaned asciinema processes whose terminal window was already closed
            if not term or not pts:
                continue
            cast = next((x for x in reversed(parts) if x.endswith(".cast")), "")
            started_at = os.path.getmtime(cast) if cast and os.path.exists(cast) else 0.0
            cast_size = os.path.getsize(cast) if cast and os.path.exists(cast) else 0
            child_shell = next((k for k in children_map.get(pid, []) if procs.get(k, {}).get("comm") in SHELL_COMMS), 0)
            cwd = _read_proc_cwd(child_shell or pid)
            fg = _deepest_fg_cmd(child_shell or pid, children_map, procs)
            managed.append({
                "pid": pid,
                "child_pid": child_shell,
                "state": "recording",
                "name": "old-tab",
                "terminal": term,
                "cast": cast,
                "meta": "",
                "cwd": cwd,
                "fg_cmd": fg,
                "last_cmd": "",
                "started_at": started_at,
                "cast_size": cast_size,
                "legacy": True,
            })
            covered_pids.add(pid)
            covered_pts.add(pts)
            _mark_shell_ancestors(pid, covered_pids, procs)
            if child_shell:
                covered_pids.add(child_shell)
                cpts = _get_pts_path(child_shell)
                if cpts:
                    covered_pts.add(cpts)
            running_counts[term] = running_counts.get(term, 0) + 1

    # 3. Currently open unrecorded terminal tabs (Kitty, Tabby, Alacritty, etc.)
    open_unrecorded: list[dict] = []
    for pid, info in procs.items():
        if pid in covered_pids:
            continue
        if info["comm"] not in SHELL_COMMS or info["comm"] == "sh":
            continue
        if _has_ancestor_in(pid, covered_pids, procs):
            continue
        pts = _get_pts_path(pid)
        if not pts or pts in covered_pts or info["tty_nr"] == 0:
            continue
        term = _detect_ancestor_terminal(pid, procs)
        if not term:
            continue
        parent = procs.get(info["ppid"])
        if parent and parent["comm"] in SHELL_COMMS:
            continue

        cwd = _read_proc_cwd(pid)
        fg = _deepest_fg_cmd(pid, children_map, procs)
        kitty_sock = _read_proc_env_var(pid, "KITTY_LISTEN_ON") if term == "kitty" else ""
        kitty_win = _read_proc_env_var(pid, "KITTY_WINDOW_ID") if term == "kitty" else ""
        tmux_pane = _read_proc_env_var(pid, "TMUX_PANE")
        open_unrecorded.append({
            "pid": pid,
            "terminal": term,
            "shell": info["comm"],
            "cwd": cwd,
            "fg_cmd": fg,
            "kitty_sock": kitty_sock,
            "kitty_win": kitty_win,
            "tmux_pane": tmux_pane,
        })
        covered_pts.add(pts)
        running_counts[term] = running_counts.get(term, 0) + 1

    # Only mark a terminal emulator as running if it has at least one live window/tab
    order = {"recording": 0, "paused": 1, "standby": 2}
    managed.sort(key=lambda x: (order.get(x.get("state", "standby"), 2), x.get("pid", 0)))
    open_unrecorded.sort(key=lambda x: (x["terminal"], x["pid"]))
    return managed, open_unrecorded, running_counts


def _match_term_proc(info: dict) -> str:
    comm = info["comm"].lower()
    if comm in PROC_TERM_MAP:
        return PROC_TERM_MAP[comm]
    if info["parts"]:
        base = os.path.basename(info["parts"][0]).lower()
        if base in PROC_TERM_MAP:
            return PROC_TERM_MAP[base]
        joined = " ".join(info["parts"][:2]).lower()
        if "tabby" in joined and ("tabby" in base or "electron" in base or "/tabby/" in joined):
            return "tabby"
    return ""


def _detect_ancestor_terminal(pid: int, procs: dict[int, dict]) -> str:
    cur = pid
    for _ in range(7):
        info = procs.get(cur)
        if not info:
            break
        ppid = info["ppid"]
        if ppid <= 1 or ppid == cur:
            break
        pinfo = procs.get(ppid)
        if not pinfo:
            break
        tid = _match_term_proc(pinfo)
        if tid:
            return tid
        cur = ppid
    return ""


def _has_ancestor_in(pid: int, target_set: set[int], procs: dict[int, dict]) -> bool:
    cur = pid
    for _ in range(8):
        info = procs.get(cur)
        if not info:
            return False
        ppid = info["ppid"]
        if ppid in target_set:
            return True
        if ppid <= 1 or ppid == cur:
            return False
        cur = ppid
    return False


def send_session_cmd(pid: int, cmd_line: str) -> bool:
    try:
        SESS_DIR.mkdir(parents=True, exist_ok=True)
        with open(SESS_DIR / f"{pid}.cmd", "a", encoding="utf-8") as f:
            f.write(cmd_line.strip() + "\n")
        os.kill(pid, signal.SIGUSR1)
        return True
    except OSError:
        return False


def detect_display_label() -> str:
    try:
        out = subprocess.check_output(["rec-cli", "config"], stderr=subprocess.DEVNULL, text=True, timeout=2)
        for line in out.splitlines():
            if "detected" in line and "=" in line:
                return line.split("=", 1)[1].strip()
    except Exception:
        pass
    return "1080p"


def fmt_elapsed(started_at: float) -> str:
    if not started_at or started_at <= 0:
        return "00:00"
    sec = max(0, int(time.time() - started_at))
    m, s = divmod(sec, 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_size(n: int) -> str:
    if n <= 0:
        return "0 B"
    val = float(n)
    for u in ("B", "KB", "MB", "GB"):
        if val < 1024:
            return f"{int(val)} {u}" if u == "B" else f"{val:.1f} {u}"
        val /= 1024
    return f"{val:.1f} TB"


def short_cwd(path: str) -> str:
    if not path:
        return "~"
    home = str(Path.home())
    if path == home:
        return "~"
    if path.startswith(home + "/"):
        return "~" + path[len(home):]
    return path


class WorkerThread(QThread):
    done = Signal(bool, str)

    def __init__(self, cmd: list[str], label: str):
        super().__init__()
        self.cmd = cmd
        self.label = label

    def run(self):
        try:
            proc = subprocess.run(self.cmd, capture_output=True, text=True)
            if proc.returncode == 0:
                self.done.emit(True, f"{self.label} done")
            else:
                err = (proc.stderr or proc.stdout or "failed").strip().splitlines()[-1]
                self.done.emit(False, f"{self.label}: {err}")
        except Exception as exc:
            self.done.emit(False, f"{self.label}: {exc}")


