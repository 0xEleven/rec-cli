    # ---------------- Helpers & Actions ----------------
    def _field_label(self, text: str) -> QLabel:
        lbl = QLabel(text)
        lbl.setObjectName("muted")
        return lbl

    def _select_combo_data(self, combo: QComboBox, target: str):
        for i in range(combo.count()):
            if str(combo.itemData(i)).lower() == str(target).lower():
                combo.setCurrentIndex(i)
                return

    def _show_toast(self, msg: str):
        self.toast_pill.setText(msg)
        self.toast_pill.show()
        QTimer.singleShot(2600, self.toast_pill.hide)

    def _apply_theme(self):
        self.setStyleSheet(build_stylesheet(self.ui_mode))
        self.logo_lbl.setPixmap(make_logo_pixmap(30, dark=(self.ui_mode == "dark")))
        self.theme_btn.setText("Light Mode" if self.ui_mode == "dark" else "Dark Mode")

    def _toggle_theme(self):
        self.ui_mode = "light" if self.ui_mode == "dark" else "dark"
        write_config_key("REC_UI_THEME", self.ui_mode)
        self._apply_theme()

    def _on_auto_toggled(self, checked: bool):
        set_auto_enabled(checked)
        self._show_toast("Auto-record ON" if checked else "Auto-record OFF")

    def _on_all_terms_toggled(self, checked: bool):
        for tid, btn in self.term_buttons.items():
            btn.setEnabled(not checked)
            if checked:
                btn.setChecked(True)
                btn.setProperty("selected", True)
                btn.style().unpolish(btn)
                btn.style().polish(btn)
        if checked:
            self._save_setting("REC_TERMINALS", "all")
        else:
            self._save_selected_terminals()

    def _on_term_chip_toggled(self, tid: str):
        btn = self.term_buttons[tid]
        btn.setProperty("selected", btn.isChecked())
        btn.style().unpolish(btn)
        btn.style().polish(btn)
        self._save_selected_terminals()

    def _save_selected_terminals(self):
        chosen = [tid for tid, btn in self.term_buttons.items() if btn.isChecked()]
        val = ",".join(chosen) if chosen else "none"
        self._save_setting("REC_TERMINALS", val)

    def _save_setting(self, key: str, val: str):
        self.cfg[key] = val
        write_config_key(key, val)
        self._show_toast("Saved")

    def _browse_video_dir(self):
        chosen = QFileDialog.getExistingDirectory(self, "Choose Clips Output Folder", self.dir_edit.text())
        if chosen:
            self.dir_edit.setText(chosen)
            self._save_setting("REC_VIDEO_DIR", chosen)
            self._refresh_clips(force=True)

    def _open_video_dir(self):
        vdir = Path(self.cfg.get("REC_VIDEO_DIR", str(Path.home() / "Videos/content")))
        vdir.mkdir(parents=True, exist_ok=True)
        if shutil.which("xdg-open"):
            subprocess.Popen(["xdg-open", str(vdir)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

    def _launch_recorded_terminal(self):
        name, ok = QInputDialog.getText(self, "New Recorded Terminal", "Optional clip name (leave blank to auto-name by command):")
        if not ok:
            return
        name = name.strip()
        shell = os.environ.get("SHELL", "/bin/bash")
        rec_cmd = ["rec-pty"] + (["--name", name] if name else []) + ["--", shell]

        # Prefer user's selected installed terminal
        preferred = [x.strip().lower() for x in self.cfg.get("REC_TERMINALS", "kitty,tabby").split(",")]
        candidates = preferred + ["kitty", "alacritty", "wezterm", "konsole", "gnome-terminal", "xterm"]
        launched = False
        for term in candidates:
            if term == "kitty" and shutil.which("kitty"):
                subprocess.Popen(["kitty", "-e", *rec_cmd], start_new_session=True)
                launched = True
                break
            if term == "alacritty" and shutil.which("alacritty"):
                subprocess.Popen(["alacritty", "-e", *rec_cmd], start_new_session=True)
                launched = True
                break
            if term == "wezterm" and shutil.which("wezterm"):
                subprocess.Popen(["wezterm", "start", "--", *rec_cmd], start_new_session=True)
                launched = True
                break
            if term == "konsole" and shutil.which("konsole"):
                subprocess.Popen(["konsole", "-e", *rec_cmd], start_new_session=True)
                launched = True
                break
            if term == "gnome-terminal" and shutil.which("gnome-terminal"):
                subprocess.Popen(["gnome-terminal", "--", *rec_cmd], start_new_session=True)
                launched = True
                break
            if term == "tabby" and shutil.which("tabby"):
                subprocess.Popen(["tabby"], start_new_session=True)
                launched = True
                break
        if launched:
            self._show_toast("Launched recorded terminal")
            QTimer.singleShot(800, lambda: self._refresh_sessions(force=True))
        else:
            QMessageBox.information(self, "rec-cli", "Open any terminal and run `rec start` to begin recording.")

    def _stop_all(self):
        sessions = load_live_sessions()
        count = 0
        for s in sessions:
            if s.get("legacy"):
                continue
            if s.get("state") in ("recording", "paused"):
                if send_session_cmd(s["pid"], "stop"):
                    count += 1
        self._show_toast(f"Stopped {count} session(s) — rendering MP4")
        QTimer.singleShot(300, lambda: self._refresh_sessions(force=True))

    def _session_action(self, pid: int, verb: str):
        if verb == "mark":
            label, ok = QInputDialog.getText(self, f"Chapter Marker (PID {pid})", "Chapter label (e.g. privesc, got root):")
            if not ok or not label.strip():
                return
            send_session_cmd(pid, f"mark {label.strip()}")
            self._show_toast(f"Marked: {label.strip()}")
        elif verb == "start":
            name, ok = QInputDialog.getText(self, f"Start Clip on PID {pid}", "Optional clip name (blank = auto-name):")
            if not ok:
                return
            send_session_cmd(pid, f"start {name.strip()}".strip())
            self._show_toast(f"Started recording PID {pid}")
        elif verb == "kill":
            ans = QMessageBox.question(self, "Terminate Session", f"Terminate recording process PID {pid} and its shell?")
            if ans != QMessageBox.StandardButton.Yes:
                return
            try:
                os.kill(pid, signal.SIGTERM)
                self._show_toast(f"Terminated PID {pid}")
            except OSError:
                pass
        else:
            send_session_cmd(pid, verb)
            labels = {"stop": "Stopped — rendering MP4", "pause": "Paused", "resume": "Resumed", "cancel": "Discarded"}
            self._show_toast(labels.get(verb, verb))
        QTimer.singleShot(250, lambda: self._refresh_sessions(force=True))

    def _run_bg(self, cmd: list[str], label: str):
        self._show_toast(f"{label}…")
        w = WorkerThread(cmd, label)
        w.done.connect(lambda ok, msg: (self._show_toast(msg), self._refresh_clips(force=True)))
        self.workers.append(w)
        w.finished.connect(lambda: self.workers.remove(w) if w in self.workers else None)
        w.start()

    def _render_pending(self):
        self._run_bg(["casts2mp4"], "Render pending")

    def _play_clip(self, path: Path):
        for player in ("mpv", "parole", "vlc", "xdg-open"):
            if shutil.which(player):
                subprocess.Popen([player, str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
                return

    def _delete_clip(self, path: Path):
        ans = QMessageBox.question(self, "Delete Clip", f"Delete {path.name}?")
        if ans == QMessageBox.StandardButton.Yes:
            path.unlink(missing_ok=True)
            self._show_toast("Deleted")
            self._refresh_clips(force=True)

    # ---------------- Periodic Refresh ----------------
    def _on_tick(self):
        self._refresh_sessions(force=False)
        if self.stack.currentIndex() == 2:
            self._refresh_clips(force=False)

    def _clear_layout(self, layout: QVBoxLayout):
        while layout.count():
            item = layout.takeAt(0)
            w = item.widget()
            if w is not None:
                w.deleteLater()

    def _refresh_sessions(self, force: bool = False):
        sessions = load_live_sessions()
        rec_n = sum(1 for s in sessions if s.get("state") == "recording")
        paused_n = sum(1 for s in sessions if s.get("state") == "paused")

        if rec_n > 0:
            self.live_pill.setText(f"● {rec_n} Recording")
            self.live_pill.setObjectName("recPill")
            self.stop_all_btn.show()
        elif paused_n > 0:
            self.live_pill.setText(f"❚❚ {paused_n} Paused")
            self.live_pill.setObjectName("pausedPill")
            self.stop_all_btn.show()
        else:
            self.live_pill.setText("Idle")
            self.live_pill.setObjectName("idlePill")
            self.stop_all_btn.hide()
        self.live_pill.style().unpolish(self.live_pill)
        self.live_pill.style().polish(self.live_pill)

        # Avoid rebuilding cards unnecessarily if nothing visible changed
        sig = [
            (s.get("pid"), s.get("state"), s.get("name"), s.get("fg_cmd"), s.get("cast_size"), int(time.time() - s.get("started_at", 0)) if s.get("state") == "recording" else 0)
            for s in sessions
        ]
        if not force and sig == self.last_sessions_sig:
            return
        self.last_sessions_sig = sig

        self._clear_layout(self.sessions_lay)

        if not sessions:
            empty = QFrame()
            empty.setObjectName("card")
            el = QVBoxLayout(empty)
            el.setContentsMargins(24, 34, 24, 34)
            el.setSpacing(6)
            lbl1 = QLabel("No active recording sessions")
            lbl1.setObjectName("sectionTitle")
            lbl1.setAlignment(Qt.AlignmentFlag.AlignCenter)
            lbl2 = QLabel("Open Kitty or Tabby, run `rec start`, or click \"+ New Recorded Terminal\" above.")
            lbl2.setObjectName("muted")
            lbl2.setAlignment(Qt.AlignmentFlag.AlignCenter)
            el.addWidget(lbl1)
            el.addWidget(lbl2)
            self.sessions_lay.addWidget(empty)
            self.sessions_lay.addStretch()
            return

        for s in sessions:
            pid = s["pid"]
            state = s.get("state", "standby")
            name = s.get("name") or (s.get("last_cmd", "").split()[0] if s.get("last_cmd") else "auto-named")
            term = s.get("terminal", "tty")
            cwd = (s.get("cwd") or "").replace(str(Path.home()), "~")
            cmd_txt = s.get("fg_cmd") or s.get("last_cmd") or cwd
            elapsed = fmt_elapsed(s.get("started_at", 0)) if state != "standby" else "standby"
            sz = fmt_size(s.get("cast_size", 0)) if state != "standby" else ""

            card = QFrame()
            card.setObjectName("cardActive" if state == "recording" else "card")
            cl = QHBoxLayout(card)
            cl.setContentsMargins(16, 13, 16, 13)
            cl.setSpacing(12)

            left = QVBoxLayout()
            left.setSpacing(5)

            row1 = QHBoxLayout()
            row1.setSpacing(8)
            pill = QLabel("● REC" if state == "recording" else "❚❚ PAUSED" if state == "paused" else "○ STANDBY")
            pill.setObjectName("recPill" if state == "recording" else "pausedPill" if state == "paused" else "idlePill")
            row1.addWidget(pill)

            name_lbl = QLabel(name)
            name_lbl.setObjectName("sectionTitle")
            row1.addWidget(name_lbl)

            pid_lbl = QLabel(f"PID {pid}")
            pid_lbl.setObjectName("monoBadge")
            row1.addWidget(pid_lbl)

            term_lbl = QLabel(term)
            term_lbl.setObjectName("monoBadge")
            row1.addWidget(term_lbl)

            meta_str = f"{elapsed}  ·  {sz}" if sz else elapsed
            time_lbl = QLabel(meta_str)
            time_lbl.setObjectName("muted")
            row1.addWidget(time_lbl)
            row1.addStretch()
            left.addLayout(row1)

            cmd_lbl = QLabel(f"{cmd_txt}   ({cwd})" if cmd_txt != cwd else cwd)
            cmd_lbl.setObjectName("muted")
            left.addWidget(cmd_lbl)
            cl.addLayout(left, 1)

            # Contextual action buttons
            btns = QHBoxLayout()
            btns.setSpacing(6)
            if s.get("legacy"):
                b_kill = QPushButton("Kill Legacy Tab")
                b_kill.setObjectName("dangerBtn")
                b_kill.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "kill"))
                btns.addWidget(b_kill)
            elif state == "recording":
                b_pause = QPushButton("Pause")
                b_pause.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "pause"))
                b_mark = QPushButton("+ Mark")
                b_mark.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "mark"))
                b_stop = QPushButton("Stop & Save")
                b_stop.setObjectName("primaryBtn")
                b_stop.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "stop"))
                b_cancel = QPushButton("Discard")
                b_cancel.setObjectName("dangerBtn")
                b_cancel.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "cancel"))
                for b in (b_pause, b_mark, b_stop, b_cancel):
                    btns.addWidget(b)
            elif state == "paused":
                b_res = QPushButton("Resume")
                b_res.setObjectName("primaryBtn")
                b_res.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "resume"))
                b_stop = QPushButton("Stop & Save")
                b_stop.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "stop"))
                b_cancel = QPushButton("Discard")
                b_cancel.setObjectName("dangerBtn")
                b_cancel.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "cancel"))
                for b in (b_res, b_stop, b_cancel):
                    btns.addWidget(b)
            else:
                b_start = QPushButton("Start Clip")
                b_start.setObjectName("primaryBtn")
                b_start.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "start"))
                b_kill = QPushButton("Kill")
                b_kill.setObjectName("dangerBtn")
                b_kill.clicked.connect(lambda _c=False, p=pid: self._session_action(p, "kill"))
                for b in (b_start, b_kill):
                    btns.addWidget(b)

            cl.addLayout(btns)
            self.sessions_lay.addWidget(card)

        self.sessions_lay.addStretch()

    def _refresh_clips(self, force: bool = False):
        vdir = Path(self.cfg.get("REC_VIDEO_DIR", str(Path.home() / "Videos/content")))
        vdir.mkdir(parents=True, exist_ok=True)
        query = self.clip_search.text().strip().lower() if hasattr(self, "clip_search") else ""

        mp4s = sorted(vdir.glob("*.mp4"), key=lambda p: p.stat().st_mtime, reverse=True)
        if query:
            mp4s = [p for p in mp4s if query in p.name.lower()]

        sig = [(p.name, p.stat().st_size, int(p.stat().st_mtime)) for p in mp4s]
        if not force and sig == self.last_clips_sig:
            return
        self.last_clips_sig = sig

        total_bytes = sum(s for _, s, _ in sig)
        self.clips_title.setText(f"Saved Clips  ({len(mp4s)} · {fmt_size(total_bytes)})")

        self._clear_layout(self.clips_lay)

        if not mp4s:
            empty = QFrame()
            empty.setObjectName("card")
            el = QVBoxLayout(empty)
            el.setContentsMargins(24, 34, 24, 34)
            lbl = QLabel("No clips found" if query else f"No clips in {vdir} yet")
            lbl.setObjectName("muted")
            lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            el.addWidget(lbl)
            self.clips_lay.addWidget(empty)
            self.clips_lay.addStretch()
            return

        for p in mp4s[:40]:
            st = p.stat()
            mtime = time.strftime("%b %d · %H:%M", time.localtime(st.st_mtime))
            card = QFrame()
            card.setObjectName("card")
            rl = QHBoxLayout(card)
            rl.setContentsMargins(14, 10, 14, 10)
            rl.setSpacing(10)

            info = QVBoxLayout()
            info.setSpacing(2)
            name_lbl = QLabel(p.name)
            name_lbl.setStyleSheet("font-weight: 600;")
            meta_lbl = QLabel(f"{fmt_size(st.st_size)}  ·  {mtime}")
            meta_lbl.setObjectName("muted")
            info.addWidget(name_lbl)
            info.addWidget(meta_lbl)
            rl.addLayout(info, 1)

            b_play = QPushButton("Play")
            b_play.setObjectName("primaryBtn")
            b_play.clicked.connect(lambda _c=False, path=p: self._play_clip(path))
            b_gif = QPushButton("GIF")
            b_gif.clicked.connect(lambda _c=False, path=p: self._run_bg(["rec-cli", "gif", str(path)], "GIF export"))
            b_thumb = QPushButton("Thumb")
            b_thumb.clicked.connect(lambda _c=False, path=p: self._run_bg(["rec-cli", "thumb", str(path)], "Thumbnail"))
            b_del = QPushButton("Delete")
            b_del.setObjectName("dangerBtn")
            b_del.clicked.connect(lambda _c=False, path=p: self._delete_clip(path))

            for b in (b_play, b_gif, b_thumb, b_del):
                rl.addWidget(b)
            self.clips_lay.addWidget(card)

        self.clips_lay.addStretch()


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("rec-cli")
    win = RecGuiWindow()
    if "--smoke-test" in sys.argv:
        # Clean headless verification for CI / automated tests
        win.show()
        win._toggle_theme()
        win._toggle_theme()
        app.processEvents()
        win.close()
        print(f"SMOKE_OK ({QT_BINDING})")
        return 0
    win.show()
    return app.exec() if hasattr(app, "exec") else app.exec_()


if __name__ == "__main__":
    sys.exit(main())
