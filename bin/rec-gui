    os.environ.setdefault("QT_QPA_PLATFORM", "offscreen")
    os.environ["QT_QPA_PLATFORMTHEME"] = ""
    os.environ["XDG_CURRENT_DESKTOP"] = ""
    os.environ["GNOME_DESKTOP_SESSION_ID"] = ""

