            ("auto", f"Auto ({disp})"),
            ("720p", "720p HD (1280x720)"),
            ("1080p", "1080p Full HD (1920x1080)"),
            ("1440p", "1440p QHD (2560x1440)"),
            ("4k", "4K UHD (3840x2160)"),
            ("reels", "TikTok / Reels 9:16 (1080x1920, cursor-follow)"),
            ("reels-4k", "TikTok / Reels 4K 9:16 (2160x3840, cursor-follow)"),
        ]
        for val, text in self.res_items:
            self.res_combo.addItem(text, val)
        self._select_combo_data(self.res_combo, self.cfg.get("REC_RESOLUTION", "auto"))
        self.res_combo.currentIndexChanged.connect(
            lambda: self._save_setting("REC_RESOLUTION", self.res_combo.currentData())
        )

        self.speed_combo = QComboBox()
        for val, text in [("1", "1x (Real time)"), ("1.5", "1.5x"), ("2", "2x (Fast typing)"), ("2.5", "2.5x"), ("3", "3x")]:
            self.speed_combo.addItem(text, val)
        self._select_combo_data(self.speed_combo, self.cfg.get("REC_SPEED", "2"))
        self.speed_combo.currentIndexChanged.connect(
            lambda: self._save_setting("REC_SPEED", self.speed_combo.currentData())
        )

        self.maxlen_combo = QComboBox()
        for val, text in [("60", "1 minute"), ("180", "3 minutes"), ("300", "5 minutes"), ("600", "10 minutes"), ("900", "15 minutes")]:
            self.maxlen_combo.addItem(text, val)
        self._select_combo_data(self.maxlen_combo, self.cfg.get("REC_MAX_SECS", "300"))
        self.maxlen_combo.currentIndexChanged.connect(
