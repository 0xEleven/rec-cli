#!/usr/bin/env bash
set -euo pipefail

# casts2mp4 — Batch-convert finished .cast recordings into auto/4K/Reels 5-min max MP4 clips
# Part of rec-cli v1.2.0

CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rec-cli/config"
if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

BG=0
KEEP=0
SPEED="${REC_SPEED:-${CAST_SPEED:-2}}"
RES="${REC_RESOLUTION:-auto}"
QUIET=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bg) BG=1; QUIET=1; shift ;;
    --keep) KEEP=1; shift ;;
    --quiet|-q) QUIET=1; shift ;;
    --speed|-s) SPEED="$2"; shift 2 ;;
    --res|--resolution|-r) RES="$2"; shift 2 ;;
    -h|--help)
      echo "Usage: casts2mp4 [--bg] [--keep] [--quiet] [--speed <N>] [--res 720p|1080p|1440p|4k|vertical]"
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

if [[ "$BG" -eq 1 ]]; then
  ARGS=(--quiet --speed "$SPEED" --res "$RES")
  [[ "$KEEP" -eq 1 ]] && ARGS+=(--keep)
  if command -v setsid >/dev/null 2>&1; then
    setsid -f "$0" "${ARGS[@]}" </dev/null >/dev/null 2>&1
  else
    nohup "$0" "${ARGS[@]}" </dev/null >/dev/null 2>&1 &
  fi
  exit 0
fi

BASE_DIR="${REC_DIR:-${TERM_REC_DIR:-$HOME/Videos/terminal-recordings}}"
CAST_DIR="$BASE_DIR/casts"
MP4_DIR="${REC_VIDEO_DIR:-${TERM_VIDEO_DIR:-$HOME/Videos/content}}"
LOCK_FILE="/tmp/casts2mp4-${USER:-$(id -un)}.lock"

mkdir -p "$CAST_DIR" "$MP4_DIR"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  exit 0
fi

log() {
  if [[ "$QUIET" -eq 0 ]]; then
    echo "$@"
  fi
}

RUNTIME_DIR="${REC_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/rec-cli-$(id -u)}"
SESS_DIR="$RUNTIME_DIR/sessions"
LOCK_DIR="$RUNTIME_DIR/locks"

is_cast_active() {
  local f="$1"
  local bname
  bname="$(basename "$f")"

  # 1. Check if any live rec-pty session currently owns this cast file
  if [[ -d "$SESS_DIR" ]] && python3 - "$SESS_DIR" "$f" <<'PYEOF'
import json, os, sys
from pathlib import Path

sess_dir = Path(sys.argv[1])
target = os.path.realpath(sys.argv[2])
for p in sess_dir.glob("*.json"):
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
        pid = int(data.get("pid", 0))
        if pid <= 0:
            continue
        os.kill(pid, 0)
        cast = data.get("cast", "")
        if cast and os.path.realpath(cast) == target:
            sys.exit(0)
    except Exception:
        continue
sys.exit(1)
PYEOF
  then
    return 0
  fi

  # 2. Check if cast2mp4 is already rendering this cast file
  if [[ -f "$LOCK_DIR/${bname}.lock" ]] && command -v flock >/dev/null 2>&1; then
    if ! flock -n "$LOCK_DIR/${bname}.lock" true 2>/dev/null; then
      return 0
    fi
  fi

  # 3. Check open file descriptors (fuser) and legacy asciinema processes
  if command -v fuser >/dev/null 2>&1 && fuser "$f" >/dev/null 2>&1; then
    return 0
  fi
  if pgrep -f "asciinema.*${bname}" >/dev/null 2>&1; then
    return 0
  fi
  local mtime now
  mtime="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  if (( now - mtime < 15 )); then
    return 0
  fi
  return 1
}

shopt -s nullglob
processed=0
skipped_active=0

for cast in "$CAST_DIR"/*.cast; do
  if is_cast_active "$cast"; then
    skipped_active=$((skipped_active + 1))
    continue
  fi

  base="$(basename "$cast" .cast)"
  log "Processing ${base}.cast (${RES}, ${SPEED}x, max 5m, input+output only)..."
  CLEAN_ARGS=(--auto --speed "$SPEED" --res "$RES")
  [[ "$KEEP" -eq 0 ]] && CLEAN_ARGS+=(--cleanup)

  if cast2mp4 "${CLEAN_ARGS[@]}" "$cast" 2>/dev/null; then
    processed=$((processed + 1))
  else
    log "  Warning: failed to process ${base}.cast"
  fi
done

for meta in "$CAST_DIR"/*.meta; do
  if [[ ! -f "${meta%.meta}.cast" && ! -f "${meta%.meta}.cast.recording" ]]; then
    rm -f "$meta"
  fi
done

log "Done: ${processed} processed -> ${MP4_DIR}, ${skipped_active} currently active."
