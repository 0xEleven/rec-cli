#!/usr/bin/env bash
set -euo pipefail

# cast2mp4 — Smart terminal .cast -> auto/4K/Reels MP4 renderer (rec-cli v1.2.0)
# - Resolution presets: auto (detects display), 720p, 1080p, 1440p, 4k, reels (9:16 cursor-follow), reels-4k
# - Default 2x speed, 60fps H.264 MP4 (30fps smooth camera pan for reels)
# - Max 5 minutes (300s) per video (auto-splits longer sessions into 5-min parts)
# - Input+output gating & OpenVPN/daemon skip
# - Automatic secret/token redaction
# - Sleek macOS-style window frame & titlebar overlay
# - YouTube chapter markers (.chapters.txt) via `rec mark`
# - Cursor-following auto-reframe for TikTok / Instagram Reels / YouTube Shorts without cropping

CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rec-cli/config"
if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

AUTO_MODE=0
CLEANUP=0
SPEED="${REC_SPEED:-${CAST_SPEED:-2}}"
MAX_SECS="${REC_MAX_SECS:-${CAST_MAX_SECS:-300}}"
IDLE_LIMIT="${REC_IDLE_LIMIT:-${CAST_IDLE_LIMIT:-1.5}}"
OUT_DIR="${REC_VIDEO_DIR:-${TERM_VIDEO_DIR:-$HOME/Videos/content}}"
THEME_NAME="${REC_THEME:-tokyo-night}"
RESOLUTION="${REC_RESOLUTION:-auto}"
FRAME_MODE="${REC_FRAME:-on}"
REDACT_MODE="${REC_REDACT:-on}"
REELS_COPY="${REC_REELS_COPY:-off}"

POSITIONAL=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --auto) AUTO_MODE=1; shift ;;
    --cleanup) CLEANUP=1; shift ;;
    --speed|-s) SPEED="$2"; shift 2 ;;
    --max-secs|-m) MAX_SECS="$2"; shift 2 ;;
    --out-dir|-o) OUT_DIR="$2"; shift 2 ;;
    --theme|-t) THEME_NAME="$2"; shift 2 ;;
    --res|--resolution|-r) RESOLUTION="$2"; shift 2 ;;
    --frame) FRAME_MODE="on"; shift ;;
    --no-frame) FRAME_MODE="off"; shift ;;
    --redact) REDACT_MODE="on"; shift ;;
    --no-redact) REDACT_MODE="off"; shift ;;
    --reels-copy) REELS_COPY="on"; shift ;;
    -h|--help)
      cat <<EOF
Usage: cast2mp4 [options] <input.cast> [output.mp4] [speed]
  --res, -r RES          auto | 720p | 1080p | 1440p | 4k | reels | reels-4k | vertical
  --speed, -s N          Playback speed multiplier (default: 2)
  --max-secs N           Max seconds per clip before splitting (default: 300)
  --theme NAME           tokyo-night | dracula | catppuccin | gruvbox | nord
  --frame/--no-frame     Toggle rounded window frame overlay (default: on)
  --redact/--no-redact   Toggle secret/token redaction (default: on)
  --reels-copy           Also export a 9:16 cursor-following Reels/TikTok version
  --auto                 Apply input+output gating, OpenVPN skip & process naming
  --cleanup              Delete source .cast + .meta after successful render
EOF
      exit 0
      ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

if [[ ${#POSITIONAL[@]} -lt 1 ]]; then
  echo "Usage: cast2mp4 [options] <input.cast> [output.mp4]" >&2
  exit 1
fi

INPUT="${POSITIONAL[0]}"
EXPLICIT_OUT="${POSITIONAL[1]:-}"
if [[ -n "${POSITIONAL[2]:-}" ]]; then
  SPEED="${POSITIONAL[2]}"
fi

if [[ ! -f "$INPUT" ]]; then
  echo "Error: file not found: $INPUT" >&2
  exit 1
fi

# Auto-detect running display resolution (Wayland -> X11 -> Linux DRM sysfs -> fallback 1080p)
detect_screen_preset() {
  local dims="" w=0 h=0

  # 1. Wayland compositors
  if [[ -z "$dims" ]] && command -v hyprctl >/dev/null 2>&1; then
    dims="$(hyprctl monitors 2>/dev/null | grep -oE '[0-9]{3,4}x[0-9]{3,4}@' | head -n 1 | tr -d '@' || true)"
  fi
  if [[ -z "$dims" ]] && command -v wlr-randr >/dev/null 2>&1; then
    dims="$(wlr-randr 2>/dev/null | grep -E 'current' | grep -oE '[0-9]{3,4}x[0-9]{3,4}' | head -n 1 || true)"
  fi
  if [[ -z "$dims" ]] && command -v swaymsg >/dev/null 2>&1; then
    dims="$(swaymsg -t get_outputs 2>/dev/null | python3 -c 'import json,sys; o=[x for x in json.load(sys.stdin) if x.get("active")]; m=o[0]["current_mode"] if o else {}; print(f"{m[\"width\"]}x{m[\"height\"]}") if m else None' 2>/dev/null || true)"
  fi
  if [[ -z "$dims" ]] && command -v kscreen-doctor >/dev/null 2>&1; then
    dims="$(kscreen-doctor -o 2>/dev/null | grep -oE '[0-9]{3,4}x[0-9]{3,4}@[^ ]*\*' | head -n 1 | cut -d@ -f1 || true)"
  fi
  # 2. X11 / XWayland
  if [[ -z "$dims" ]] && command -v xrandr >/dev/null 2>&1; then
    dims="$(xrandr --current 2>/dev/null | grep '\*' | grep -oE '[0-9]{3,4}x[0-9]{3,4}' | head -n 1 || true)"
  fi
  # 3. Linux kernel DRM sysfs (works everywhere, even headless/TTY)
  if [[ -z "$dims" ]]; then
    local best_area=0 f st dir mode cw ch area
    for f in /sys/class/drm/*/status; do
      [[ -f "$f" ]] || continue
      st="$(cat "$f" 2>/dev/null || true)"
      [[ "$st" == "connected" ]] || continue
      dir="$(dirname "$f")"
      mode="$(head -n 1 "$dir/modes" 2>/dev/null || true)"
      if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
        cw="${BASH_REMATCH[1]}"
        ch="${BASH_REMATCH[2]}"
        area=$(( cw * ch ))
        if (( area > best_area )); then
          best_area=$area
          dims="${cw}x${ch}"
        fi
      fi
    done
  fi

  if [[ "$dims" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    w="${BASH_REMATCH[1]}"
    h="${BASH_REMATCH[2]}"
  fi

  if (( w >= 3840 || h >= 2160 )); then
    echo "4k"
  elif (( w >= 2560 || h >= 1440 )); then
    echo "1440p"
  elif (( w >= 1920 || h >= 1080 )); then
    echo "1080p"
  elif (( w > 0 )); then
    echo "720p"
  else
    echo "1080p"
  fi
}

RES_LC="${RESOLUTION,,}"
if [[ "$RES_LC" == "auto" ]]; then
  RES_LC="$(detect_screen_preset)"
fi

IS_REELS=0
case "$RES_LC" in
  720p|hd)
    OUT_W=1280; OUT_H=720; FONT_SIZE=16; INNER_W=1180; INNER_H=620; TITLE_H=34; CRF=18
    ;;
  1080p|fhd)
    OUT_W=1920; OUT_H=1080; FONT_SIZE=22; INNER_W=1780; INNER_H=940; TITLE_H=44; CRF=18
    ;;
  1440p|2k|qhd)
    OUT_W=2560; OUT_H=1440; FONT_SIZE=30; INNER_W=2380; INNER_H=1260; TITLE_H=56; CRF=17
    ;;
  4k|2160p|uhd)
    OUT_W=3840; OUT_H=2160; FONT_SIZE=44; INNER_W=3560; INNER_H=1890; TITLE_H=78; CRF=16
    ;;
  reels|tiktok|shorts|vertical|9:16)
    IS_REELS=1; OUT_W=1080; OUT_H=1920; FONT_SIZE=28; INNER_W=1000; INNER_H=1660; TITLE_H=52; CRF=18
    ;;
  reels-4k|tiktok-4k|shorts-4k|vertical-4k)
    IS_REELS=1; OUT_W=2160; OUT_H=3840; FONT_SIZE=44; INNER_W=2000; INNER_H=3320; TITLE_H=96; CRF=16
    ;;
  *)
    echo "Unknown resolution '$RESOLUTION' (use: auto, 720p, 1080p, 1440p, 4k, reels, reels-4k)" >&2
    exit 1
    ;;
esac

# Resolve theme palette (bg,fg,color0..color7) + backdrop/border accents
case "${THEME_NAME,,}" in
  tokyo-night|tokyonight)
    AGG_THEME="1a1b26,c0caf5,15161e,f7768e,9ece6a,e0af68,7aa2f7,bb9af7,7dcfff,a9b1d6"
    BG_HEX="#1a1b26"; CANVAS_TOP="#16161e"; CANVAS_BOT="#1f2335"; ACCENT_HEX="#bb9af7"; FG_HEX="#c0caf5"
    ;;
  dracula)
    AGG_THEME="282a36,f8f8f2,21222c,ff5555,50fa7b,f1fa8c,bd93f9,ff79c6,8be9fd,f8f8f2"
    BG_HEX="#282a36"; CANVAS_TOP="#1e1f29"; CANVAS_BOT="#303344"; ACCENT_HEX="#bd93f9"; FG_HEX="#f8f8f2"
    ;;
  catppuccin|catppuccin-mocha)
    AGG_THEME="1e1e2e,cdd6f4,45475a,f38ba8,a6e3a1,f9e2af,89b4fa,f5c2e7,94e2d5,bac2de"
    BG_HEX="#1e1e2e"; CANVAS_TOP="#181825"; CANVAS_BOT="#26263a"; ACCENT_HEX="#cba6f7"; FG_HEX="#cdd6f4"
    ;;
  gruvbox|gruvbox-dark)
    AGG_THEME="282828,ebdbb2,282828,cc241d,98971a,d79921,458588,b16286,689d6a,a89984"
    BG_HEX="#282828"; CANVAS_TOP="#1d2021"; CANVAS_BOT="#32302f"; ACCENT_HEX="#fabd2f"; FG_HEX="#ebdbb2"
    ;;
  nord)
    AGG_THEME="2e3440,d8dee9,3b4252,bf616a,a3be8c,ebcb8b,81a1c1,b48ead,88c0d0,e5e9f0"
    BG_HEX="#2e3440"; CANVAS_TOP="#242933"; CANVAS_BOT="#3b4252"; ACCENT_HEX="#88c0d0"; FG_HEX="#eceff4"
    ;;
  *)
    AGG_THEME="1a1b26,c0caf5,15161e,f7768e,9ece6a,e0af68,7aa2f7,bb9af7,7dcfff,a9b1d6"
    BG_HEX="#1a1b26"; CANVAS_TOP="#16161e"; CANVAS_BOT="#1f2335"; ACCENT_HEX="#bb9af7"; FG_HEX="#c0caf5"
    ;;
esac

META_FILE="${INPUT%.cast}.meta"
mkdir -p "$OUT_DIR"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

RENDER_CAST="$INPUT"
if [[ "${REDACT_MODE,,}" != "off" && "${REDACT_MODE,,}" != "0" && "${REDACT_MODE,,}" != "false" ]]; then
  RENDER_CAST="$WORK_DIR/redacted.cast"
fi

# Analyze cast + meta sidecar (redaction, input+output gate, OpenVPN skip, chapters, cursor track)
PLAN="$(python3 - "$INPUT" "$META_FILE" "$IDLE_LIMIT" "$SPEED" "$MAX_SECS" "$AUTO_MODE" "$RENDER_CAST" "$WORK_DIR" <<'PYEOF'
import json
import os
import re
import shlex
import sys
import time

cast_path = sys.argv[1]
meta_path = sys.argv[2]
idle_limit = float(sys.argv[3])
speed = max(0.1, float(sys.argv[4]))
max_secs = max(10.0, float(sys.argv[5]))
auto_mode = sys.argv[6] == "1"
render_cast_path = sys.argv[7]
work_dir = sys.argv[8]
do_redact = (render_cast_path != cast_path)

WRAPPERS = {
    "sudo", "doas", "env", "time", "command", "builtin", "nohup", "nice",
    "ionice", "stdbuf", "timeout", "proxychains", "proxychains4", "rlwrap",
    "setsid", "strace", "ltrace", "unbuffer", "script",
}

SKIP_ONLY_CMDS = {
    "openvpn", "wg-quick", "tail", "journalctl", "watch", "htop", "btop",
    "top", "dmesg", "vmstat", "iostat", "nload", "iftop",
}

TRIVIAL_CMDS = {
    "cd", "ls", "ll", "la", "lt", "eza", "clear", "cls", "pwd", "exit",
    "logout", "history", "reload", "recs", "echo", "printf", "mkdir", "rmdir",
    "touch", "export", "unset", "source", ".", "alias", "unalias", "which",
    "type", "whoami", "id", "date", "uname", "true", "false", "norec",
    "render-casts", "casts2mp4", "rec", "rec-cli",
}

INTERPRETERS = {"python", "python3", "python2", "bash", "sh", "zsh", "fish", "ruby", "perl", "node", "php", "go"}

SECRET_PATTERNS = [
    (re.compile(r"AKIA[0-9A-Z]{16}"), "[REDACTED_AWS_KEY]"),
    (re.compile(r"gh[pousr]_[A-Za-z0-9_]{20,}"), "[REDACTED_GH_TOKEN]"),
    (re.compile(r"github_pat_[A-Za-z0-9_]{20,}"), "[REDACTED_GH_TOKEN]"),
    (re.compile(r"\bsk-(?:proj-|ant-|live-|test-)?[A-Za-z0-9_-]{20,}\b"), "[REDACTED_API_KEY]"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"), "[REDACTED_JWT]"),
    (re.compile(r"(Bearer\s+)[A-Za-z0-9._~+/=-]{20,}", re.I), r"\1[REDACTED_TOKEN]"),
    (re.compile(r"((?:PASSWORD|PASSWD|API_KEY|APIKEY|SECRET_KEY|ACCESS_TOKEN|AUTH_TOKEN|PRIVATE_TOKEN)\s*[=:]\s*['\"]?)([^\s'\"\r\n;]{4,})", re.I), r"\1[REDACTED]"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----"), "[REDACTED_PRIVATE_KEY]"),
]


def redact_text(s: str) -> str:
    for pat, repl in SECRET_PATTERNS:
        s = pat.sub(repl, s)
    return s


def sanitize(name: str) -> str:
    name = os.path.basename(name.strip())
    name = re.sub(r"\.(py|sh|rb|pl|js|php|go|exe|elf|bin)$", "", name, flags=re.I)
    name = re.sub(r"[^a-zA-Z0-9_-]+", "-", name).strip("-_")
    return (name[:32] or "terminal").lower()


def extract_tool(cmdline: str) -> tuple[str, bool, bool]:
    first_seg = re.split(r"\s*(?:&&|\|\||;|\|)\s*", cmdline.strip(), maxsplit=1)[0]
    try:
        tokens = shlex.split(first_seg)
    except ValueError:
        tokens = first_seg.split()

    i = 0
    while i < len(tokens):
        tok = tokens[i]
        if re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", tok):
            i += 1
            continue
        base = os.path.basename(tok)
        if base in WRAPPERS:
            i += 1
            while i < len(tokens) and tokens[i].startswith("-"):
                flag = tokens[i]
                i += 1
                if base == "sudo" and flag in ("-u", "-g", "-p", "-C", "-h", "-r", "-t") and i < len(tokens):
                    i += 1
            if base == "timeout" and i < len(tokens) and re.match(r"^[0-9]+[smhd]?$", tokens[i]):
                i += 1
            continue
        break

    if i >= len(tokens):
        return ("", False, True)

    cmd = os.path.basename(tokens[i])
    if cmd.startswith("./"):
        cmd = cmd[2:]

    is_skip = cmd in SKIP_ONLY_CMDS
    is_trivial = cmd in TRIVIAL_CMDS

    if cmd in INTERPRETERS and i + 1 < len(tokens):
        for arg in tokens[i + 1:]:
            if arg.startswith("-"):
                continue
            if "." in arg or "/" in arg:
                script = sanitize(arg)
                if script and script != cmd:
                    return (f"{sanitize(cmd)}-{script}"[:32], is_skip, is_trivial)
            break

    return (sanitize(cmd), is_skip, is_trivial)


# Lightweight VT100 cursor & active-width tracker for smooth Reels auto-reframe
CSI_RE = re.compile(r"\x1b\[([0-9;?]*)([A-Za-z])")
OSC_RE = re.compile(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")
ESC_OTHER_RE = re.compile(r"\x1b[^\[\]]")


class CursorTracker:
    def __init__(self, cols: int, rows: int):
        self.cols = max(20, cols)
        self.rows = max(10, rows)
        self.x = 0
        self.y = 0
        self.in_cmd = False
        self.cmd_x0 = 0
        self.cmd_y0 = 0
        self.cmd_x1 = 0
        self.cmd_y1 = 0

    def on_input(self, data: str):
        """Update active multi-line command bounding box from real keyboard input."""
        if not self.in_cmd:
            self.in_cmd = True
            self.cmd_x0 = 0
            self.cmd_y0 = self.y
            self.cmd_x1 = self.x
            self.cmd_y1 = self.y
        # Enter without backslash continuation finishes the typed command shortly after
        if "\r" in data or "\n" in data:
            self.cmd_y1 = max(self.cmd_y1, self.y)
            self.cmd_x1 = max(self.cmd_x1, self.x)

    def reset_cmd_box(self):
        self.in_cmd = False
        self.cmd_x0 = 0
        self.cmd_y0 = self.y
        self.cmd_x1 = self.x
        self.cmd_y1 = self.y

    def _newline(self):
        if self.y + 1 >= self.rows:
            # Terminal scrolled up by 1 line -> shift tracked command top up too
            if self.in_cmd:
                self.cmd_y0 = max(0, self.cmd_y0 - 1)
                self.cmd_y1 = max(0, self.cmd_y1 - 1)
            self.y = self.rows - 1
        else:
            self.y += 1

    def feed(self, text: str) -> int:
        """Advance virtual cursor and return max column touched in this chunk."""
        text = OSC_RE.sub("", text)
        max_col = self.x
        pos = 0
        n = len(text)
        newlines = 0
        while pos < n:
            ch = text[pos]
            if ch == "\x1b":
                m = CSI_RE.match(text, pos)
                if m:
                    params_str, cmd = m.group(1), m.group(2)
                    nums = [int(p) for p in params_str.lstrip("?").split(";") if p.isdigit()]
                    p1 = nums[0] if nums else 1
                    p2 = nums[1] if len(nums) > 1 else 1
                    if cmd in ("H", "f"):
                        self.y = max(0, min(self.rows - 1, p1 - 1))
                        self.x = max(0, min(self.cols - 1, p2 - 1))
                    elif cmd == "A":
                        self.y = max(0, self.y - p1)
                    elif cmd == "B":
                        self.y = min(self.rows - 1, self.y + p1)
                    elif cmd == "C":
                        self.x = min(self.cols - 1, self.x + p1)
                    elif cmd == "D":
                        self.x = max(0, self.x - p1)
                    elif cmd == "G":
                        self.x = max(0, min(self.cols - 1, p1 - 1))
                    elif cmd == "J" and (nums and nums[0] in (2, 3)):
                        self.x = 0
                        self.y = 0
                        self.reset_cmd_box()
                    pos = m.end()
                    continue
                pos += 2
                continue
            elif ch == "\r":
                self.x = 0
            elif ch == "\n":
                self._newline()
                newlines += 1
            elif ch == "\b":
                self.x = max(0, self.x - 1)
            elif ch == "\t":
                self.x = min(self.cols - 1, ((self.x // 8) + 1) * 8)
            elif ord(ch) >= 32:
                self.x += 1
                if self.x >= self.cols:
                    # Line wrapped while typing or printing
                    if self.in_cmd:
                        self.cmd_x1 = self.cols - 1
                    self.x = 0
                    self._newline()
                if self.x > max_col:
                    max_col = self.x
                if self.in_cmd:
                    self.cmd_x1 = max(self.cmd_x1, self.x)
                    self.cmd_y0 = min(self.cmd_y0, self.y)
                    self.cmd_y1 = max(self.cmd_y1, self.y)
            pos += 1
        # Large multi-line command output burst resets the previous typed command box
        if newlines >= 3 and len(text) > 120:
            self.reset_cmd_box()
        return max_col

    def cmd_box_norm(self) -> tuple[float, float, float, float]:
        if not self.in_cmd:
            nx = self.x / max(1, self.cols - 1)
            ny = self.y / max(1, self.rows - 1)
            return (0.0, ny, nx, ny)
        return (
            round(self.cmd_x0 / max(1, self.cols - 1), 4),
            round(self.cmd_y0 / max(1, self.rows - 1), 4),
            round(max(self.cmd_x1, self.x) / max(1, self.cols - 1), 4),
            round(max(self.cmd_y1, self.y) / max(1, self.rows - 1), 4),
        )


header = {}
events = []
cursor_track = []  # [adj_t, nx, ny, span_frac, is_input, bx0, by0, bx1, by1]
raw_prev = 0.0
adj_t = 0.0
has_stdin_events = False
output_sample = []

out_f = open(render_cast_path, "w", encoding="utf-8") if do_redact else None
try:
    with open(cast_path, "r", encoding="utf-8", errors="replace") as f:
        first = f.readline()
        if not first.strip():
            sys.exit(0)
        header = json.loads(first)
        if out_f:
            out_f.write(first)
        cols = int(header.get("width") or 100)
        rows = int(header.get("height") or 30)
        tracker = CursorTracker(cols, rows)

        for line in f:
            stripped = line.strip()
            if not stripped:
                continue
            try:
                ev = json.loads(stripped)
            except Exception:
                continue
            if not isinstance(ev, list) or len(ev) < 3:
                continue
            t = float(ev[0])
            etype = ev[1]
            data = ev[2] if isinstance(ev[2], str) else ""
            if do_redact and data:
                data = redact_text(data)
            if out_f:
                out_f.write(json.dumps([t, etype, data]) + "\n")
            dt = max(0.0, t - raw_prev)
            raw_prev = t
            if idle_limit > 0 and dt > idle_limit:
                dt = idle_limit
            adj_t += dt / speed
            if etype == "i":
                has_stdin_events = True
                tracker.on_input(data)
                bx0, by0, bx1, by1 = tracker.cmd_box_norm()
                cursor_track.append([
                    round(adj_t, 3),
                    round(tracker.x / max(1, cols - 1), 4),
                    round(tracker.y / max(1, rows - 1), 4),
                    0.0,
                    1,
                    bx0, by0, bx1, by1,
                ])
            elif etype == "o":
                if len(output_sample) < 60:
                    output_sample.append(data)
                max_col = tracker.feed(data)
                bx0, by0, bx1, by1 = tracker.cmd_box_norm()
                cursor_track.append([
                    round(adj_t, 3),
                    round(tracker.x / max(1, cols - 1), 4),
                    round(tracker.y / max(1, rows - 1), 4),
                    round(max_col / max(1, cols), 4),
                    0,
                    bx0, by0, bx1, by1,
                ])
            events.append((t, adj_t, etype, len(data)))
except Exception:
    sys.exit(0)
finally:
    if out_f:
        out_f.close()

if not events:
    sys.exit(0)

# Save cursor track JSON for Reels auto-reframe camera
track_path = os.path.join(work_dir, "cursor_track.json")
with open(track_path, "w", encoding="utf-8") as tf:
    json.dump({"cols": header.get("width", 100), "rows": header.get("height", 30), "track": cursor_track}, tf)

total_adj = events[-1][1]
start_epoch = float(header.get("timestamp") or os.path.getmtime(cast_path))
stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime(start_epoch))

meta_cmds = []
meta_marks = []
custom_name = ""
if os.path.isfile(meta_path):
    try:
        with open(meta_path, "r", encoding="utf-8", errors="replace") as mf:
            for line in mf:
                line = line.rstrip("\n")
                parts = line.split("\t")
                if len(parts) < 2:
                    continue
                if parts[0] == "NAME":
                    custom_name = sanitize(parts[1])
                    continue
                if parts[0] == "MARK" and len(parts) >= 3:
                    try:
                        mts = float(parts[1])
                        meta_marks.append((max(0.0, mts - start_epoch), parts[2].strip()))
                    except ValueError:
                        pass
                    continue
                try:
                    ts = float(parts[0])
                except ValueError:
                    continue
                rel_t = max(0.0, ts - start_epoch)
                tool, is_skip, is_trivial = extract_tool(parts[1])
                if tool:
                    meta_cmds.append((rel_t, tool, is_skip, is_trivial))
    except Exception:
        pass


def raw_to_adj(raw_sec: float) -> float:
    best = 0.0
    for rt, at, _, _ in events:
        if rt <= raw_sec:
            best = at
        else:
            break
    return best


adj_cmds = [(raw_to_adj(rt), tool, is_skip, is_trivial) for (rt, tool, is_skip, is_trivial) in meta_cmds]
adj_marks = [(raw_to_adj(rt), label) for (rt, label) in meta_marks if label]

sample_text = "".join(output_sample)
looks_like_ovpn = ("Initialization Sequence Completed" in sample_text or ("OpenVPN" in sample_text and "TUN/TAP" in sample_text))

if auto_mode:
    non_trivial_cmds = [c for c in adj_cmds if not c[3]]
    if non_trivial_cmds and all(c[2] for c in non_trivial_cmds):
        sys.exit(0)
    if not adj_cmds and looks_like_ovpn:
        sys.exit(0)

    total_in = sum(1 for _, _, et, _ in events if et == "i")
    total_out = sum(1 for _, _, et, _ in events if et == "o")
    if has_stdin_events:
        if total_in < 3 or total_out < 5:
            sys.exit(0)
    else:
        if not adj_cmds or total_out < 10:
            sys.exit(0)
    if total_adj < 1.0:
        sys.exit(0)


def pick_tool_for_window(w_start: float, w_end: float) -> tuple[str, bool]:
    if custom_name:
        return (custom_name, False)
    in_win = [c for c in adj_cmds if w_start <= c[0] <= w_end]
    for _, tool, is_skip, is_trivial in in_win:
        if not is_trivial and not is_skip:
            return (tool, False)
    if in_win and all(c[2] or c[3] for c in in_win) and any(c[2] for c in in_win):
        return ("", True)
    prior = [c for c in adj_cmds if c[0] < w_start and not c[3]]
    if prior:
        last_cmd = prior[-1]
        if last_cmd[2]:
            return ("", True)
        return (last_cmd[1], False)
    if in_win:
        return (in_win[0][1], False)
    if adj_cmds:
        return (adj_cmds[0][1], False)
    return ("terminal", False)


num_chunks = max(1, int((total_adj + max_secs - 0.001) // max_secs))
if total_adj <= max_secs:
    num_chunks = 1

chunks = []
for idx in range(num_chunks):
    c_start = idx * max_secs
    c_end = min(total_adj, (idx + 1) * max_secs)
    if c_end - c_start < 1.5 and idx > 0:
        continue

    win_events = [e for e in events if c_start <= e[1] <= c_end]
    win_in = sum(1 for _, _, et, _ in win_events if et == "i")
    win_out = sum(1 for _, _, et, _ in win_events if et == "o")

    if auto_mode:
        if win_out < 4:
            continue
        win_has_cmd = any(c_start <= c[0] <= c_end for c in adj_cmds)
        if has_stdin_events and win_in == 0 and not win_has_cmd and idx > 0:
            continue

    tool, skip_win = pick_tool_for_window(c_start, c_end)
    if auto_mode and skip_win:
        continue

    chunks.append((c_start, c_end, tool or "terminal"))


def fmt_chapter_ts(sec: float) -> str:
    s = max(0, int(sec))
    m, s = divmod(s, 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


for i, (s, e, tool) in enumerate(chunks, 1):
    is_multi = 1 if len(chunks) > 1 else 0
    chunk_marks = [(mt - s, lbl) for (mt, lbl) in adj_marks if s <= mt <= e]
    chap_file = ""
    if chunk_marks:
        chap_file = os.path.join(work_dir, f"chapters_{i}.txt")
        with open(chap_file, "w", encoding="utf-8") as cf:
            cf.write(f"00:00 {tool}\n")
            for rel_sec, lbl in chunk_marks:
                cf.write(f"{fmt_chapter_ts(rel_sec)} {lbl}\n")
    print(f"{s:.2f}\t{e:.2f}\t{tool}\t{stamp}\t{i}\t{is_multi}\t{chap_file}")
PYEOF
)"

if [[ -z "$PLAN" ]]; then
  if [[ "$CLEANUP" -eq 1 ]]; then
    rm -f "$INPUT" "$META_FILE"
  fi
  exit 0
fi

# Render a smooth 9:16 TikTok/Reels cursor-following auto-reframe MP4 (zero hard cropping!)
render_reels_follow() {
  local gif_path="$1" out_mp4="$2" tool="$3" slice_start="$4" rw="$5" rh="$6" rcrf="$7"
  python3 - "$gif_path" "$WORK_DIR/cursor_track.json" "$out_mp4" "$tool" "$slice_start" "$rw" "$rh" "$rcrf" "$BG_HEX" "$CANVAS_TOP" "$CANVAS_BOT" "$ACCENT_HEX" "$FG_HEX" <<'PYEOF'
import json
import math
import subprocess
import sys
from PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageSequence

gif_path = sys.argv[1]
track_path = sys.argv[2]
out_mp4 = sys.argv[3]
tool = sys.argv[4]
slice_start = float(sys.argv[5])
W, H = int(sys.argv[6]), int(sys.argv[7])
crf = sys.argv[8]
bg_hex, top_hex, bot_hex, acc_hex, fg_hex = sys.argv[9:14]

def h2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

bg_c, top_c, bot_c, acc_c, fg_c = map(h2rgb, (bg_hex, top_hex, bot_hex, acc_hex, fg_hex))

with open(track_path, "r", encoding="utf-8") as f:
    track_data = json.load(f)
track = track_data.get("track", [])

# Decode GIF frames & cumulative timestamps
gif = Image.open(gif_path)
raw_frames = []
cur_t = 0.0
for frame in ImageSequence.Iterator(gif):
    dur = max(0.02, (frame.info.get("duration", 40) or 40) / 1000.0)
    raw_frames.append((cur_t, dur, frame.convert("RGB")))
    cur_t += dur
total_dur = max(0.1, cur_t)

if not raw_frames:
    sys.exit(1)

TW, TH = raw_frames[0][2].size

# Build sleek 9:16 backdrop with top "> tool ●" header & rounded terminal viewport mask
base = Image.new("RGBA", (W, H))
grad = Image.new("RGBA", (1, H))
gd = ImageDraw.Draw(grad)
for y in range(H):
    u = y / max(1, H - 1)
    gd.point((0, y), fill=(
        int(top_c[0] + (bot_c[0] - top_c[0]) * u),
        int(top_c[1] + (bot_c[1] - top_c[1]) * u),
        int(top_c[2] + (bot_c[2] - top_c[2]) * u),
        255,
    ))
base.paste(grad.resize((W, H), Image.Resampling.BILINEAR), (0, 0))

margin_x = int(W * 0.04)
top_safe = int(H * 0.085)
bot_safe = int(H * 0.085)
title_h = int(H * 0.032)
VW = W - margin_x * 2
VH = H - top_safe - bot_safe - title_h
VX = margin_x
VY = top_safe + title_h
radius = max(18, W // 48)

# Soft drop shadow behind card
shadow = Image.new("RGBA", (W, H), (0, 0, 0, 0))
sd = ImageDraw.Draw(shadow)
sd.rounded_rectangle([VX, top_safe + 10, VX + VW, VY + VH + 10], radius=radius, fill=(0, 0, 0, 150))
shadow = shadow.filter(ImageFilter.GaussianBlur(radius=max(16, W // 50)))
base = Image.alpha_composite(base, shadow)

# Card shell + clean minimal titlebar (no text label clutter)
card = Image.new("RGBA", (W, H), (0, 0, 0, 0))
cd = ImageDraw.Draw(card)
bw = max(2, W // 540)
cd.rounded_rectangle([VX, top_safe, VX + VW, VY + VH], radius=radius, fill=bg_c + (255,), outline=acc_c + (145,), width=bw)
cd.line([VX + bw, VY, VX + VW - bw, VY], fill=acc_c + (45,), width=max(1, bw // 2))

dot_r = max(6, title_h // 6)
dot_cy = top_safe + title_h // 2
dot_x0 = VX + int(title_h * 0.55)
for idx, col in enumerate(((247, 118, 142, 255), (224, 175, 104, 255), (158, 206, 106, 255))):
    cx = dot_x0 + idx * int(dot_r * 3.1)
    cd.ellipse([cx - dot_r, dot_cy - dot_r, cx + dot_r, dot_cy + dot_r], fill=col)

base_rgb = Image.alpha_composite(base, card).convert("RGB")

# Inner viewport fits strictly inside the rounded card's border
IVW = VW - bw * 2
IVH = VH - bw * 2

# Calm, subtle camera physics (zero jarring zoom pumping, subpixel-smooth affine pan/zoom):
# - fit_scale fits 100% of terminal width with zero cropping.
# - follow_scale applies a gentle 1.28x zoom while actively typing, held steadily with hysteresis.
# - 2nd-order critically damped springs guarantee gentle ease-in and ease-out (zero sudden snaps).
fit_scale = min(IVW / max(1, TW), IVH / max(1, TH))
follow_scale = min(fit_scale * 1.28, (IVH * 0.94) / max(1, TH) * 1.20)
if follow_scale < fit_scale:
    follow_scale = fit_scale

fps = 30
dt = 1.0 / fps
n_out_frames = max(1, int(math.ceil(total_dur * fps)))

# Critically damped spring state (position + velocity) in source-terminal pixel space
cam_x = TW * 0.5
cam_vx = 0.0
cam_y = TH * 0.35
cam_vy = 0.0
cam_scale = fit_scale
cam_vs = 0.0

# Smoothed target anchor (prevents micro-jitter) + zoom hysteresis (prevents pumping)
anchor_x = cam_x
anchor_y = cam_y
zoom_mode = "fit"  # "fit" or "follow"
last_zoom_switch_t = -10.0
MIN_ZOOM_HOLD = 2.2  # seconds before allowing a zoom state change

def step_spring(pos: float, vel: float, target: float, omega: float, step_dt: float) -> tuple[float, float]:
    """Exact critically-damped harmonic spring step (smooth ease-in, zero overshoot)."""
    diff = pos - target
    exp_term = math.exp(-omega * step_dt)
    new_pos = target + (diff + (vel + omega * diff) * step_dt) * exp_term
    new_vel = (vel - (vel + omega * diff) * omega * step_dt) * exp_term
    return new_pos, new_vel

track_idx = 0
last_input_t = -99.0
recent_wide_t = -99.0
cur_nx, cur_ny = 0.35, 0.25
cur_bx0, cur_by0, cur_bx1, cur_by1 = 0.0, 0.15, 0.45, 0.30

def sample_cursor(abs_t: float):
    global track_idx, last_input_t, recent_wide_t, cur_nx, cur_ny
    global cur_bx0, cur_by0, cur_bx1, cur_by1
    while track_idx < len(track) and track[track_idx][0] <= abs_t:
        ev = track[track_idx]
        ev_t, nx, ny, span, is_in = ev[0], ev[1], ev[2], ev[3], ev[4]
        cur_nx, cur_ny = nx, ny
        if len(ev) >= 9:
            cur_bx0, cur_by0, cur_bx1, cur_by1 = ev[5], ev[6], ev[7], ev[8]
        if is_in:
            last_input_t = ev_t
        elif span >= 0.62:
            recent_wide_t = ev_t
        track_idx += 1
    typing_active = (abs_t - last_input_t) <= 1.6
    wide_burst = (abs_t - recent_wide_t) <= 2.0 and not typing_active
    return cur_nx, cur_ny, typing_active, wide_burst, (cur_bx0, cur_by0, cur_bx1, cur_by1)

# Universal playback profile (main@4.1 for 1080p, high@5.1 for 4K) + silent AAC track
v_profile = "high" if (W > 1920 or H > 1920) else "main"
v_level = "5.1" if (W > 1920 or H > 1920) else "4.1"

cmd = [
    "ffmpeg", "-y", "-loglevel", "error",
    "-f", "rawvideo", "-vcodec", "rawvideo",
    "-pix_fmt", "rgb24", "-s", f"{W}x{H}", "-r", str(fps),
    "-i", "pipe:0",
    "-f", "lavfi", "-i", "anullsrc=channel_layout=stereo:sample_rate=44100",
    "-map", "0:v:0", "-map", "1:a:0",
    "-shortest",
    "-movflags", "+faststart",
    "-brand", "mp42",
    "-pix_fmt", "yuv420p",
    "-c:v", "libx264", "-profile:v", v_profile, "-level:v", v_level,
    "-g", str(fps * 2), "-keyint_min", str(fps), "-sc_threshold", "0",
    "-colorspace", "bt709", "-color_primaries", "bt709", "-color_trc", "bt709", "-color_range", "tv",
    "-crf", str(crf), "-preset", "medium",
    "-c:a", "aac", "-b:a", "32k",
    out_mp4,
]
proc = subprocess.Popen(cmd, stdin=subprocess.PIPE)

gif_idx = 0
try:
    for f_i in range(n_out_frames):
        t = f_i * dt
        while gif_idx + 1 < len(raw_frames) and raw_frames[gif_idx + 1][0] <= t:
            gif_idx += 1
        src_img = raw_frames[gif_idx][2]

        nx, ny, typing_active, wide_burst, (bx0, by0, bx1, by1) = sample_cursor(slice_start + t)
        raw_x = nx * TW
        raw_y = ny * TH

        # Compute exact bounding box of the ENTIRE active multi-line command (with padding)
        pad_x_src = TW * 0.08
        pad_y_src = TH * 0.10
        cmd_left = max(0.0, bx0 * TW - pad_x_src * 0.5)
        cmd_right = min(float(TW), max(bx1, nx) * TW + pad_x_src)
        cmd_top = max(0.0, by0 * TH - pad_y_src)
        cmd_bot = min(float(TH), max(by1, ny) * TH + pad_y_src)
        cmd_w = max(TW * 0.25, cmd_right - cmd_left)
        cmd_h = max(TH * 0.18, cmd_bot - cmd_top)

        # Max zoom that guarantees 100% of the full command (any number of lines!) stays visible
        cmd_fit_scale = min(IVW / cmd_w, IVH / cmd_h)

        # Hysteresis on zoom state so camera never pumps in/out rapidly
        desired_mode = zoom_mode
        if wide_burst:
            desired_mode = "fit"
        elif typing_active:
            desired_mode = "follow"
        else:
            desired_mode = "fit"

        if desired_mode != zoom_mode and (t - last_zoom_switch_t) >= MIN_ZOOM_HOLD:
            zoom_mode = desired_mode
            last_zoom_switch_t = t

        if zoom_mode == "follow":
            # Never zoom closer than cmd_fit_scale so multi-line / long commands are NEVER cut off!
            tgt_scale = max(fit_scale, min(follow_scale, cmd_fit_scale))
            # Center on the full command box (blended gently toward cursor when command is short)
            box_cx = (cmd_left + cmd_right) * 0.5
            box_cy = (cmd_top + cmd_bot) * 0.5
            tgt_x = box_cx
            tgt_y = box_cy
        else:
            tgt_scale = fit_scale
            tgt_x = TW * 0.5
            tgt_y = raw_y

        # Generous deadzone so individual keystrokes stay rock-steady
        view_w_src = IVW / max(0.05, cam_scale)
        view_h_src = IVH / max(0.05, cam_scale)
        if zoom_mode == "fit" or abs(tgt_x - anchor_x) > view_w_src * 0.18:
            anchor_x = tgt_x
        if abs(tgt_y - anchor_y) > view_h_src * 0.16:
            anchor_y = tgt_y

        # Smooth critically damped springs (gentle pan omega=2.6, calm zoom omega=1.6)
        cam_scale, cam_vs = step_spring(cam_scale, cam_vs, tgt_scale, 1.6, dt)
        cam_x, cam_vx = step_spring(cam_x, cam_vx, anchor_x, 2.6, dt)
        cam_y, cam_vy = step_spring(cam_y, cam_vy, anchor_y, 2.4, dt)

        # Subpixel-accurate floating-point AFFINE transform (eliminates 1px pan/zoom jitter!)
        inv_s = 1.0 / max(0.05, cam_scale)
        vis_w = IVW * inv_s
        vis_h = IVH * inv_s

        if vis_w >= TW:
            src_x0 = (TW - vis_w) * 0.5
        else:
            src_x0 = max(0.0, min(TW - vis_w, cam_x - vis_w * 0.5))

        if vis_h >= TH:
            src_y0 = (TH - vis_h) * 0.5
        else:
            src_y0 = max(0.0, min(TH - vis_h, cam_y - vis_h * 0.5))

        viewport = src_img.transform(
            (IVW, IVH),
            Image.Transform.AFFINE,
            (inv_s, 0.0, src_x0, 0.0, inv_s, src_y0),
            resample=Image.Resampling.BICUBIC,
            fillcolor=bg_c,
        )

        frame_out = base_rgb.copy()
        frame_out.paste(viewport, (VX + bw, VY + bw))
        proc.stdin.write(frame_out.tobytes())
finally:
    if proc.stdin:
        proc.stdin.close()
    rc = proc.wait()
    if rc != 0:
        sys.exit(rc)
PYEOF
}

# Helper: generate crisp rounded macOS-style window frame backdrop PNG via PIL (if installed)
make_frame_png() {
  local out_png="$1" title="$2"
  python3 - "$out_png" "$OUT_W" "$OUT_H" "$INNER_W" "$INNER_H" "$TITLE_H" "$BG_HEX" "$CANVAS_TOP" "$CANVAS_BOT" "$ACCENT_HEX" "$FG_HEX" "$title" <<'PYEOF' 2>/dev/null || return 1
import sys
from PIL import Image, ImageDraw, ImageFilter, ImageFont

out_png = sys.argv[1]
W, H = int(sys.argv[2]), int(sys.argv[3])
IW, IH, TH = int(sys.argv[4]), int(sys.argv[5]), int(sys.argv[6])
bg_hex, top_hex, bot_hex, acc_hex, fg_hex = sys.argv[7:12]
title = sys.argv[12]

def h2rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i+2], 16) for i in (0, 2, 4))

top_c, bot_c, bg_c, acc_c, fg_c = map(h2rgb, (top_hex, bot_hex, bg_hex, acc_hex, fg_hex))

img = Image.new("RGBA", (W, H))
grad = Image.new("RGBA", (1, H))
gd = ImageDraw.Draw(grad)
for y in range(H):
    t = y / max(1, H - 1)
    gd.point((0, y), fill=(
        int(top_c[0] + (bot_c[0] - top_c[0]) * t),
        int(top_c[1] + (bot_c[1] - top_c[1]) * t),
        int(top_c[2] + (bot_c[2] - top_c[2]) * t),
        255,
    ))
img.paste(grad.resize((W, H), Image.Resampling.BILINEAR), (0, 0))

pad_x = max(16, W // 120)
pad_y = max(14, H // 100)
win_w = IW + pad_x * 2
win_h = IH + TH + pad_y * 2
wx = (W - win_w) // 2
wy = (H - win_h) // 2
radius = max(14, W // 140)

shadow = Image.new("RGBA", (W, H), (0, 0, 0, 0))
sd = ImageDraw.Draw(shadow)
sh_off = max(8, H // 140)
sd.rounded_rectangle([wx, wy + sh_off, wx + win_w, wy + win_h + sh_off], radius=radius, fill=(0, 0, 0, 145))
shadow = shadow.filter(ImageFilter.GaussianBlur(radius=max(14, W // 90)))
img = Image.alpha_composite(img, shadow)

card = Image.new("RGBA", (W, H), (0, 0, 0, 0))
cd = ImageDraw.Draw(card)
border_w = max(2, W // 1200)
cd.rounded_rectangle(
    [wx, wy, wx + win_w, wy + win_h],
    radius=radius,
    fill=bg_c + (255,),
    outline=acc_c + (155,),
    width=border_w,
)

sep_y = wy + TH
cd.line([wx + border_w, sep_y, wx + win_w - border_w, sep_y], fill=acc_c + (45,), width=max(1, border_w // 2))

dot_r = max(5, TH // 6)
dot_cy = wy + TH // 2
dot_x0 = wx + max(20, TH // 2)
dot_gap = int(dot_r * 3.1)
for idx, col in enumerate(((247, 118, 142, 255), (224, 175, 104, 255), (158, 206, 106, 255))):
    cx = dot_x0 + idx * dot_gap
    cd.ellipse([cx - dot_r, dot_cy - dot_r, cx + dot_r, dot_cy + dot_r], fill=col)

img = Image.alpha_composite(img, card).convert("RGB")
img.save(out_png, "PNG")
PYEOF
}

ALL_OK=1

while IFS=$'\t' read -r START END TOOL STAMP PART IS_MULTI CHAP_FILE; do
  [[ -z "$START" ]] && continue

  if [[ -n "$EXPLICIT_OUT" ]]; then
    if [[ "$IS_MULTI" -eq 1 ]]; then
      OUTPUT="${EXPLICIT_OUT%.mp4}_part${PART}.mp4"
    else
      OUTPUT="$EXPLICIT_OUT"
    fi
  else
    if [[ "$IS_MULTI" -eq 1 ]]; then
      OUTPUT="${OUT_DIR}/${TOOL}_${STAMP}_part${PART}.mp4"
    else
      OUTPUT="${OUT_DIR}/${TOOL}_${STAMP}.mp4"
    fi
    if [[ -e "$OUTPUT" ]]; then
      OUTPUT="${OUTPUT%.mp4}_$$_${PART}.mp4"
    fi
  fi

  mkdir -p "$(dirname "$OUTPUT")"
  TMP_GIF="$WORK_DIR/part_${PART}.gif"
  TMP_MP4="${OUTPUT}.tmp.$$.mp4"

  AGG_ARGS=(
    --quiet
    --theme "$AGG_THEME"
    --text-font-family "JetBrainsMono Nerd Font,JetBrains Mono,Fira Code,DejaVu Sans Mono,Liberation Mono"
    --font-size "$FONT_SIZE"
    --speed "$SPEED"
    --fps-cap 60
    --idle-time-limit "$IDLE_LIMIT"
  )
  if [[ "$IS_MULTI" -eq 1 ]]; then
    AGG_ARGS+=(--select "${START}..${END}")
  fi

  if ! agg "${AGG_ARGS[@]}" "$RENDER_CAST" "$TMP_GIF"; then
    rm -f "$TMP_GIF"
    ALL_OK=0
    continue
  fi

  if [[ "$IS_REELS" -eq 1 ]]; then
    if render_reels_follow "$TMP_GIF" "$TMP_MP4" "$TOOL" "$START" "$OUT_W" "$OUT_H" "$CRF"; then
      mv -f "$TMP_MP4" "$OUTPUT"
      [[ -n "$CHAP_FILE" && -f "$CHAP_FILE" ]] && cp -f "$CHAP_FILE" "${OUTPUT%.mp4}.chapters.txt"
    else
      rm -f "$TMP_MP4"
      ALL_OK=0
    fi
  else
    FRAME_PNG="$WORK_DIR/frame_${PART}.png"
    USE_FRAME=0
    if [[ "${FRAME_MODE,,}" != "off" && "${FRAME_MODE,,}" != "0" && "${FRAME_MODE,,}" != "false" ]]; then
      if make_frame_png "$FRAME_PNG" "$TOOL"; then
        USE_FRAME=1
      fi
    fi

    # Universal playback profile: main@4.1 for <=1080p, high@5.1 for 1440p/4K + strict 30fps CFR + silent AAC
    V_PROFILE="main"; V_LEVEL="4.1"
    if (( OUT_W > 1920 || OUT_H > 1920 )); then
      V_PROFILE="high"; V_LEVEL="5.1"
    fi

    if [[ "$USE_FRAME" -eq 1 ]]; then
      PAD_Y=$(( OUT_H / 100 ))
      (( PAD_Y < 14 )) && PAD_Y=14
      WIN_H=$(( INNER_H + TITLE_H + PAD_Y * 2 ))
      WY=$(( (OUT_H - WIN_H) / 2 ))
      TERM_Y=$(( WY + TITLE_H + PAD_Y ))

      if ffmpeg -y -loglevel error \
        -framerate 30 -loop 1 -i "$FRAME_PNG" \
        -i "$TMP_GIF" \
        -f lavfi -i anullsrc=channel_layout=stereo:sample_rate=44100 \
        -filter_complex "[1:v]fps=30,scale=${INNER_W}:${INNER_H}:force_original_aspect_ratio=decrease:flags=lanczos[term];[0:v][term]overlay=(W-w)/2:${TERM_Y}+(${INNER_H}-h)/2:shortest=1[out]" \
        -map "[out]" -map "2:a:0" \
        -shortest \
        -r 30 -fps_mode cfr \
        -movflags +faststart \
        -brand mp42 \
        -pix_fmt yuv420p \
        -c:v libx264 -profile:v "$V_PROFILE" -level:v "$V_LEVEL" \
        -g 60 -keyint_min 30 -sc_threshold 0 \
        -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv \
        -crf "$CRF" -preset medium \
        -c:a aac -b:a 32k \
        "$TMP_MP4"
      then
        mv -f "$TMP_MP4" "$OUTPUT"
        [[ -n "$CHAP_FILE" && -f "$CHAP_FILE" ]] && cp -f "$CHAP_FILE" "${OUTPUT%.mp4}.chapters.txt"
      else
        rm -f "$TMP_MP4"
        ALL_OK=0
      fi
    else
      if ffmpeg -y -loglevel error \
        -i "$TMP_GIF" \
        -f lavfi -i anullsrc=channel_layout=stereo:sample_rate=44100 \
        -map "0:v:0" -map "1:a:0" \
        -shortest \
        -r 30 -fps_mode cfr \
        -movflags +faststart \
        -brand mp42 \
        -pix_fmt yuv420p \
        -c:v libx264 -profile:v "$V_PROFILE" -level:v "$V_LEVEL" \
        -g 60 -keyint_min 30 -sc_threshold 0 \
        -colorspace bt709 -color_primaries bt709 -color_trc bt709 -color_range tv \
        -crf "$CRF" -preset medium \
        -c:a aac -b:a 32k \
        -vf "fps=30,scale=${INNER_W}:${INNER_H}:force_original_aspect_ratio=decrease:flags=lanczos,pad=${OUT_W}:${OUT_H}:(ow-iw)/2:(oh-ih)/2:color=${BG_HEX}" \
        "$TMP_MP4"
      then
        mv -f "$TMP_MP4" "$OUTPUT"
        [[ -n "$CHAP_FILE" && -f "$CHAP_FILE" ]] && cp -f "$CHAP_FILE" "${OUTPUT%.mp4}.chapters.txt"
      else
        rm -f "$TMP_MP4"
        ALL_OK=0
      fi
    fi
    rm -f "$FRAME_PNG"

    # Optional automatic companion 9:16 TikTok/Reels cursor-following export
    if [[ "${REELS_COPY,,}" == "on" || "${REELS_COPY,,}" == "1" || "${REELS_COPY,,}" == "true" ]]; then
      REELS_OUT="${OUTPUT%.mp4}_reels.mp4"
      TMP_REELS="${REELS_OUT}.tmp.$$.mp4"
      if render_reels_follow "$TMP_GIF" "$TMP_REELS" "$TOOL" "$START" 1080 1920 18; then
        mv -f "$TMP_REELS" "$REELS_OUT"
      else
        rm -f "$TMP_REELS"
      fi
    fi
  fi

  rm -f "$TMP_GIF"
done <<< "$PLAN"

if [[ "$CLEANUP" -eq 1 && "$ALL_OK" -eq 1 ]]; then
  rm -f "$INPUT" "$META_FILE"
fi
