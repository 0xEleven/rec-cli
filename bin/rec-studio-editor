        self.img_btn = QPushButton("Wallpaper Image...")
        self.img_btn.clicked.connect(self._pick_bg_image)
        color_row.addWidget(self.c1_btn)
        color_row.addWidget(self.c2_btn)
        color_row.addWidget(self.img_btn)
        lay.addLayout(color_row)

        self.bg_blur_sld, _ = self._slider_row(lay, "Background Blur", 0, 40, 0, "px", lambda v: self._mut_bg("blur", v))

        lay.addWidget(self._sec_lbl("Frame & Style"))
        self.pad_sld, _ = self._slider_row(lay, "Padding", 0, 22, 7, "%", lambda v: self._mut_frame("padding", v))
        self.rad_sld, _ = self._slider_row(lay, "Corner Radius", 0, 44, 18, "px", lambda v: self._mut_frame("radius", v))
        self.shd_sld, _ = self._slider_row(lay, "Drop Shadow", 0, 100, 65, "%", lambda v: self._mut_frame("shadow", v))

        ch_row = QHBoxLayout()
        ch_lbl = QLabel("Window Chrome")
        ch_lbl.setObjectName("muted")
        self.chrome_combo = QComboBox()
        for val, lbl in (("none", "None"), ("macos", "macOS Dots"), ("minimal", "Minimal Border")):
            self.chrome_combo.addItem(lbl, val)
        self.chrome_combo.currentIndexChanged.connect(
            lambda: (not self._syncing_ui) and self._mut_frame("chrome", self.chrome_combo.currentData())
        )
        ch_row.addWidget(ch_lbl)
        ch_row.addWidget(self.chrome_combo, 1)
        lay.addLayout(ch_row)

        lay.addWidget(self._sec_lbl("Crop"))
        self.ct_sld, _ = self._slider_row(lay, "Top", 0, 35, 0, "%", lambda v: self._mut_frame("crop_top", v))
        self.cb_sld, _ = self._slider_row(lay, "Bottom", 0, 35, 0, "%", lambda v: self._mut_frame("crop_bottom", v))
        self.cl_sld, _ = self._slider_row(lay, "Left", 0, 35, 0, "%", lambda v: self._mut_frame("crop_left", v))
        self.cr_sld, _ = self._slider_row(lay, "Right", 0, 35, 0, "%", lambda v: self._mut_frame("crop_right", v))

        lay.addStretch()
        return self._scroll_wrap(inner)

    # ---------------- Inspector Tab 1: Motion, Cursor, Webcam & Audio ----------------
    def _build_motion_tab(self) -> QWidget:
        inner = QWidget()
        lay = QVBoxLayout(inner)
        lay.setContentsMargins(2, 4, 6, 8)
        lay.setSpacing(10)

        lay.addWidget(self._sec_lbl("Smart Motion"))
        sp_row = QHBoxLayout()
        l_sp = QLabel("Zoom Spring")
        l_sp.setObjectName("muted")
        self.spring_combo = QComboBox()
        for val, lbl in (("smooth", "Smooth"), ("snappy", "Snappy"), ("cinematic", "Cinematic")):
            self.spring_combo.addItem(lbl, val)
        self.spring_combo.currentIndexChanged.connect(
            lambda: (not self._syncing_ui) and self._mut_nested("motion", "spring", self.spring_combo.currentData())
        )
        sp_row.addWidget(l_sp)
        sp_row.addWidget(self.spring_combo, 1)
        lay.addLayout(sp_row)

        self.mblur_sld, _ = self._slider_row(lay, "Motion Blur", 0, 100, 20, "%", lambda v: self._mut_nested("motion", "motion_blur", v))

        lay.addWidget(self._sec_lbl("Cursor Polish"))
        self.sw_cur_en = self._toggle_row(lay, "Show Vector Cursor", False, lambda v: self._mut_nested("cursor", "enabled", v))
        self.sw_cur_bounce = self._toggle_row(lay, "Click Bounce & Ripple", True, lambda v: self._mut_nested("cursor", "click_bounce", v))
        self.sw_cur_idle = self._toggle_row(lay, "Auto-hide Idle Cursor", True, lambda v: self._mut_nested("cursor", "hide_idle", v))

        cs_row = QHBoxLayout()
        l_cs = QLabel("Cursor Style")
        l_cs.setObjectName("muted")
        self.cur_style_combo = QComboBox()
        for val, lbl in (("macos", "macOS Pointer"), ("ring", "Highlight Ring"), ("dot", "Minimal Dot")):
            self.cur_style_combo.addItem(lbl, val)
        self.cur_style_combo.currentIndexChanged.connect(
            lambda: (not self._syncing_ui) and self._mut_nested("cursor", "style", self.cur_style_combo.currentData())
        )
        cs_row.addWidget(l_cs)
        cs_row.addWidget(self.cur_style_combo, 1)
        lay.addLayout(cs_row)

        self.cur_sz_sld, _ = self._slider_row(lay, "Cursor Size", 70, 250, 125, "%", lambda v: self._mut_nested("cursor", "size", v / 100.0))
        self.cur_sm_sld, _ = self._slider_row(lay, "Cursor Smoothing", 0, 100, 65, "%", lambda v: self._mut_nested("cursor", "smoothing", v))

        lay.addWidget(self._sec_lbl("Dynamic Webcam Bubble"))
        self.sw_wb_en = self._toggle_row(lay, "Show Webcam Bubble", False, lambda v: self._mut_nested("webcam", "enabled", v))
        wb_file_row = QHBoxLayout()
        self.wb_lbl = QLabel("No webcam video")
        self.wb_lbl.setObjectName("dim")
        b_wb = QPushButton("Choose...")
        b_wb.clicked.connect(self._pick_webcam_video)
        wb_file_row.addWidget(self.wb_lbl, 1)
        wb_file_row.addWidget(b_wb)
        lay.addLayout(wb_file_row)

        wc_row = QHBoxLayout()
        l_wc = QLabel("Corner")
        l_wc.setObjectName("muted")
        self.wb_corner_combo = QComboBox()
        for val, lbl in (("br", "Bottom Right"), ("bl", "Bottom Left"), ("tr", "Top Right"), ("tl", "Top Left")):
            self.wb_corner_combo.addItem(lbl, val)
        self.wb_corner_combo.currentIndexChanged.connect(
            lambda: (not self._syncing_ui) and self._mut_nested("webcam", "corner", self.wb_corner_combo.currentData())
        )
        wc_row.addWidget(l_wc)
        wc_row.addWidget(self.wb_corner_combo, 1)
        lay.addLayout(wc_row)

        self.wb_sz_sld, _ = self._slider_row(lay, "Bubble Size", 10, 35, 20, "%", lambda v: self._mut_nested("webcam", "size", v))
        self.wb_rnd_sld, _ = self._slider_row(lay, "Roundness", 0, 100, 100, "%", lambda v: self._mut_nested("webcam", "roundness", v))
        self.sw_wb_shd = self._toggle_row(lay, "Bubble Shadow", True, lambda v: self._mut_nested("webcam", "shadow", v))
        self.sw_wb_shrink = self._toggle_row(lay, "Auto-shrink on Zoom", True, lambda v: self._mut_nested("webcam", "shrink_on_zoom", v))

        lay.addWidget(self._sec_lbl("Audio Track"))
        au_row = QHBoxLayout()
        self.au_lbl = QLabel("No audio overlay")
        self.au_lbl.setObjectName("dim")
        b_au = QPushButton("Add Audio...")
        b_au.clicked.connect(self._pick_audio_overlay)
        b_au_clr = QPushButton("×")
        b_au_clr.setFixedWidth(28)
        b_au_clr.clicked.connect(self._clear_audio_overlay)
        au_row.addWidget(self.au_lbl, 1)
        au_row.addWidget(b_au)
        au_row.addWidget(b_au_clr)
        lay.addLayout(au_row)

        self.au_vol_sld, _ = self._slider_row(lay, "Overlay Volume", 0, 150, 75, "%", lambda v: self._mut_nested("audio", "overlay_volume", v / 100.0))
        self.sw_au_mute = self._toggle_row(lay, "Mute Source Audio", False, lambda v: self._mut_nested("audio", "mute_source", v))

        lay.addStretch()
        return self._scroll_wrap(inner)

    # ---------------- Inspector Tab 2: Selected Timeline Item ----------------
    def _build_item_tab(self) -> QWidget:
        inner = QWidget()
        self.item_lay = QVBoxLayout(inner)
        self.item_lay.setContentsMargins(2, 4, 6, 8)
        self.item_lay.setSpacing(10)
        self._rebuild_item_inspector()
        return self._scroll_wrap(inner)

    def _rebuild_item_inspector(self):
        while self.item_lay.count():
            it = self.item_lay.takeAt(0)
            w = it.widget()
            if w:
                w.hide()
                w.setParent(None)
                w.deleteLater()

        item = self._get_selected_item()
        if item is None:
            l = QLabel("Select a Zoom, Trim Cut, Speed, or Overlay block on the timeline to edit it.")
            l.setObjectName("muted")
            l.setWordWrap(True)
            self.item_lay.addWidget(l)
            self.item_lay.addStretch()
            self.del_btn.setEnabled(False)
            self.preview.set_reticle(None)
            return

        self.del_btn.setEnabled(True)
        tk = self.sel_track
        titles = {"zooms": "Zoom Region", "trims": "Trim Cut (Removed)", "speeds": "Speed Region", "annotations": "Overlay Annotation"}
        self.item_lay.addWidget(self._sec_lbl(titles.get(tk, "Item")))

        # Start / End spinboxes
        dur = max(0.5, float(self.proj.get("duration", 10.0)))
        se_grid = QGridLayout()
        s_spin = QDoubleSpinBox()
        s_spin.setRange(0.0, dur)
        s_spin.setSingleStep(0.1)
        s_spin.setSuffix(" s")
        s_spin.setValue(float(item.get("start", 0.0)))

        e_spin = QDoubleSpinBox()
        e_spin.setRange(0.1, dur)
        e_spin.setSingleStep(0.1)
        e_spin.setSuffix(" s")
        e_spin.setValue(float(item.get("end", 1.0)))

        def _on_start(v):
            item["start"] = round(min(v, float(item["end"]) - 0.1), 2)
            self.timeline.update()
            self._schedule_render()

        def _on_end(v):
            item["end"] = round(max(v, float(item["start"]) + 0.1), 2)
            self.timeline.update()
            self._schedule_render()

        s_spin.valueChanged.connect(_on_start)
        e_spin.valueChanged.connect(_on_end)
        se_grid.addWidget(QLabel("Start"), 0, 0)
        se_grid.addWidget(s_spin, 1, 0)
        se_grid.addWidget(QLabel("End"), 0, 1)
        se_grid.addWidget(e_spin, 1, 1)
        self.item_lay.addLayout(se_grid)

        if tk == "zooms":
            self._slider_row(
                self.item_lay, "Zoom Depth", 110, 350, int(float(item.get("depth", 1.75)) * 100), "%",
                lambda v: self._mut_item(item, "depth", round(v / 100.0, 2)),
            )
            self._slider_row(
                self.item_lay, "Focus X", 0, 100, int(float(item.get("x", 0.5)) * 100), "%",
                lambda v: self._mut_item_focus(item, "x", v / 100.0),
            )
            self._slider_row(
                self.item_lay, "Focus Y", 0, 100, int(float(item.get("y", 0.5)) * 100), "%",
                lambda v: self._mut_item_focus(item, "y", v / 100.0),
            )
            tip = QLabel("Tip: Click anywhere on the preview canvas to aim this zoom.")
            tip.setObjectName("dim")
            tip.setWordWrap(True)
            self.item_lay.addWidget(tip)
            self.preview.set_reticle((float(item.get("x", 0.5)), float(item.get("y", 0.5))), f"Zoom {float(item.get('depth', 1.75)):.1f}x")

        elif tk == "speeds":
            presets = QHBoxLayout()
            presets.setSpacing(4)
            for r in (0.5, 0.75, 1.5, 2.0, 3.0, 4.0):
                b = QPushButton(f"{r:g}x")
                b.clicked.connect(lambda _c=False, rate=r: (self._mut_item(item, "rate", rate), self._rebuild_item_inspector()))
                presets.addWidget(b)
            self.item_lay.addLayout(presets)
            self._slider_row(
                self.item_lay, "Speed Multiplier", 25, 400, int(float(item.get("rate", 2.0)) * 100), "%",
                lambda v: self._mut_item(item, "rate", round(v / 100.0, 2)),
            )
            self.preview.set_reticle(None)

        elif tk == "annotations":
            kind = item.get("kind", "text")
            if kind == "text":
                t_edit = QLineEdit(item.get("text", "Note"))
                t_edit.textChanged.connect(lambda txt: self._mut_item(item, "text", txt))
                self.item_lay.addWidget(QLabel("Label Text"))
                self.item_lay.addWidget(t_edit)
                self._slider_row(
                    self.item_lay, "Font Size", 16, 72, int(item.get("font_size", 32)), "px",
                    lambda v: self._mut_item(item, "font_size", v),
                )
            elif kind == "image":
                b_img = QPushButton("Choose Overlay Image...")
                b_img.clicked.connect(lambda: self._pick_ann_image(item))
                self.item_lay.addWidget(b_img)

            if kind in ("text", "box", "arrow"):
                cr = QHBoxLayout()
                bc = QPushButton("Accent / Text Color")
                bc.clicked.connect(lambda: self._pick_ann_color(item, "color"))
                cr.addWidget(bc)
                if kind == "text":
                    bb = QPushButton("Pill BG")
                    bb.clicked.connect(lambda: self._pick_ann_color(item, "bg"))
                    cr.addWidget(bb)
                self.item_lay.addLayout(cr)

            if kind != "text":
                self._slider_row(self.item_lay, "Width", 5, 80, int(float(item.get("w", 0.22)) * 100), "%", lambda v: self._mut_item(item, "w", v / 100.0))
                self._slider_row(self.item_lay, "Height", 5, 80, int(float(item.get("h", 0.12)) * 100), "%", lambda v: self._mut_item(item, "h", v / 100.0))

            tip = QLabel("Tip: Click anywhere on the preview canvas to position this overlay.")
            tip.setObjectName("dim")
            tip.setWordWrap(True)
            self.item_lay.addWidget(tip)
            self.preview.set_reticle((float(item.get("x", 0.5)), float(item.get("y", 0.25))), kind.title())
        else:
            self.preview.set_reticle(None)

        b_del = QPushButton("Delete Selected Item")
        b_del.setObjectName("dangerBtn")
        b_del.clicked.connect(self._delete_selected)
        self.item_lay.addWidget(b_del)
        self.item_lay.addStretch()

    # ---------------- Inspector Tab 3: Export ----------------
    def _build_export_tab(self) -> QWidget:
        inner = QWidget()
        lay = QVBoxLayout(inner)
        lay.setContentsMargins(2, 4, 6, 8)
        lay.setSpacing(10)

        lay.addWidget(self._sec_lbl("Export Settings"))

        self.exp_fmt = QComboBox()
        self.exp_fmt.addItem("MP4 Video (H.264 + AAC)", "mp4")
        self.exp_fmt.addItem("Animated GIF (Palette)", "gif")
        self.exp_fmt.currentIndexChanged.connect(lambda: self._mut_export("format", self.exp_fmt.currentData()))

        self.exp_res = QComboBox()
        for val, lbl in (("720p", "720p HD"), ("1080p", "1080p Full HD"), ("1440p", "1440p QHD"), ("4k", "4K UHD")):
            self.exp_res.addItem(lbl, val)
        self.exp_res.currentIndexChanged.connect(lambda: self._mut_export("resolution", self.exp_res.currentData()))

        self.exp_fps = QComboBox()
        self.exp_fps.addItem("30 fps", 30)
        self.exp_fps.addItem("60 fps", 60)
        self.exp_fps.currentIndexChanged.connect(lambda: self._mut_export("fps", self.exp_fps.currentData()))

        self.exp_qual = QComboBox()
        for val, lbl in (("high", "High Quality (CRF 17)"), ("balanced", "Balanced (CRF 20)"), ("compact", "Compact (CRF 24)")):
            self.exp_qual.addItem(lbl, val)
        self.exp_qual.currentIndexChanged.connect(lambda: self._mut_export("quality", self.exp_qual.currentData()))

        for lbl, w in (("Format", self.exp_fmt), ("Resolution", self.exp_res), ("Framerate", self.exp_fps), ("Quality", self.exp_qual)):
            tl = QLabel(lbl)
            tl.setObjectName("muted")
            lay.addWidget(tl)
            lay.addWidget(w)

        self.exp_summary = QLabel("1920 × 1080 · 00:10.0")
        self.exp_summary.setObjectName("monoTag")
        self.exp_summary.setAlignment(Qt.AlignmentFlag.AlignCenter)
        lay.addWidget(self.exp_summary)

        self.exp_prog = QProgressBar()
        self.exp_prog.setRange(0, 100)
        self.exp_prog.hide()
        lay.addWidget(self.exp_prog)

        self.exp_status = QLabel("")
        self.exp_status.setObjectName("muted")
        self.exp_status.setWordWrap(True)
        lay.addWidget(self.exp_status)

        self.exp_btn = QPushButton("Export Video")
        self.exp_btn.setObjectName("recBtn")
        self.exp_btn.setFixedHeight(36)
        self.exp_btn.clicked.connect(self._start_export)
        lay.addWidget(self.exp_btn)

        self.exp_cancel_btn = QPushButton("Cancel Export")
        self.exp_cancel_btn.setObjectName("dangerBtn")
        self.exp_cancel_btn.hide()
        self.exp_cancel_btn.clicked.connect(self._cancel_export)
        lay.addWidget(self.exp_cancel_btn)

        lay.addStretch()
        return self._scroll_wrap(inner)

    # ---------------- Load / Save Project & Media ----------------
    def load_media_or_project(self, path: str):
        p = Path(path)
        if not p.is_file():
            self.toast_requested.emit(f"File not found: {p.name}")
            return

        if p.suffix.lower() == ".recproj":
            self.proj = ENG.load_project(str(p))
            self.project_path = str(p)
        elif p.suffix.lower() == ".cast":
            # Render raw unframed MP4 once via cast2mp4 so Studio Editor can edit any .cast clip!
            raw_mp4 = str(p.with_suffix(".studio_src.mp4"))
            self.toast_requested.emit("Preparing .cast for Studio...")
            QApplication.processEvents()
            res = subprocess.run(
                ["cast2mp4", "--no-frame", "--res", "1080p", str(p), raw_mp4],
                capture_output=True, text=True,
            )
            if res.returncode != 0 or not os.path.isfile(raw_mp4):
                QMessageBox.warning(self, "Import .cast", f"Could not render .cast:\n{res.stderr}")
                return
            self.proj = ENG.default_project(raw_mp4)
            self.project_path = ""
        else:
            self.proj = ENG.default_project(str(p))
            self.project_path = ""

        self._frame_cache.clear()
        self._webcam_cache.clear()
        self._undo_stack.clear()
        self._redo_stack.clear()
        self.cur_t = 0.0
        self.sel_track = ""
        self.sel_id = ""
        self.file_badge.setText(p.name[:28])
        self._sync_ui_from_project()
        self._render_preview_now()
        self.toast_requested.emit(f"Loaded {p.name}")

    def _open_media_dialog(self):
        vdir = self._video_dir_getter()
        fn, _ = QFileDialog.getOpenFileName(
            self, "Open Video or Cast", vdir, "Media (*.mp4 *.mkv *.webm *.mov *.cast);;All Files (*)"
        )
        if fn:
            self.load_media_or_project(fn)

    def _open_project_dialog(self):
        vdir = self._video_dir_getter()
        fn, _ = QFileDialog.getOpenFileName(self, "Open Studio Project", vdir, "rec-cli Project (*.recproj)")
        if fn:
            self.load_media_or_project(fn)

    def _save_project_dialog(self):
        default_p = self.project_path
        if not default_p:
            src = self.proj.get("source", "")
            base = Path(src).stem if src else f"project_{time.strftime('%Y%m%d-%H%M%S')}"
            default_p = str(Path(self._video_dir_getter()) / f"{base}.recproj")
        fn, _ = QFileDialog.getSaveFileName(self, "Save Studio Project", default_p, "rec-cli Project (*.recproj)")
        if fn:
            if not fn.endswith(".recproj"):
                fn += ".recproj"
            ENG.save_project(self.proj, fn)
            self.project_path = fn
            self.toast_requested.emit(f"Saved {Path(fn).name}")

    # ---------------- Undo / Redo & Mutations ----------------
    def _push_undo(self):
        self._undo_stack.append(copy.deepcopy(self.proj))
        if len(self._undo_stack) > 30:
            self._undo_stack.pop(0)
        self._redo_stack.clear()

    def _undo(self):
        if not self._undo_stack:
            return
        self._redo_stack.append(copy.deepcopy(self.proj))
        self.proj = self._undo_stack.pop()
        self._sync_ui_from_project()
        self._schedule_render()
        self.toast_requested.emit("Undo")

    def _redo(self):
        if not self._redo_stack:
            return
        self._undo_stack.append(copy.deepcopy(self.proj))
        self.proj = self._redo_stack.pop()
        self._sync_ui_from_project()
        self._schedule_render()
        self.toast_requested.emit("Redo")

    def _set_aspect_ratio(self, ar: str):
        self._push_undo()
        self.proj["aspect_ratio"] = ar
        self._sync_ui_from_project()
        self._schedule_render()

    def _set_bg_type(self, btype: str):
        self._push_undo()
        self.proj["background"]["type"] = btype
        self._sync_ui_from_project()
        self._schedule_render()

    def _set_bg_preset(self, key: str):
        self._push_undo()
        self.proj["background"]["type"] = "preset"
        self.proj["background"]["preset"] = key
        self._sync_ui_from_project()
        self._schedule_render()

    def _pick_bg_color(self, key: str):
        cur = QColor(self.proj["background"].get(key, "#0f172a"))
        col = QColorDialog.getColor(cur, self, "Choose Background Color")
        if col.isValid():
            self._push_undo()
            self.proj["background"][key] = col.name()
            if self.proj["background"]["type"] == "preset":
                self.proj["background"]["type"] = "gradient"
            self._sync_ui_from_project()
            self._schedule_render()

    def _pick_bg_image(self):
        fn, _ = QFileDialog.getOpenFileName(self, "Choose Wallpaper Image", str(Path.home()), "Images (*.png *.jpg *.jpeg *.webp)")
        if fn:
            self._push_undo()
            self.proj["background"]["type"] = "image"
            self.proj["background"]["image"] = fn
            self._sync_ui_from_project()
            self._schedule_render()

    def _mut_bg(self, key: str, val):
        self.proj["background"][key] = val
        self._schedule_render()

    def _mut_frame(self, key: str, val):
        self.proj["frame"][key] = val
        self._schedule_render()

    def _mut_nested(self, section: str, key: str, val):
        self.proj[section][key] = val
        self._schedule_render()

    def _mut_export(self, key: str, val):
        if self._syncing_ui:
            return
        self.proj["export"][key] = val
        self._update_export_summary()

    def _mut_item(self, item: dict, key: str, val):
        item[key] = val
        self.timeline.update()
        self._schedule_render()

    def _mut_item_focus(self, item: dict, key: str, val: float):
        item[key] = round(val, 3)
        self.preview.set_reticle((float(item.get("x", 0.5)), float(item.get("y", 0.5))), f"Zoom {float(item.get('depth', 1.75)):.1f}x")
        self._schedule_render()

    def _pick_webcam_video(self):
        fn, _ = QFileDialog.getOpenFileName(self, "Choose Webcam Video", self._video_dir_getter(), "Video (*.mp4 *.mkv *.webm *.mov)")
        if fn:
            self._push_undo()
            self.proj["webcam"]["path"] = fn
            self.proj["webcam"]["enabled"] = True
            self._webcam_cache.clear()
            self._sync_ui_from_project()
            self._schedule_render()

    def _pick_audio_overlay(self):
        fn, _ = QFileDialog.getOpenFileName(self, "Choose Audio Track", str(Path.home()), "Audio (*.mp3 *.wav *.m4a *.ogg *.flac)")
        if fn:
            self._push_undo()
            self.proj["audio"]["overlay_path"] = fn
            self._sync_ui_from_project()
            self.timeline.update()

    def _clear_audio_overlay(self):
        self._push_undo()
        self.proj["audio"]["overlay_path"] = ""
        self._sync_ui_from_project()
        self.timeline.update()

    def _pick_ann_color(self, item: dict, key: str):
        col = QColorDialog.getColor(QColor(item.get(key, "#e5484d")), self, "Choose Color")
        if col.isValid():
            item[key] = col.name()
            self._schedule_render()

    def _pick_ann_image(self, item: dict):
        fn, _ = QFileDialog.getOpenFileName(self, "Choose Overlay Image", str(Path.home()), "Images (*.png *.jpg *.jpeg *.webp)")
        if fn:
            item["image_path"] = fn
            self._schedule_render()

    # ---------------- Timeline Item Operations ----------------
    def _get_selected_item(self) -> dict | None:
        if not self.sel_track or not self.sel_id:
            return None
        for it in self.proj.get(self.sel_track, []):
            if it.get("id") == self.sel_id:
                return it
        return None

    def _select_and_focus(self, track: str, item_id: str):
        self.sel_track = track
        self.sel_id = item_id
        self.timeline.set_selection(track, item_id)
        self._rebuild_item_inspector()
        self._switch_inspector_tab(2)
        self._schedule_render()

    def _add_zoom(self):
        self._push_undo()
        dur = max(0.5, float(self.proj.get("duration", 10.0)))
        s = round(min(self.cur_t, max(0.0, dur - 0.8)), 2)
        e = round(min(dur, s + min(2.5, dur * 0.35)), 2)
        item = {"id": ENG.new_id("zoom"), "start": s, "end": e, "depth": 1.8, "x": 0.5, "y": 0.5, "auto": False}
        self.proj["zooms"].append(item)
        self.timeline.set_project(self.proj)
        self._select_and_focus("zooms", item["id"])

    def _add_trim(self):
        self._push_undo()
        dur = max(0.5, float(self.proj.get("duration", 10.0)))
        s = round(min(self.cur_t, max(0.0, dur - 0.5)), 2)
        e = round(min(dur, s + min(1.5, dur * 0.2)), 2)
        item = {"id": ENG.new_id("trim"), "start": s, "end": e}
        self.proj["trims"].append(item)
        self.timeline.set_project(self.proj)
        self._select_and_focus("trims", item["id"])
        self._update_export_summary()

    def _add_speed(self):
        self._push_undo()
        dur = max(0.5, float(self.proj.get("duration", 10.0)))
        s = round(min(self.cur_t, max(0.0, dur - 0.6)), 2)
        e = round(min(dur, s + min(3.0, dur * 0.35)), 2)
        item = {"id": ENG.new_id("spd"), "start": s, "end": e, "rate": 2.0}
        self.proj["speeds"].append(item)
        self.timeline.set_project(self.proj)
        self._select_and_focus("speeds", item["id"])
        self._update_export_summary()

    def _add_annotation(self, kind: str):
        self._push_undo()
        dur = max(0.5, float(self.proj.get("duration", 10.0)))
        s = round(min(self.cur_t, max(0.0, dur - 0.6)), 2)
        e = round(min(dur, s + min(3.0, dur * 0.35)), 2)
        item = {
            "id": ENG.new_id("ann"), "kind": kind, "start": s, "end": e,
            "x": 0.5, "y": 0.22 if kind == "text" else 0.5,
            "w": 0.24, "h": 0.14,
            "text": "Callout" if kind == "text" else "",
            "color": "#f2f2f5" if kind == "text" else "#e5484d",
            "bg": "#141418", "font_size": 32, "image_path": "",
        }
        if kind == "image":
            self._pick_ann_image(item)
        self.proj["annotations"].append(item)
        self.timeline.set_project(self.proj)
        self._select_and_focus("annotations", item["id"])

    def _delete_selected(self):
        if not self.sel_track or not self.sel_id:
            return
        self._push_undo()
        self.proj[self.sel_track] = [x for x in self.proj.get(self.sel_track, []) if x.get("id") != self.sel_id]
        self.sel_track = ""
        self.sel_id = ""
        self.timeline.set_selection("", "")
        self.timeline.set_project(self.proj)
        self._rebuild_item_inspector()
        self._update_export_summary()
        self._schedule_render()

    def _run_auto_zoom(self):
        if not self.proj.get("source"):
            self.toast_requested.emit("Open a video first")
            return
        self._push_undo()
        self.toast_requested.emit("Analyzing motion for Auto-Zoom...")
        QApplication.processEvents()
        new_z = ENG.generate_auto_zooms(self.proj)
        # Keep manual zooms, replace previous auto zooms
        manual = [z for z in self.proj.get("zooms", []) if not z.get("auto")]
        self.proj["zooms"] = manual + new_z
        self.timeline.set_project(self.proj)
        self._schedule_render()
        self.toast_requested.emit(f"Added {len(new_z)} Auto-Zoom region(s)")

    # ---------------- Preview Playback & Canvas Interaction ----------------
    def _on_canvas_point_picked(self, nx: float, ny: float):
        item = self._get_selected_item()
        if item is not None and self.sel_track in ("zooms", "annotations"):
            item["x"] = round(nx, 3)
            item["y"] = round(ny, 3)
            self._rebuild_item_inspector()
            self._schedule_render()

    def _on_timeline_seek(self, t: float):
        self.cur_t = max(0.0, min(float(self.proj.get("duration", 10.0)), t))
        self._update_time_label()
        self._schedule_render()

    def _on_timeline_select(self, track: str, item_id: str):
        self.sel_track = track
        self.sel_id = item_id
        self._rebuild_item_inspector()
        if item_id:
            self._switch_inspector_tab(2)
        self._schedule_render()

    def _on_timeline_mutated(self):
        self._rebuild_item_inspector()
        self._update_export_summary()
        self._schedule_render()

    def _toggle_play(self):
        if not self.proj.get("source"):
            return
        self.playing = not self.playing
        self.play_btn.setText("❚❚ Pause" if self.playing else "▶ Play")
        if self.playing:
            if self.cur_t >= float(self.proj.get("duration", 10.0)) - 0.05:
                self.cur_t = 0.0
            self._play_timer.start()
        else:
            self._play_timer.stop()

    def _on_play_tick(self):
        dur = float(self.proj.get("duration", 10.0))
        self.cur_t += 0.066
        if self.cur_t >= dur:
            self.cur_t = dur
            self.playing = False
            self._play_timer.stop()
            self.play_btn.setText("▶ Play")
        self.timeline.set_time(self.cur_t)
        self._update_time_label()
        self._render_preview_now()

    def _update_time_label(self):
        dur = float(self.proj.get("duration", 0.0))
        self.time_lbl.setText(f"{fmt_ts(self.cur_t)} / {fmt_ts(dur)}")

    def _schedule_render(self):
        self._render_debounce.start()

    def _get_cached_src_frame(self, t: float) -> Image.Image | None:
        src = self.proj.get("source", "")
        if not src or not os.path.isfile(src):
            return None
        bucket = int(round(t * 15))
        if bucket not in self._frame_cache:
            img = ENG.extract_frame_pil(src, bucket / 15.0, max_w=800)
            if img is None:
                return None
            if len(self._frame_cache) > 90:
                self._frame_cache.pop(next(iter(self._frame_cache)))
            self._frame_cache[bucket] = img
        return self._frame_cache[bucket]

    def _get_cached_webcam_frame(self, t: float) -> Image.Image | None:
        wcfg = self.proj.get("webcam", {})
        wpath = wcfg.get("path", "")
        if not wcfg.get("enabled") or not wpath or not os.path.isfile(wpath):
            return None
        bucket = int(round(t * 10))
        if bucket not in self._webcam_cache:
            img = ENG.extract_frame_pil(wpath, bucket / 10.0, max_w=240)
            if img is None:
                return None
            if len(self._webcam_cache) > 40:
                self._webcam_cache.pop(next(iter(self._webcam_cache)))
            self._webcam_cache[bucket] = img
        return self._webcam_cache[bucket]

    def _render_preview_now(self):
        src_img = self._get_cached_src_frame(self.cur_t)
        if src_img is None:
            self.preview.set_frame(None)
            return
        pw, ph = ENG.compute_output_dims(self.proj, preview_max=760)
        w_img = self._get_cached_webcam_frame(self.cur_t)
        composed = self.compositor.compose(src_img, self.proj, self.cur_t, pw, ph, webcam_img=w_img)
        self.preview.set_frame(pil_to_qpixmap(composed))

    # ---------------- Sync UI Controls <-> Project Dict ----------------
    def _select_combo(self, cb: QComboBox, target):
        for i in range(cb.count()):
            if str(cb.itemData(i)) == str(target):
                cb.setCurrentIndex(i)
                return

    def _sync_ui_from_project(self):
        self._syncing_ui = True
        try:
            ar = self.proj.get("aspect_ratio", "16:9")
            for k, b in self._ar_btns.items():
                b.setProperty("active", k == ar)
                b.style().unpolish(b)
                b.style().polish(b)

            bg = self.proj.get("background", {})
            btype = bg.get("type", "preset")
            for k, b in self._bg_type_btns.items():
                b.setProperty("active", k == btype)
                b.style().unpolish(b)
                b.style().polish(b)
            for k, sw in self._swatches.items():
                sw.set_selected(btype == "preset" and bg.get("preset") == k)
            self.bg_presets_box.setVisible(btype == "preset")
            self.c1_btn.setVisible(btype in ("gradient", "solid"))
            self.c2_btn.setVisible(btype == "gradient")
            self.img_btn.setVisible(btype == "image")
            self.bg_blur_sld.setValue(int(bg.get("blur", 0)))

            fr = self.proj.get("frame", {})
            self.pad_sld.setValue(int(fr.get("padding", 7)))
            self.rad_sld.setValue(int(fr.get("radius", 18)))
            self.shd_sld.setValue(int(fr.get("shadow", 65)))
            self._select_combo(self.chrome_combo, fr.get("chrome", "none"))
            self.ct_sld.setValue(int(fr.get("crop_top", 0)))
            self.cb_sld.setValue(int(fr.get("crop_bottom", 0)))
            self.cl_sld.setValue(int(fr.get("crop_left", 0)))
            self.cr_sld.setValue(int(fr.get("crop_right", 0)))

            mot = self.proj.get("motion", {})
            self._select_combo(self.spring_combo, mot.get("spring", "smooth"))
            self.mblur_sld.setValue(int(mot.get("motion_blur", 20)))

            cur = self.proj.get("cursor", {})
            self.sw_cur_en.setChecked(bool(cur.get("enabled", False)))
            self.sw_cur_bounce.setChecked(bool(cur.get("click_bounce", True)))
            self.sw_cur_idle.setChecked(bool(cur.get("hide_idle", True)))
            self._select_combo(self.cur_style_combo, cur.get("style", "macos"))
            self.cur_sz_sld.setValue(int(float(cur.get("size", 1.25)) * 100))
            self.cur_sm_sld.setValue(int(cur.get("smoothing", 65)))

            wb = self.proj.get("webcam", {})
            self.sw_wb_en.setChecked(bool(wb.get("enabled", False)))
            self.wb_lbl.setText(Path(wb["path"]).name if wb.get("path") else "No webcam video")
            self._select_combo(self.wb_corner_combo, wb.get("corner", "br"))
            self.wb_sz_sld.setValue(int(wb.get("size", 20)))
            self.wb_rnd_sld.setValue(int(wb.get("roundness", 100)))
            self.sw_wb_shd.setChecked(bool(wb.get("shadow", True)))
            self.sw_wb_shrink.setChecked(bool(wb.get("shrink_on_zoom", True)))

            au = self.proj.get("audio", {})
            self.au_lbl.setText(Path(au["overlay_path"]).name if au.get("overlay_path") else "No audio overlay")
            self.au_vol_sld.setValue(int(float(au.get("overlay_volume", 0.75)) * 100))
            self.sw_au_mute.setChecked(bool(au.get("mute_source", False)))

            exp = self.proj.get("export", {})
            self._select_combo(self.exp_fmt, exp.get("format", "mp4"))
            self._select_combo(self.exp_res, exp.get("resolution", "1080p"))
            self._select_combo(self.exp_fps, exp.get("fps", 30))
            self._select_combo(self.exp_qual, exp.get("quality", "high"))

            self.timeline.set_project(self.proj)
            self.timeline.set_time(self.cur_t)
            self._update_time_label()
            self._update_export_summary()
            self._rebuild_item_inspector()
        finally:
            self._syncing_ui = False

    def _update_export_summary(self):
        w, h = ENG.compute_output_dims(self.proj)
        dur = ENG.output_duration(self.proj)
        fmt = self.proj.get("export", {}).get("format", "mp4").upper()
        fps = self.proj.get("export", {}).get("fps", 30)
        self.exp_summary.setText(f"{w} × {h} · {fps}fps {fmt} · {fmt_ts(dur)}")

    # ---------------- Export Pipeline ----------------
    def _start_export(self):
        if not self.proj.get("source"):
            QMessageBox.information(self, "Export", "Load a video clip first.")
            return
        fmt = self.proj.get("export", {}).get("format", "mp4").lower()
        stem = Path(self.proj["source"]).stem
        default_out = str(Path(self._video_dir_getter()) / f"{stem}_edited.{fmt}")
        flt = "MP4 Video (*.mp4)" if fmt == "mp4" else "Animated GIF (*.gif)"
        out_path, _ = QFileDialog.getSaveFileName(self, "Export Studio Video", default_out, flt)
        if not out_path:
            return
        if not out_path.lower().endswith(f".{fmt}"):
            out_path += f".{fmt}"

        self.exp_btn.setEnabled(False)
        self.exp_cancel_btn.show()
        self.exp_prog.setValue(0)
        self.exp_prog.show()
        self.exp_status.setText("Starting export...")

        self._export_worker = ExportWorker(self.proj, out_path)
        self._export_worker.progress.connect(self._on_export_progress)
        self._export_worker.finished_export.connect(self._on_export_done)
        self._export_worker.start()

    def _cancel_export(self):
        if self._export_worker is not None:
            self._export_worker.cancel()
            self.exp_status.setText("Canceling...")

    def _on_export_progress(self, pct: int, msg: str):
        self.exp_prog.setValue(pct)
        self.exp_status.setText(msg)

    def _on_export_done(self, ok: bool, msg: str):
        self.exp_btn.setEnabled(True)
        self.exp_cancel_btn.hide()
        self._export_worker = None
        if ok:
            self.exp_prog.setValue(100)
            self.exp_status.setText(f"Saved: {Path(msg).name}")
            self.toast_requested.emit(f"Exported {Path(msg).name}")
        else:
            self.exp_status.setText(msg)
            self.toast_requested.emit("Export stopped")


def main() -> int:
    app = QApplication(sys.argv)
    app.setApplicationName("rec-cli Studio")
    win = QMainWindow()
    win.setWindowTitle("rec-cli Studio Editor")
    win.resize(1220, 760)
    ed = StudioEditorPage(lambda: str(Path.home() / "Videos/content"))
    win.setCentralWidget(ed)

    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if args and os.path.isfile(args[0]):
        ed.load_media_or_project(args[0])

    if "--smoke-test" in sys.argv:
        win.show()
        app.processEvents()
        win.close()
        print("STUDIO_SMOKE_OK")
        return 0

    win.show()
    return app.exec() if hasattr(app, "exec") else app.exec_()


if __name__ == "__main__":
    sys.exit(main())
