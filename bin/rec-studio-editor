        "track_alt": "#f2f2f6",
    },
}


def fmt_ts(sec: float) -> str:
    sec = max(0.0, float(sec))
    m, s = divmod(int(sec), 60)
    ms = int((sec - int(sec)) * 10)
    return f"{m:02d}:{s:02d}.{ms}"


def pil_to_qpixmap(img: Image.Image) -> QPixmap:
    rgb = img.convert("RGB")
    data = rgb.tobytes("raw", "RGB")
    qimg = QImage(data, rgb.width, rgb.height, rgb.width * 3, QImage.Format.Format_RGB888)
    return QPixmap.fromImage(qimg.copy())


# ---------------------------------------------------------------------------
# Compact Studio Toggle & Swatch Helpers
# ---------------------------------------------------------------------------

class MiniSwitch(QWidget):
    toggled = Signal(bool)

    def __init__(self, checked: bool = False, accent_red: bool = False):
        super().__init__()
        self._checked = checked
        self._accent_red = accent_red
        self._mode = "dark"
        self.setFixedSize(34, 18)
        self.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))

    def set_theme(self, mode: str):
        self._mode = mode
        self.update()

    def isChecked(self) -> bool:
        return self._checked

    def setChecked(self, v: bool):
        v = bool(v)
        if self._checked != v:
            self._checked = v
            self.update()

    def mouseReleaseEvent(self, ev):
        if self.isEnabled() and ev.button() == Qt.MouseButton.LeftButton:
            self._checked = not self._checked
            self.update()
            self.toggled.emit(self._checked)
        super().mouseReleaseEvent(ev)

    def paintEvent(self, _ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        r = h / 2.0
        if self._checked:
            bg = QColor("#e5484d" if self._accent_red else ("#f2f2f5" if self._mode == "dark" else "#141418"))
            fg = QColor("#ffffff" if self._accent_red or self._mode == "light" else "#0c0c0e")
        else:
            bg = QColor("#2c2c34" if self._mode == "dark" else "#d2d2dc")
            fg = QColor("#8e8e9a" if self._mode == "dark" else "#ffffff")
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(bg)
        p.drawRoundedRect(QRectF(0, 0, w, h), r, r)
        pad = 2.5
        d = h - pad * 2
        x = (w - pad - d) if self._checked else pad
        p.setBrush(fg)
        p.drawEllipse(QRectF(x, pad, d, d))
        p.end()


class WallpaperSwatch(QPushButton):
    """Painted gradient thumbnail button for curated Studio wallpapers."""

    def __init__(self, key: str, info: dict):
        super().__init__()
        self.key = key
        self.info = info
        self.selected = False
        self.setFixedHeight(32)
        self.setToolTip(info["label"])
        self.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))

    def set_selected(self, sel: bool):
        self.selected = sel
        self.update()

    def paintEvent(self, _ev):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        rect = QRectF(1.5, 1.5, self.width() - 3, self.height() - 3)
        grad = QLinearGradient(rect.topLeft(), rect.bottomRight())
        grad.setColorAt(0.0, QColor(self.info["c1"]))
        grad.setColorAt(0.5, QColor(self.info["c2"]))
        grad.setColorAt(1.0, QColor(self.info["c3"]))
        p.setBrush(grad)
        if self.selected:
            p.setPen(QPen(QColor("#e5484d"), 2.2))
        else:
            p.setPen(QPen(QColor(255, 255, 255, 45), 1.0))
        p.drawRoundedRect(rect, 6, 6)
        p.end()


# ---------------------------------------------------------------------------
# Interactive WYSIWYG Preview Canvas (Click to Aim Zoom / Place Overlay)
# ---------------------------------------------------------------------------

class PreviewCanvas(QWidget):
    point_picked = Signal(float, float)  # normalized (0..1, 0..1) inside displayed frame

    def __init__(self):
        super().__init__()
        self._pixmap: QPixmap | None = None
        self._mode = "dark"
        self._reticle: tuple[float, float] | None = None
        self._reticle_label = ""
        self._draw_rect = QRectF()
        self.setMinimumHeight(260)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.setCursor(QCursor(Qt.CursorShape.CrossCursor))

    def set_theme(self, mode: str):
        self._mode = mode
        self.update()

    def set_frame(self, pm: QPixmap | None):
        self._pixmap = pm
        self.update()

    def set_reticle(self, pt: tuple[float, float] | None, label: str = ""):
        self._reticle = pt
        self._reticle_label = label
        self.update()

    def mousePressEvent(self, ev):
        if ev.button() == Qt.MouseButton.LeftButton and not self._draw_rect.isEmpty():
            pos = ev.position() if hasattr(ev, "position") else ev.localPos()
            if self._draw_rect.contains(pos):
                nx = (pos.x() - self._draw_rect.left()) / max(1.0, self._draw_rect.width())
                ny = (pos.y() - self._draw_rect.top()) / max(1.0, self._draw_rect.height())
                self.point_picked.emit(max(0.0, min(1.0, nx)), max(0.0, min(1.0, ny)))
        super().mousePressEvent(ev)

    def paintEvent(self, _ev):
        pal = PALETTES["light" if self._mode == "light" else "dark"]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)

        p.fillRect(self.rect(), QColor(pal["bg"]))
        pad = 10
        avail = QRectF(pad, pad, max(10, self.width() - pad * 2), max(10, self.height() - pad * 2))

        if self._pixmap is None or self._pixmap.isNull():
            p.setPen(QPen(QColor(pal["border"]), 1))
            p.setBrush(QColor(pal["surface"]))
            p.drawRoundedRect(avail, 10, 10)
            p.setPen(QColor(pal["muted"]))
            p.drawText(avail, Qt.AlignmentFlag.AlignCenter, "Open any MP4, .cast, or .recproj — or click Edit on any clip")
            self._draw_rect = QRectF()
            p.end()
            return

        pw, ph = self._pixmap.width(), self._pixmap.height()
        s = min(avail.width() / max(1, pw), avail.height() / max(1, ph))
        dw, dh = pw * s, ph * s
        dx = avail.left() + (avail.width() - dw) / 2.0
        dy = avail.top() + (avail.height() - dh) / 2.0
        self._draw_rect = QRectF(dx, dy, dw, dh)

        p.drawPixmap(self._draw_rect.toRect(), self._pixmap)
        p.setPen(QPen(QColor(pal["border_strong"]), 1))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawRect(self._draw_rect)

        # Draw focus target reticle when a zoom or annotation item is selected
        if self._reticle is not None:
            rx = dx + self._reticle[0] * dw
            ry = dy + self._reticle[1] * dh
            p.setPen(QPen(QColor("#e5484d"), 2.0))
            p.setBrush(QColor(229, 72, 77, 40))
            p.drawEllipse(QPointF(rx, ry), 13, 13)
            p.drawLine(QPointF(rx - 18, ry), QPointF(rx + 18, ry))
            p.drawLine(QPointF(rx, ry - 18), QPointF(rx, ry + 18))
            if self._reticle_label:
                p.setPen(QColor("#ffffff"))
                p.setBrush(QColor(18, 18, 22, 210))
                lbl_r = QRectF(rx + 16, ry - 11, 78, 20)
                p.drawRoundedRect(lbl_r, 4, 4)
                p.drawText(lbl_r, Qt.AlignmentFlag.AlignCenter, self._reticle_label)

        p.end()


# ---------------------------------------------------------------------------
# Interactive Multi-Track Timeline (Zoom / Trim / Speed / Overlays / Audio)
# ---------------------------------------------------------------------------

class TimelineWidget(QWidget):
    seek_requested = Signal(float)
    selection_changed = Signal(str, str)   # (track_kind, item_id) or ("", "")
    project_mutated = Signal()

    TRACKS = [
        ("zooms",       "Zoom"),
        ("trims",       "Trim Cut"),
        ("speeds",      "Speed"),
        ("annotations", "Overlays"),
        ("audio",       "Audio"),
    ]
    LABEL_W = 82
    RULER_H = 24
    ROW_H = 28

    def __init__(self):
        super().__init__()
        self._proj: dict | None = None
        self._cur_t = 0.0
        self._mode = "dark"
        self.sel_track = ""
        self.sel_id = ""
        self._drag_mode = ""  # "scrub" | "move" | "resize_l" | "resize_r"
        self._drag_item: dict | None = None
        self._drag_origin_t = 0.0
        self._drag_orig_start = 0.0
        self._drag_orig_end = 0.0
        self.setFixedHeight(self.RULER_H + len(self.TRACKS) * self.ROW_H + 8)
        self.setMouseTracking(True)

    def set_theme(self, mode: str):
        self._mode = mode
        self.update()

    def set_project(self, proj: dict):
        self._proj = proj
        self.update()

    def set_time(self, t: float):
        self._cur_t = max(0.0, t)
        self.update()

    def set_selection(self, track: str, item_id: str):
        self.sel_track = track
        self.sel_id = item_id
        self.update()

    def _duration(self) -> float:
        return max(0.5, float(self._proj.get("duration", 10.0))) if self._proj else 10.0

    def _t_to_x(self, t: float) -> float:
        w = max(40.0, self.width() - self.LABEL_W - 14)
        return self.LABEL_W + (max(0.0, min(self._duration(), t)) / self._duration()) * w

    def _x_to_t(self, x: float) -> float:
        w = max(40.0, self.width() - self.LABEL_W - 14)
        frac = max(0.0, min(1.0, (x - self.LABEL_W) / w))
        return frac * self._duration()

    def _hit_test(self, x: float, y: float) -> tuple[str, dict | None, str]:
        if not self._proj or y < self.RULER_H or x < self.LABEL_W:
            return ("", None, "")
        row = int((y - self.RULER_H) // self.ROW_H)
        if row < 0 or row >= len(self.TRACKS):
            return ("", None, "")
        tk = self.TRACKS[row][0]
        if tk == "audio":
            return ("audio", None, "")
        for item in self._proj.get(tk, []):
            x0 = self._t_to_x(float(item.get("start", 0.0)))
            x1 = self._t_to_x(float(item.get("end", 0.0)))
            if x0 - 4 <= x <= x1 + 4:
                if abs(x - x0) <= 7:
                    return (tk, item, "resize_l")
                if abs(x - x1) <= 7:
                    return (tk, item, "resize_r")
                return (tk, item, "move")
        return (tk, None, "")

    def mousePressEvent(self, ev):
        if ev.button() != Qt.MouseButton.LeftButton or not self._proj:
            return
        pos = ev.position() if hasattr(ev, "position") else ev.localPos()
        x, y = pos.x(), pos.y()
        if y <= self.RULER_H and x >= self.LABEL_W:
            self._drag_mode = "scrub"
            t = self._x_to_t(x)
            self._cur_t = t
            self.seek_requested.emit(t)
            self.update()
            return

        tk, item, mode = self._hit_test(x, y)
        if item is not None:
            self.sel_track = tk
            self.sel_id = item.get("id", "")
            self._drag_mode = mode
            self._drag_item = item
            self._drag_origin_t = self._x_to_t(x)
            self._drag_orig_start = float(item["start"])
            self._drag_orig_end = float(item["end"])
            self.selection_changed.emit(self.sel_track, self.sel_id)
            self.update()
        elif x >= self.LABEL_W:
            self.sel_track = ""
            self.sel_id = ""
            self.selection_changed.emit("", "")
            self._drag_mode = "scrub"
            t = self._x_to_t(x)
            self._cur_t = t
            self.seek_requested.emit(t)
            self.update()

    def mouseMoveEvent(self, ev):
        pos = ev.position() if hasattr(ev, "position") else ev.localPos()
        x, y = pos.x(), pos.y()
        if not self._drag_mode:
            _tk, _it, mode = self._hit_test(x, y)
            if mode in ("resize_l", "resize_r"):
                self.setCursor(QCursor(Qt.CursorShape.SizeHorCursor))
            elif mode == "move":
                self.setCursor(QCursor(Qt.CursorShape.OpenHandCursor))
            else:
                self.setCursor(QCursor(Qt.CursorShape.ArrowCursor))
            return

        t = self._x_to_t(x)
        dur = self._duration()
        if self._drag_mode == "scrub":
            self._cur_t = t
            self.seek_requested.emit(t)
            self.update()
        elif self._drag_item is not None:
            dt = t - self._drag_origin_t
            if self._drag_mode == "move":
                span = self._drag_orig_end - self._drag_orig_start
                ns = max(0.0, min(dur - span, self._drag_orig_start + dt))
                self._drag_item["start"] = round(ns, 2)
                self._drag_item["end"] = round(ns + span, 2)
            elif self._drag_mode == "resize_l":
                ns = max(0.0, min(self._drag_orig_end - 0.2, self._drag_orig_start + dt))
                self._drag_item["start"] = round(ns, 2)
            elif self._drag_mode == "resize_r":
                ne = max(self._drag_orig_start + 0.2, min(dur, self._drag_orig_end + dt))
                self._drag_item["end"] = round(ne, 2)
            self.update()

    def mouseReleaseEvent(self, ev):
        if self._drag_mode in ("move", "resize_l", "resize_r"):
            self.project_mutated.emit()
        self._drag_mode = ""
        self._drag_item = None
        super().mouseReleaseEvent(ev)

    def paintEvent(self, _ev):
        pal = PALETTES["light" if self._mode == "light" else "dark"]
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        w, h = self.width(), self.height()
        p.fillRect(0, 0, w, h, QColor(pal["surface"]))
        p.setPen(QPen(QColor(pal["border"]), 1))
        p.drawLine(0, 0, w, 0)
        p.drawLine(self.LABEL_W, 0, self.LABEL_W, h)

        # Ruler ticks
        dur = self._duration()
        p.fillRect(self.LABEL_W + 1, 1, w - self.LABEL_W - 1, self.RULER_H - 1, QColor(pal["track_bg"]))
        p.setPen(QColor(pal["dim"]))
        font = p.font()
        font.setPointSize(8)
        p.setFont(font)

        step = 1.0 if dur <= 12 else 2.0 if dur <= 30 else 5.0 if dur <= 90 else 15.0 if dur <= 300 else 30.0
        t = 0.0
        while t <= dur + 0.01:
            tx = self._t_to_x(t)
            p.setPen(QPen(QColor(pal["border_strong"]), 1))
            p.drawLine(QPointF(tx, self.RULER_H - 6), QPointF(tx, self.RULER_H))
            p.setPen(QColor(pal["muted"]))
            p.drawText(QRectF(tx + 3, 2, 44, self.RULER_H - 4), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, fmt_ts(t)[:-2])
            t += step

        # Track rows & blocks
        track_colors = {
            "zooms": pal["zoom"],
            "trims": pal["trim"],
            "speeds": pal["speed"],
            "annotations": pal["overlay"],
            "audio": pal["audio"],
        }

        for idx, (tk, label) in enumerate(self.TRACKS):
            ry = self.RULER_H + idx * self.ROW_H
            row_bg = QColor(pal["track_bg"] if idx % 2 == 0 else pal["track_alt"])
            p.fillRect(self.LABEL_W + 1, ry, w - self.LABEL_W - 1, self.ROW_H, row_bg)
            p.setPen(QPen(QColor(pal["border"]), 1))
            p.drawLine(0, ry, w, ry)

            # Track label
            p.setPen(QColor(pal["muted"]))
            p.drawText(QRectF(10, ry, self.LABEL_W - 14, self.ROW_H), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, label)

            if not self._proj:
                continue

            if tk == "audio":
                ov = self._proj.get("audio", {}).get("overlay_path", "")
                if ov:
                    x0 = self._t_to_x(float(self._proj["audio"].get("overlay_offset", 0.0)))
                    x1 = self._t_to_x(dur)
                    rect = QRectF(x0, ry + 4, max(24, x1 - x0), self.ROW_H - 8)
                    c = QColor(track_colors["audio"])
                    c.setAlpha(185)
                    p.setBrush(c)
                    p.setPen(Qt.PenStyle.NoPen)
                    p.drawRoundedRect(rect, 5, 5)
                    p.setPen(QColor("#ffffff"))
                    p.drawText(rect.adjusted(6, 0, -6, 0), Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, Path(ov).name)
                continue

            for item in self._proj.get(tk, []):
                x0 = self._t_to_x(float(item.get("start", 0.0)))
                x1 = self._t_to_x(float(item.get("end", 0.0)))
                rect = QRectF(x0, ry + 4, max(12.0, x1 - x0), self.ROW_H - 8)
                is_sel = (self.sel_track == tk and self.sel_id == item.get("id"))

                col = QColor(track_colors[tk])
                col.setAlpha(235 if is_sel else 175)
                p.setBrush(col)
                p.setPen(QPen(QColor("#ffffff"), 1.6) if is_sel else Qt.PenStyle.NoPen)
                p.drawRoundedRect(rect, 5, 5)

                if tk == "zooms":
                    txt = f"{float(item.get('depth', 1.7)):.1f}x"
                elif tk == "trims":
                    txt = "CUT"
                elif tk == "speeds":
                    txt = f"{float(item.get('rate', 2.0)):.2g}x"
                else:
                    kind = item.get("kind", "text")
                    txt = item.get("text", "") if kind == "text" else kind.upper()
                p.setPen(QColor("#ffffff"))
                p.drawText(rect.adjusted(5, 0, -5, 0), Qt.AlignmentFlag.AlignCenter, txt[:18])

        # Playhead line & top cap
        px = self._t_to_x(self._cur_t)
        p.setPen(QPen(QColor(pal["playhead"]), 1.6))
        p.drawLine(QPointF(px, 4), QPointF(px, h - 2))
        p.setBrush(QColor("#e5484d"))
        p.setPen(Qt.PenStyle.NoPen)
        tri = QPainterPath()
        tri.moveTo(px - 5, 2)
        tri.lineTo(px + 5, 2)
        tri.lineTo(px, 11)
        tri.closeSubpath()
        p.drawPath(tri)
        p.end()


# ---------------------------------------------------------------------------
# Background Export Thread
# ---------------------------------------------------------------------------

class ExportWorker(QThread):
    progress = Signal(int, str)
    finished_export = Signal(bool, str)

    def __init__(self, proj: dict, out_path: str):
        super().__init__()
        self.proj = copy.deepcopy(proj)
        self.out_path = out_path
        self._canceled = False

    def cancel(self):
        self._canceled = True

    def run(self):
        ok, msg = ENG.export_project(
            self.proj,
            self.out_path,
            progress_cb=lambda pct, txt: self.progress.emit(pct, txt),
            cancel_check=lambda: self._canceled,
        )
        self.finished_export.emit(ok, msg)


# ---------------------------------------------------------------------------
# Recordly-Style Screen, Window, Dual-Audio & Webcam Capture Panel
# ---------------------------------------------------------------------------

class ScreenRecorderPage(QWidget):
    recording_finished = Signal(str)  # emits saved MP4 path so GUI can open straight in Editor!

    def __init__(self, video_dir_getter):
        super().__init__()
        self._video_dir_getter = video_dir_getter
        self._mode = "dark"
        self._proc: subprocess.Popen | None = None
        self._current_out = ""
        self._started_at = 0.0
        self._switches: list[MiniSwitch] = []
        self._probe = self._run_probe()
        self._build_ui()

        self._tick = QTimer(self)
        self._tick.timeout.connect(self._on_tick)
        self._tick.start(500)

    def _run_probe(self) -> dict:
        cap = shutil.which("rec-capture") or str(Path(__file__).resolve().parent / "rec-capture")
        try:
            out = subprocess.check_output([cap, "--probe"], stderr=subprocess.DEVNULL, text=True, timeout=3)
            return json.loads(out)
        except Exception:
            return {"backend": "auto", "screen_w": 1920, "screen_h": 1080, "webcams": [], "has_mic_tool": True}

    def set_theme(self, mode: str):
        self._mode = mode
        for sw in self._switches:
            sw.set_theme(mode)

    def _add_switch_row(self, parent_lay: QVBoxLayout, title: str, desc: str, checked: bool = False, red: bool = False) -> MiniSwitch:
        row = QWidget()
        rl = QHBoxLayout(row)
        rl.setContentsMargins(0, 8, 0, 8)
        tc = QVBoxLayout()
        tc.setSpacing(1)
        tl = QLabel(title)
        tl.setObjectName("rowTitle")
        dl = QLabel(desc)
        dl.setObjectName("muted")
        tc.addWidget(tl)
        tc.addWidget(dl)
        rl.addLayout(tc, 1)
        sw = MiniSwitch(checked=checked, accent_red=red)
        self._switches.append(sw)
        rl.addWidget(sw)
        parent_lay.addWidget(row)
        return sw

    def _build_ui(self):
        lay = QVBoxLayout(self)
        lay.setContentsMargins(24, 22, 24, 20)
        lay.setSpacing(14)

        hdr = QHBoxLayout()
        tcol = QVBoxLayout()
        tcol.setSpacing(2)
        t = QLabel("Screen Recorder")
        t.setObjectName("pageTitle")
        sub = QLabel(
            f"Display {self._probe.get('screen_w', 1920)}x{self._probe.get('screen_h', 1080)} · "
            f"Backend: {self._probe.get('backend', 'auto')} · Dual audio + webcam + cursor tracking"
        )
        sub.setObjectName("muted")
        tcol.addWidget(t)
        tcol.addWidget(sub)
        hdr.addLayout(tcol)
        hdr.addStretch()

        self.status_badge = QLabel("Ready")
        self.status_badge.setObjectName("neutralBadge")
        hdr.addWidget(self.status_badge)
        lay.addLayout(hdr)

        # Capture source & options card
        card = QFrame()
        card.setObjectName("panel")
        cl = QVBoxLayout(card)
        cl.setContentsMargins(16, 14, 16, 14)
        cl.setSpacing(10)

        top_grid = QGridLayout()
        top_grid.setHorizontalSpacing(14)
        top_grid.setVerticalSpacing(8)

        self.mode_combo = QComboBox()
        self.mode_combo.addItem("Full Screen", "full")
        self.mode_combo.addItem("Custom Region (X, Y, W, H)", "area")
        self.mode_combo.currentIndexChanged.connect(self._on_mode_changed)

        self.fps_combo = QComboBox()
        self.fps_combo.addItem("30 fps", 30)
        self.fps_combo.addItem("60 fps", 60)

        self.area_edit = QLineEdit("100,100,1280,720")
        self.area_edit.setPlaceholderText("x,y,width,height")
        self.area_edit.setEnabled(False)

        self.cam_combo = QComboBox()
        cams = self._probe.get("webcams") or []
        if cams:
            for c in cams:
                self.cam_combo.addItem(c, c)
        else:
            self.cam_combo.addItem("No webcam detected", "")

        top_grid.addWidget(self._lbl("Capture Source"), 0, 0)
        top_grid.addWidget(self.mode_combo, 1, 0)
        top_grid.addWidget(self._lbl("Framerate"), 0, 1)
        top_grid.addWidget(self.fps_combo, 1, 1)
        top_grid.addWidget(self._lbl("Region (x,y,w,h)"), 2, 0)
        top_grid.addWidget(self.area_edit, 3, 0)
        top_grid.addWidget(self._lbl("Webcam Device"), 2, 1)
        top_grid.addWidget(self.cam_combo, 3, 1)
        cl.addLayout(top_grid)

        div = QFrame()
        div.setObjectName("divider")
        cl.addWidget(div)

        self.sw_mic = self._add_switch_row(cl, "Microphone Audio", "Record voiceover via PipeWire / PulseAudio", checked=True)
        self.sw_sys = self._add_switch_row(cl, "System Audio", "Capture desktop / app audio alongside mic", checked=False)
        self.sw_cam = self._add_switch_row(cl, "Webcam Bubble Sidecar", "Record synchronized camera track for floating bubble in Editor", checked=False)
        self.sw_cur = self._add_switch_row(cl, "Hide OS Cursor", "Let Studio render smoothed macOS vector cursor + click bounce", checked=False)
        self.sw_auto_edit = self._add_switch_row(cl, "Open in Studio Editor on Stop", "Jump straight to timeline, auto-zoom & wallpapers when finished", checked=True, red=True)
        lay.addWidget(card)

        # Action bar
        act = QHBoxLayout()
        act.setSpacing(10)
        self.rec_btn = QPushButton("● Start Screen Recording")
        self.rec_btn.setObjectName("recBtn")
        self.rec_btn.setFixedHeight(38)
        self.rec_btn.clicked.connect(self._toggle_record)

        self.zoom_flag_btn = QPushButton("Flag Zoom Point")
        self.zoom_flag_btn.setFixedHeight(38)
        self.zoom_flag_btn.setEnabled(False)
        self.zoom_flag_btn.clicked.connect(self._flag_zoom)

        act.addWidget(self.rec_btn, 1)
        act.addWidget(self.zoom_flag_btn)
        lay.addLayout(act)
        lay.addStretch()

    def _lbl(self, txt: str) -> QLabel:
        l = QLabel(txt)
        l.setObjectName("muted")
        return l

    def _on_mode_changed(self):
        self.area_edit.setEnabled(self.mode_combo.currentData() == "area")

    def _toggle_record(self):
        if self._proc is not None and self._proc.poll() is None:
            try:
                self._proc.send_signal(signal.SIGUSR1)
            except OSError:
                pass
            self.rec_btn.setEnabled(False)
            self.status_badge.setText("Finalizing...")
            return

        cap_bin = shutil.which("rec-capture") or str(Path(__file__).resolve().parent / "rec-capture")
        vdir = Path(self._video_dir_getter())
        vdir.mkdir(parents=True, exist_ok=True)
        self._current_out = str(vdir / f"screen_{time.strftime('%Y%m%d-%H%M%S')}.mp4")

        cmd = [cap_bin, "-o", self._current_out, "--fps", str(self.fps_combo.currentData())]
        if self.mode_combo.currentData() == "area" and self.area_edit.text().strip():
            cmd.extend(["--area", self.area_edit.text().strip()])
        if self.sw_mic.isChecked():
            cmd.append("--mic")
        if self.sw_sys.isChecked():
            cmd.append("--system-audio")
        if self.sw_cam.isChecked() and self.cam_combo.currentData():
            cmd.extend(["--webcam", "--webcam-device", str(self.cam_combo.currentData())])
        if self.sw_cur.isChecked():
            cmd.append("--hide-os-cursor")

        self._proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        self._started_at = time.time()
        self.rec_btn.setText("■ Stop Screen Recording")
        self.zoom_flag_btn.setEnabled(True)
        self.status_badge.setText("● REC 00:00")
        self.status_badge.setObjectName("recBadge")
        self.status_badge.style().unpolish(self.status_badge)
        self.status_badge.style().polish(self.status_badge)

    def _flag_zoom(self):
        if self._proc is not None and self._proc.poll() is None:
            try:
                self._proc.send_signal(signal.SIGUSR2)
                self.status_badge.setText("◆ Zoom Flagged")
            except OSError:
                pass

    def _on_tick(self):
        if self._proc is None:
            return
        rc = self._proc.poll()
        if rc is None:
            el = max(0, int(time.time() - self._started_at))
            m, s = divmod(el, 60)
            self.status_badge.setText(f"● REC {m:02d}:{s:02d}")
            return

        out, err = self._proc.communicate()
        self._proc = None
        self.rec_btn.setEnabled(True)
        self.rec_btn.setText("● Start Screen Recording")
        self.zoom_flag_btn.setEnabled(False)
        self.status_badge.setObjectName("neutralBadge")
        self.status_badge.style().unpolish(self.status_badge)
        self.status_badge.style().polish(self.status_badge)

        if rc == 0 and os.path.isfile(self._current_out):
            self.status_badge.setText("Saved")
            if self.sw_auto_edit.isChecked():
                self.recording_finished.emit(self._current_out)
        else:
            self.status_badge.setText("Capture failed")
            msg = (err or out or "Check Wayland/X11 capture permissions").strip()
            QMessageBox.warning(self, "Screen Capture", msg[:400])


