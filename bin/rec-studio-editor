def _load_engine():
    here = Path(__file__).resolve().parent
    for cand in (here / "rec-studio-engine", Path(shutil.which("rec-studio-engine") or "")):
        if cand and cand.is_file():
            loader = importlib.machinery.SourceFileLoader("rec_studio_engine", str(cand))
            spec = importlib.util.spec_from_loader(loader.name, loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            return mod
    raise RuntimeError("rec-studio-engine not found alongside rec-studio-editor")


ENG = _load_engine()

