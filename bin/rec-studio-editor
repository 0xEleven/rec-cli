class StudioEditorPage(QWidget):
    toast_requested = Signal(str)

    def __init__(self, video_dir_getter):
        super().__init__()
        self._video_dir_getter = video_dir_getter
        self._mode = "dark"
        self.proj = ENG.default_project("")
        self.project_path = ""
        self.compositor = ENG.StudioCompositor()
        self.cur_t = 0.0
        self.playing = False
        self.sel_track = ""
        self.sel_id = ""
        self._frame_cache: dict[int, Image.Image] = {}
        self._webcam_cache: dict[int, Image.Image] = {}
        self._undo_stack: list[dict] = []
        self._redo_stack: list[dict] = []
        self._export_worker: ExportWorker | None = None
        self._switches: list[MiniSwitch] = []
        self._swatches: dict[str, WallpaperSwatch] = {}
        self._ar_btns: dict[str, QPushButton] = {}
        self._bg_type_btns: dict[str, QPushButton] = {}
        self._insp_tab_btns: list[QPushButton] = []
        self._syncing_ui = False

        self._build_ui()

        self._play_timer = QTimer(self)
        self._play_timer.timeout.connect(self._on_play_tick)
        self._play_timer.setInterval(66)  # ~15fps smooth live preview

        self._render_debounce = QTimer(self)
        self._render_debounce.setSingleShot(True)
        self._render_debounce.setInterval(25)
        self._render_debounce.timeout.connect(self._render_preview_now)

    def set_theme(self, mode: str):
        self._mode = mode
        self.preview.set_theme(mode)
        self.timeline.set_theme(mode)
        for sw in self._switches:
            sw.set_theme(mode)

    # ---------------- Build UI ----------------
