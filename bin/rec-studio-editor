            b = QPushButton("Orig" if ar == "original" else ar)
            b.setObjectName("segBtn")
            b.clicked.connect(lambda _c=False, k=ar: self._set_aspect_ratio(k))
            self._ar_btns[ar] = b
            ar_grid.addWidget(b, i // 4, i % 4)
        lay.addLayout(ar_grid)

        lay.addWidget(self._sec_lbl("Background"))
        bt_row = QHBoxLayout()
        bt_row.setSpacing(4)
        for key, lbl in (("preset", "Wallpaper"), ("gradient", "Gradient"), ("solid", "Solid"), ("image", "Image")):
            b = QPushButton(lbl)
            b.setObjectName("segBtn")
            b.clicked.connect(lambda _c=False, k=key: self._set_bg_type(k))
