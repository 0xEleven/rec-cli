    # ---------------- Inspector Helper Builders ----------------
    def _scroll_wrap(self, inner: QWidget) -> QScrollArea:
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        sc.setWidget(inner)
        return sc

    def _sec_lbl(self, txt: str) -> QLabel:
        l = QLabel(txt.upper())
        l.setObjectName("sectionLabel")
        return l

    def _slider_row(self, parent_lay: QVBoxLayout, label: str, lo: int, hi: int, val: int, suffix: str, on_change) -> tuple[QSlider, QLabel]:
        hdr = QHBoxLayout()
        l1 = QLabel(label)
        l1.setObjectName("muted")
        val_lbl = QLabel(f"{val}{suffix}")
        val_lbl.setObjectName("monoTag")
        hdr.addWidget(l1)
        hdr.addStretch()
        hdr.addWidget(val_lbl)
        parent_lay.addLayout(hdr)

        sld = QSlider(Qt.Orientation.Horizontal)
        sld.setRange(lo, hi)
        sld.setValue(val)

        def _changed(v):
            val_lbl.setText(f"{v}{suffix}")
            if not self._syncing_ui:
                on_change(v)

        sld.valueChanged.connect(_changed)
        parent_lay.addWidget(sld)
        return (sld, val_lbl)

    def _toggle_row(self, parent_lay: QVBoxLayout, label: str, checked: bool, on_change) -> MiniSwitch:
        r = QHBoxLayout()
        l = QLabel(label)
        l.setObjectName("muted")
        sw = MiniSwitch(checked=checked)
        self._switches.append(sw)

        def _t(v):
            if not self._syncing_ui:
                on_change(v)

        sw.toggled.connect(_t)
        r.addWidget(l)
        r.addStretch()
        r.addWidget(sw)
        parent_lay.addLayout(r)
        return sw

    def _switch_inspector_tab(self, idx: int):
        self.insp_stack.setCurrentIndex(idx)
        for i, b in enumerate(self._insp_tab_btns):
            b.setProperty("active", i == idx)
            b.style().unpolish(b)
            b.style().polish(b)
        if idx == 3:
            self._update_export_summary()

