#!/usr/bin/env bash
set -euo pipefail

# rec-cli — Process-managed terminal clip recorder CLI (v1.3.0)
# Manage parallel recordings across tabs, panes, and SSH sessions by PID or name.

VERSION="2.1.0"

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rec-cli"
CONF_FILE="$CONF_DIR/config"
AUTO_OFF_FLAG="$CONF_DIR/auto-disabled"
LEGACY_AUTO_OFF="$HOME/.config/term-rec/auto-disabled"
RUNTIME_DIR="${REC_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/rec-cli-$(id -u)}"

if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

# Verify REC_PTY_PID actually belongs to THIS terminal's PTY (never trust leaked env vars from another tab/tmux/GUI!)
if [[ -n "${REC_PTY_PID:-}" ]]; then
  if ! kill -0 "$REC_PTY_PID" 2>/dev/null; then
    unset REC_PTY_PID REC_PTY_TTY REC_RUNTIME_DIR _TERM_REC_ACTIVE _TERM_REC_META _TERM_REC_MARKER
  elif [[ -n "${REC_PTY_TTY:-}" && -t 0 ]]; then
    _cur_tty="$(tty 2>/dev/null || true)"
    if [[ -n "$_cur_tty" && "$_cur_tty" != "not a tty" && "$_cur_tty" != "$REC_PTY_TTY" ]]; then
      unset REC_PTY_PID REC_PTY_TTY REC_RUNTIME_DIR _TERM_REC_ACTIVE _TERM_REC_META _TERM_REC_MARKER
    fi
    unset _cur_tty
  fi
fi

REC_DIR="${REC_DIR:-${TERM_REC_DIR:-$HOME/Videos/terminal-recordings}}"
CAST_DIR="$REC_DIR/casts"
VIDEO_DIR="${REC_VIDEO_DIR:-${TERM_VIDEO_DIR:-$HOME/Videos/content}}"
REC_SPEED="${REC_SPEED:-${CAST_SPEED:-2}}"
REC_MAX_SECS="${REC_MAX_SECS:-${CAST_MAX_SECS:-300}}"
REC_TERMINALS="${REC_TERMINALS:-kitty,tabby}"
REC_THEME="${REC_THEME:-tokyo-night}"
REC_RESOLUTION="${REC_RESOLUTION:-auto}"
REC_FRAME="${REC_FRAME:-on}"
REC_REDACT="${REC_REDACT:-on}"
REC_REELS_COPY="${REC_REELS_COPY:-off}"
REC_AUTO_RECORD="${REC_AUTO_RECORD:-off}"

detect_display_info() {
  local dims="" w=0 h=0 preset="1080p"

  if [[ -z "$dims" ]] && command -v hyprctl >/dev/null 2>&1; then
    dims="$(hyprctl monitors 2>/dev/null | grep -oE '[0-9]{3,4}x[0-9]{3,4}@' | head -n 1 | tr -d '@' || true)"
  fi
  if [[ -z "$dims" ]] && command -v wlr-randr >/dev/null 2>&1; then
    dims="$(wlr-randr 2>/dev/null | grep -E 'current' | grep -oE '[0-9]{3,4}x[0-9]{3,4}' | head -n 1 || true)"
  fi
  if [[ -z "$dims" ]] && command -v swaymsg >/dev/null 2>&1; then
    dims="$(swaymsg -t get_outputs 2>/dev/null | python3 -c 'import json,sys; o=[x for x in json.load(sys.stdin) if x.get("active")]; m=o[0]["current_mode"] if o else {}; print(f"{m[\"width\"]}x{m[\"height\"]}") if m else None' 2>/dev/null || true)"
  fi
  if [[ -z "$dims" ]] && command -v kscreen-doctor >/dev/null 2>&1; then
    dims="$(kscreen-doctor -o 2>/dev/null | grep -oE '[0-9]{3,4}x[0-9]{3,4}@[^ ]*\*' | head -n 1 | cut -d@ -f1 || true)"
  fi
  if [[ -z "$dims" ]] && command -v xrandr >/dev/null 2>&1; then
    dims="$(xrandr --current 2>/dev/null | grep '\*' | grep -oE '[0-9]{3,4}x[0-9]{3,4}' | head -n 1 || true)"
  fi
  if [[ -z "$dims" ]]; then
    local best_area=0 f st dir mode cw ch area
    for f in /sys/class/drm/*/status; do
      [[ -f "$f" ]] || continue
      st="$(cat "$f" 2>/dev/null || true)"
      [[ "$st" == "connected" ]] || continue
      dir="$(dirname "$f")"
      mode="$(head -n 1 "$dir/modes" 2>/dev/null || true)"
      if [[ "$mode" =~ ^([0-9]+)x([0-9]+) ]]; then
        cw="${BASH_REMATCH[1]}"
        ch="${BASH_REMATCH[2]}"
        area=$(( cw * ch ))
        if (( area > best_area )); then
          best_area=$area
          dims="${cw}x${ch}"
        fi
      fi
    done
  fi

  if [[ "$dims" =~ ^([0-9]+)x([0-9]+)$ ]]; then
    w="${BASH_REMATCH[1]}"
    h="${BASH_REMATCH[2]}"
    if (( w >= 3840 || h >= 2160 )); then
      preset="4k"
    elif (( w >= 2560 || h >= 1440 )); then
      preset="1440p"
    elif (( w >= 1920 || h >= 1080 )); then
      preset="1080p"
    else
      preset="720p"
    fi
    echo "${dims} -> ${preset}"
  else
    echo "unknown -> 1080p"
  fi
}

find_share_dir() {
  local script_dir
  script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  for cand in \
    "$script_dir/../share/rec-cli" \
    "$script_dir/.." \
    "/usr/share/rec-cli" \
    "/usr/local/share/rec-cli" \
    "${XDG_DATA_HOME:-$HOME/.local/share}/rec-cli"
  do
    if [[ -d "$cand/shell" ]]; then
      echo "$cand"
      return 0
    fi
  done
  return 1
}

C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_DIM=$'\033[2m'
C_RED=$'\033[38;2;247;118;142m'
C_GREEN=$'\033[38;2;158;206;106m'
C_PURPLE=$'\033[38;2;187;154;247m'
C_CYAN=$'\033[38;2;125;207;255m'
C_YELLOW=$'\033[38;2;224;175;104m'

show_help() {
  cat <<EOF
${C_PURPLE}${C_BOLD}rec-cli${C_RESET} v${VERSION} - Process-Managed Terminal Clip Recorder (Zsh, Bash, Fish)

${C_CYAN}Process & Parallel Recording Control (works across tabs, panes & SSH):${C_RESET}
  ${C_BOLD}rec gui${C_RESET}                        Open the native Rust desktop app (live sessions, 1-click record & clips library)
  ${C_BOLD}rec ps${C_RESET}                         List all live recording processes with PID, state, name & cmd
  ${C_BOLD}rec start [--new] [name]${C_RESET}       Start recording this terminal (or: rec start <pid> [--new] [name])
  ${C_BOLD}rec stop [--bg] [pid|name|all]${C_RESET} Stop & save MP4 right now without dropping SSH (--bg for background)
  ${C_BOLD}rec save [pid|name] [label]${C_RESET}    Save an instant MP4 snapshot right now without stopping recording
  ${C_BOLD}rec pause [pid|name|all]${C_RESET}       Pause recording live (keeps SSH/shell alive)
  ${C_BOLD}rec resume [pid|name|all]${C_RESET}      Resume a paused recording
  ${C_BOLD}rec cancel [pid|name|all]${C_RESET}      Stop & discard recording without saving
  ${C_BOLD}rec mark [pid|name] <label>${C_RESET}    Drop a YouTube chapter marker into this or another PID
  ${C_BOLD}rec kill <pid|name|all>${C_RESET}        Force-terminate a recording session process
  ${C_BOLD}rec status${C_RESET}                     Show current tab status, active PIDs, config & clip stats

${C_CYAN}Content Tools:${C_RESET}
  ${C_BOLD}rec list${C_RESET}                       List saved MP4 clips in ${VIDEO_DIR}
  ${C_BOLD}rec play [clip|latest]${C_RESET}         Preview the latest (or named) clip
  ${C_BOLD}rec gif [clip|latest]${C_RESET}          Export a palette-optimized GIF
  ${C_BOLD}rec thumb [clip|latest]${C_RESET}        Extract a PNG thumbnail frame
  ${C_BOLD}rec trim <clip> <st> <en>${C_RESET}      Lossless fast trim (e.g. rec trim latest 00:05 01:20)
  ${C_BOLD}rec reels <file.cast>${C_RESET}          Render a 9:16 TikTok/Reels cursor-following clip
  ${C_BOLD}rec stats${C_RESET}                      Show total runtime, disk usage, and top tools
  ${C_BOLD}rec render [speed]${C_RESET}             Convert pending finished .cast files now
  ${C_BOLD}rec open${C_RESET}                       Open clips folder in your file manager
  ${C_BOLD}rec clear [--yes]${C_RESET}              Delete saved MP4 clips and raw casts

${C_CYAN}Auto-Record & Configuration:${C_RESET}
  ${C_BOLD}rec auto on|off${C_RESET}                Toggle auto-recording on new allowed terminal tabs
  ${C_BOLD}rec config auto${C_RESET}                Auto-pick resolution from this device's screen
  ${C_BOLD}rec config [key val]${C_RESET}           Configure resolution, reels-copy, speed, frame, redact, theme, terminals
  ${C_BOLD}rec init <shell>${C_RESET}               Print shell integration for zsh, bash, or fish
  ${C_BOLD}rec doctor${C_RESET}                     Check dependencies & display resolution
  ${C_BOLD}rec version${C_RESET}                    Print version
EOF
}

is_auto_disabled() {
  if [[ -f "$AUTO_OFF_FLAG" || -f "$LEGACY_AUTO_OFF" ]]; then
    return 0
  fi
  case "${REC_AUTO_RECORD,,}" in
    on|enable|enabled|1|true|yes) return 1 ;;
    *) return 0 ;;
  esac
}

# Python helper for live PID/name session management (`rec ps`, remote `stop`/`save`/`pause`/`resume`/`cancel`/`start`/`mark`/`kill`)
run_session_mgr() {
  local script_dir
  script_dir="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
  python3 - "$RUNTIME_DIR" "${REC_PTY_PID:-}" "$script_dir" "$@" <<'PYEOF'
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

runtime_dir = Path(sys.argv[1])
my_pid = int(sys.argv[2]) if sys.argv[2].isdigit() else 0
script_dir = Path(sys.argv[3])
action = sys.argv[4]
args = sys.argv[5:]

sess_dir = runtime_dir / "sessions"
active_dir = runtime_dir / "active"
sess_dir.mkdir(parents=True, exist_ok=True)
active_dir.mkdir(parents=True, exist_ok=True)

C_RESET = "\033[0m"
C_BOLD = "\033[1m"
C_DIM = "\033[2m"
C_RED = "\033[38;2;247;118;142m"
C_GREEN = "\033[38;2;158;206;106m"
C_PURPLE = "\033[38;2;187;154;247m"
C_CYAN = "\033[38;2;125;207;255m"
C_YELLOW = "\033[38;2;224;175;104m"


def is_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def load_legacy_asciinema() -> list[dict]:
    """Detect live pre-v1.3.0 `asciinema rec` sessions still attached to an open terminal."""
    uid = os.getuid()
    term_names = {
        "kitty": "kitty", "tabby": "tabby", "alacritty": "alacritty",
        "wezterm": "wezterm", "wezterm-gui": "wezterm", "ghostty": "ghostty",
        "foot": "foot", "konsole": "konsole", "gnome-terminal": "gnome-terminal",
        "gnome-terminal-": "gnome-terminal", "gnome-terminal-server": "gnome-terminal",
        "kgx": "gnome-terminal", "xfce4-terminal": "xfce4-terminal",
        "tilix": "tilix", "terminator": "terminator", "xterm": "xterm",
    }
    procs = {}
    try:
        for entry in os.scandir("/proc"):
            if not entry.name.isdigit():
                continue
            pid = int(entry.name)
            try:
                if os.stat(entry.path).st_uid != uid:
                    continue
                with open(f"{entry.path}/stat", "r", encoding="utf-8", errors="replace") as f:
                    st = f.read()
                lp, rp = st.find("("), st.rfind(")")
                if lp == -1 or rp == -1:
                    continue
                comm = st[lp + 1:rp]
                fields = st[rp + 2:].split()
                if fields[0] in ("Z", "X"):
                    continue
                with open(f"{entry.path}/cmdline", "rb") as f:
                    parts = [x.decode("utf-8", "replace") for x in f.read().split(b"\x00") if x]
                procs[pid] = {"ppid": int(fields[1]), "comm": comm, "parts": parts}
            except OSError:
                continue
    except OSError:
        return []

    def ancestor_term(pid: int) -> str:
        cur = pid
        for _ in range(7):
            info = procs.get(cur)
            if not info or info["ppid"] <= 1 or info["ppid"] == cur:
                break
            pinfo = procs.get(info["ppid"])
            if not pinfo:
                break
            c = pinfo["comm"].lower()
            if c in term_names:
                return term_names[c]
            if pinfo["parts"]:
                b = os.path.basename(pinfo["parts"][0]).lower()
                if b in term_names:
                    return term_names[b]
                if "tabby" in " ".join(pinfo["parts"][:2]).lower():
                    return "tabby"
            cur = info["ppid"]
        return ""

    found = []
    for pid, info in procs.items():
        parts = info["parts"]
        if not parts:
            continue
        if ("asciinema" in os.path.basename(parts[0]) or any("asciinema" in p for p in parts[:2])) and "rec" in parts[1:4]:
            term = ancestor_term(pid)
            try:
                pts = os.readlink(f"/proc/{pid}/fd/0")
            except OSError:
                pts = ""
            # Skip orphaned processes from closed windows
            if not term or not pts.startswith("/dev/pts/") or pts.endswith("(deleted)"):
                continue
            cast = next((p for p in reversed(parts) if p.endswith(".cast")), "")
            started_at = os.path.getmtime(cast) if cast and os.path.exists(cast) else 0.0
            cast_size = os.path.getsize(cast) if cast and os.path.exists(cast) else 0
            try:
                cwd = os.readlink(f"/proc/{pid}/cwd")
            except OSError:
                cwd = ""
            found.append({
                "pid": pid,
                "child_pid": 0,
                "state": "recording",
                "name": "old-tab",
                "terminal": term,
                "cast": cast,
                "meta": "",
                "cwd": cwd,
                "fg_cmd": "asciinema rec (old tab — type 'exit' to finish)",
                "last_cmd": "",
                "started_at": started_at,
                "cast_size": cast_size,
                "legacy": True,
            })
    return found


def load_sessions() -> list[dict]:
    items = []
    for p in sorted(sess_dir.glob("*.json")):
        try:
            data = json.loads(p.read_text(encoding="utf-8"))
            pid = int(data.get("pid", 0))
            if pid <= 0 or not is_alive(pid):
                p.unlink(missing_ok=True)
                (active_dir / str(pid)).unlink(missing_ok=True)
                continue
            # Refresh live cast size if file exists
            cast = data.get("cast", "")
            if cast and os.path.exists(cast):
                data["cast_size"] = os.path.getsize(cast)
            items.append(data)
        except Exception:
            continue
    items.extend(load_legacy_asciinema())
    items.sort(key=lambda x: (0 if x.get("state") == "recording" else 1 if x.get("state") == "paused" else 2, x.get("pid", 0)))
    return items


def fmt_elapsed(started_at: float) -> str:
    if not started_at or started_at <= 0:
        return "-"
    sec = max(0, int(time.time() - started_at))
    m, s = divmod(sec, 60)
    h, m = divmod(m, 60)
    return f"{h:02d}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"


def fmt_size(n: int) -> str:
    if not n:
        return "-"
    for u in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.0f}{u}" if u == "B" else f"{n:.1f}{u}"
        n /= 1024
    return f"{n:.1f}T"


def resolve_targets(sessions: list[dict], target: str, require_active: bool = False) -> list[dict]:
    pool = [s for s in sessions if s.get("state") in ("recording", "paused")] if require_active else sessions
    if not target:
        if my_pid:
            mine = [s for s in sessions if s["pid"] == my_pid]
            if mine:
                return mine
        return []
    if target.lower() == "all":
        return pool
    if target.isdigit():
        tpid = int(target)
        return [s for s in sessions if s["pid"] == tpid or s.get("child_pid") == tpid]
    tlow = target.lower()
    exact = [s for s in pool if (s.get("name") or "").lower() == tlow]
    if exact:
        return exact
    return [
        s for s in pool
        if tlow in (s.get("name") or "").lower()
        or tlow in (s.get("fg_cmd") or "").lower()
        or tlow in (s.get("last_cmd") or "").lower()
    ]


def send_ctrl(pid: int, command_line: str, wait_ack: bool = True, timeout: float = 2.0) -> dict | None:
    req_id = f"{os.getpid()}-{time.time_ns()}"
    ack_file = sess_dir / f"{pid}.ack.{req_id}"
    cmd_file = sess_dir / f"{pid}.cmd"
    with open(cmd_file, "a", encoding="utf-8") as f:
        f.write(f"REQ:{req_id} {command_line.strip()}\n")
    os.kill(pid, signal.SIGUSR1)
    if not wait_ack:
        return None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if ack_file.exists():
            try:
                data = json.loads(ack_file.read_text(encoding="utf-8"))
            except Exception:
                data = {}
            ack_file.unlink(missing_ok=True)
            return data
        if not is_alive(pid):
            break
        time.sleep(0.02)
    return None


def find_cast2mp4() -> str | None:
    cand = script_dir / "cast2mp4"
    if cand.is_file() and os.access(cand, os.X_OK):
        return str(cand)
    return shutil.which("cast2mp4")


def render_cast_now(cast_path: str, manual: bool) -> tuple[bool, list[str], str]:
    """Render a finalized .cast synchronously and return (ok, saved_mp4_paths, error_msg)."""
    if not cast_path or not os.path.exists(cast_path):
        return (True, [], "")
    c2m = find_cast2mp4()
    if not c2m or not shutil.which("agg") or not shutil.which("ffmpeg"):
        return (False, [], "agg/ffmpeg/cast2mp4 not available")
    cmd = [c2m]
    if not manual:
        cmd.append("--auto")
    cmd.extend(["--cleanup", "--print-output", cast_path])
    proc = subprocess.run(cmd, capture_output=True, text=True)
    saved = [
        line[len("SAVED:"):].strip()
        for line in (proc.stdout or "").splitlines()
        if line.startswith("SAVED:")
    ]
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "render failed").strip()
        return (False, saved, err)
    return (True, saved, "")


sessions = load_sessions()

if action == "ps":
    if not sessions:
        print(f"{C_DIM}No active rec-cli sessions. Open a terminal or run 'rec start'.{C_RESET}")
        sys.exit(0)
    print(f"{C_PURPLE}{C_BOLD}{'PID':<8} {'STATE':<10} {'NAME':<16} {'TERM':<8} {'TIME':<8} {'SIZE':<7} {'RUNNING / DIR'}{C_RESET}")
    for s in sessions:
        pid = s["pid"]
        st = s.get("state", "standby")
        if st == "recording":
            st_col = f"{C_RED}● REC     {C_RESET}"
        elif st == "paused":
            st_col = f"{C_YELLOW}❚❚ PAUSED {C_RESET}"
        else:
            st_col = f"{C_DIM}○ STANDBY {C_RESET}"
        name = s.get("name") or (s.get("last_cmd", "").split()[0] if s.get("last_cmd") else "auto")
        if pid == my_pid:
            name = f"{name}*"
        name = name[:15]
        term = (s.get("terminal") or "tty")[:7]
        el = fmt_elapsed(s.get("started_at", 0)) if st != "standby" else "-"
        sz = fmt_size(s.get("cast_size", 0)) if st != "standby" else "-"
        cwd = (s.get("cwd") or "").replace(str(Path.home()), "~")
        info = s.get("fg_cmd") or s.get("last_cmd") or cwd
        if s.get("fg_cmd") and cwd:
            info = f"{s['fg_cmd']}  ({cwd})"
        print(f"{pid:<8} {st_col} {name:<16} {term:<8} {el:<8} {sz:<7} {info[:58]}")
    print(f"{C_DIM}(* = current terminal; manage any PID from any terminal: rec start <pid>, rec stop <pid>, rec save <pid>, rec pause <pid>){C_RESET}")
    sys.exit(0)

if action == "count":
    rec_n = sum(1 for s in sessions if s.get("state") == "recording")
    paused_n = sum(1 for s in sessions if s.get("state") == "paused")
    standby_n = sum(1 for s in sessions if s.get("state") == "standby")
    print(f"{rec_n} recording, {paused_n} paused, {standby_n} standby")
    sys.exit(0)

if action in ("stop", "cancel", "pause", "resume"):
    bg_mode = False
    clean_args = []
    for a in args:
        if a in ("--bg", "--background", "-b"):
            bg_mode = True
        else:
            clean_args.append(a)
    target = clean_args[0] if clean_args else ""
    matches = resolve_targets(sessions, target, require_active=(action != "resume"))
    if not matches:
        if not target and os.environ.get("ASCIINEMA_REC"):
            if action == "cancel":
                cast_f = os.environ.get("_TERM_REC_CAST", "")
                meta_f = os.environ.get("_TERM_REC_META", "")
                for fpath in (cast_f, meta_f):
                    if fpath and os.path.exists(fpath):
                        try:
                            os.unlink(fpath)
                        except OSError:
                            pass
                print(f"{C_YELLOW}✕ Discarded legacy asciinema clip.{C_RESET} Type 'exit' or Ctrl+D to close this pre-v1.3.0 tab; new tabs use live rec-pty.", file=sys.stderr)
                sys.exit(0)
            print(
                f"{C_YELLOW}This tab is running a legacy asciinema session (opened before v1.3.0).{C_RESET}\n"
                f"Type 'exit' or press Ctrl+D to stop & save it — new tabs automatically use rec-pty with live 'rec stop' / 'rec pause' / 'rec ps'.",
                file=sys.stderr,
            )
            sys.exit(1)
        if not target:
            print("Not currently recording in this terminal. Run 'rec start' to begin or 'rec ps' to manage other terminals.", file=sys.stderr)
        else:
            print(f"No matching active recording found for '{target}'. Run 'rec ps' to list PIDs.", file=sys.stderr)
        sys.exit(1)
    for s in matches:
        pid = s["pid"]
        if s.get("legacy"):
            print(f"{C_YELLOW}PID {pid} is a legacy asciinema tab (pre-v1.3.0).{C_RESET} Type 'exit' inside that tab to save it, or 'rec kill {pid}' to terminate it.", file=sys.stderr)
            continue
        label = s.get("name") or s.get("fg_cmd") or f"PID {pid}"
        if action == "stop":
            if bg_mode:
                send_ctrl(pid, "stop", wait_ack=True)
                print(f"{C_GREEN}■ Stopped PID {pid}{C_RESET} ({label}) - rendering MP4 in background (shell/SSH stays alive).")
            else:
                ack = send_ctrl(pid, "stop_handover", wait_ack=True)
                cast_path = (ack or {}).get("cast", "")
                was_manual = bool((ack or {}).get("manual", True))
                print(f"{C_GREEN}■ Stopped PID {pid}{C_RESET} ({label}) - saving MP4...", flush=True)
                if not cast_path:
                    print(f"{C_DIM}  ○ No terminal output recorded; nothing to save.{C_RESET}")
                else:
                    ok, saved, err = render_cast_now(cast_path, manual=was_manual)
                    if ok and saved:
                        for mp4 in saved:
                            sz = fmt_size(os.path.getsize(mp4)) if os.path.exists(mp4) else "-"
                            print(f"{C_GREEN}✓ Saved:{C_RESET} {C_CYAN}{mp4}{C_RESET} ({sz})")
                    elif ok:
                        print(f"{C_DIM}  ○ Skipped empty/idle recording.{C_RESET}")
                    else:
                        print(f"{C_YELLOW}⚠ Could not render MP4 ({err}). Raw cast kept at:{C_RESET} {cast_path}", file=sys.stderr)
        elif action == "cancel":
            send_ctrl(pid, "cancel", wait_ack=True)
            print(f"{C_YELLOW}✕ Canceled PID {pid}{C_RESET} ({label}) - clip discarded (shell/SSH stays alive).")
        elif action == "pause":
            send_ctrl(pid, "pause", wait_ack=True)
            print(f"{C_YELLOW}❚❚ Paused PID {pid}{C_RESET} ({label}).")
        elif action == "resume":
            send_ctrl(pid, "resume", wait_ack=True)
            print(f"{C_RED}● Resumed PID {pid}{C_RESET} ({label}).")
    sys.exit(0)

if action == "save":
    # Instant snapshot save without stopping the active recording: `rec save [pid|name] [clip-name]`
    target_sessions = []
    clip_name = ""
    if args:
        cand = resolve_targets(sessions, args[0], require_active=True)
        if cand:
            target_sessions = cand
            clip_name = " ".join(args[1:]).strip()
        else:
            target_sessions = resolve_targets(sessions, "", require_active=True)
            clip_name = " ".join(args).strip()
    else:
        target_sessions = resolve_targets(sessions, "", require_active=True)
    if not target_sessions:
        print("Not currently recording in this terminal. Run 'rec start' first (or 'rec render' for pending casts).", file=sys.stderr)
        sys.exit(1)
    for s in target_sessions:
        pid = s["pid"]
        if s.get("legacy"):
            print(f"{C_YELLOW}PID {pid} is a legacy asciinema tab and does not support live snapshots.{C_RESET}", file=sys.stderr)
            continue
        ack = send_ctrl(pid, f"snapshot {clip_name}".strip(), wait_ack=True)
        if not ack or not ack.get("ok"):
            print(f"{C_YELLOW}Could not capture snapshot from PID {pid}.{C_RESET}", file=sys.stderr)
            continue
        cast_path = ack.get("cast", "")
        print(f"{C_CYAN}◆ Saving snapshot of PID {pid}...{C_RESET}", flush=True)
        ok, saved, err = render_cast_now(cast_path, manual=True)
        if ok and saved:
            for mp4 in saved:
                sz = fmt_size(os.path.getsize(mp4)) if os.path.exists(mp4) else "-"
                print(f"{C_GREEN}✓ Saved snapshot:{C_RESET} {C_CYAN}{mp4}{C_RESET} ({sz}) {C_DIM}(PID {pid} still recording){C_RESET}")
        elif ok:
            print(f"{C_DIM}  ○ No terminal output recorded yet; nothing to save.{C_RESET}")
        else:
            print(f"{C_YELLOW}⚠ Could not render snapshot ({err}). Raw cast kept at:{C_RESET} {cast_path}", file=sys.stderr)
    sys.exit(0)

if action == "start":
    # Remote or in-place start: `rec start [--new] [pid] [name]`
    force_new = False
    clean_args = []
    for a in args:
        if a in ("--new", "--restart", "-n"):
            force_new = True
        else:
            clean_args.append(a)
    if not clean_args or not clean_args[0].isdigit():
        sys.exit(2)  # caller handles local start
    target_pid = int(clean_args[0])
    custom_name = clean_args[1] if len(clean_args) > 1 else ""
    matches = [s for s in sessions if s["pid"] == target_pid]
    if not matches:
        print(f"No live rec-cli session with PID {target_pid}. Run 'rec ps' to see live PIDs.", file=sys.stderr)
        sys.exit(1)
    verb = "restart" if force_new else "start"
    ack = send_ctrl(target_pid, f"{verb} {custom_name}".strip(), wait_ack=True)
    if ack and not ack.get("ok") and ack.get("error") == "already_recording":
        cur_name = ack.get("name") or "auto"
        print(
            f"{C_YELLOW}Already recording on PID {target_pid}{C_RESET} ({cur_name}).\n"
            f"  Use {C_BOLD}rec stop{C_RESET} to stop & save, {C_BOLD}rec save{C_RESET} for an instant snapshot, "
            f"or {C_BOLD}rec start --new [name]{C_RESET} to save & start a new clip.",
            file=sys.stderr,
        )
        sys.exit(1)
    if ack and ack.get("resumed"):
        print(f"{C_RED}● Resumed recording on PID {target_pid}{C_RESET}.")
        sys.exit(0)
    lbl = f" (name: {custom_name})" if custom_name else " (auto-named by process)"
    if force_new:
        print(f"{C_RED}● Started new clip on PID {target_pid}{C_RESET}{lbl} {C_DIM}(previous clip saving in background){C_RESET}.")
    else:
        print(f"{C_RED}● Started recording on PID {target_pid}{C_RESET}{lbl}.")
    sys.exit(0)

if action == "mark":
    if not args:
        print("Usage: rec mark [pid|name] <chapter label>", file=sys.stderr)
        sys.exit(1)
    # Check if first arg matches a live PID or named session when 2+ args provided
    target_sessions = []
    label = ""
    if len(args) >= 2:
        cand = resolve_targets(sessions, args[0], require_active=True)
        if cand:
            target_sessions = cand
            label = " ".join(args[1:])
    if not target_sessions:
        target_sessions = resolve_targets(sessions, "", require_active=True)
        label = " ".join(args)
    if not target_sessions:
        print("No active recording in this tab. Specify a PID from 'rec ps': rec mark <pid> <label>", file=sys.stderr)
        sys.exit(1)
    for s in target_sessions:
        send_ctrl(s["pid"], f"mark {label}", wait_ack=True)
        print(f"{C_PURPLE}◆ Chapter marker added to PID {s['pid']}:{C_RESET} {C_BOLD}{label}{C_RESET}")
    sys.exit(0)

if action == "kill":
    if not args:
        print("Usage: rec kill <pid|name|all>", file=sys.stderr)
        sys.exit(1)
    matches = resolve_targets(sessions, args[0], require_active=False)
    if not matches:
        print(f"No live rec-cli session matching '{args[0]}'.", file=sys.stderr)
        sys.exit(1)
    for s in matches:
        pid = s["pid"]
        try:
            os.kill(pid, signal.SIGTERM)
            print(f"{C_RED}☠ Terminated rec session PID {pid}{C_RESET}")
        except OSError as exc:
            print(f"Failed to terminate PID {pid}: {exc}", file=sys.stderr)
    sys.exit(0)
PYEOF
}

resolve_clip() {
  local arg="${1:-latest}"
  if [[ "$arg" == "latest" || -z "$arg" ]]; then
    local latest
    latest="$(ls -t "$VIDEO_DIR"/*.mp4 2>/dev/null | head -n 1 || true)"
    if [[ -z "$latest" ]]; then
      echo "No MP4 clips found in $VIDEO_DIR" >&2
      return 1
    fi
    echo "$latest"
    return 0
  fi
  if [[ -f "$arg" ]]; then
    echo "$arg"
    return 0
  fi
  if [[ -f "$VIDEO_DIR/$arg" ]]; then
    echo "$VIDEO_DIR/$arg"
    return 0
  fi
  local match
  match="$(ls -t "$VIDEO_DIR"/*"${arg}"*.mp4 2>/dev/null | head -n 1 || true)"
  if [[ -n "$match" ]]; then
    echo "$match"
    return 0
  fi
  echo "Clip not found: $arg" >&2
  return 1
}

cmd_init() {
  local sh="${1:-}"
  if [[ -z "$sh" ]]; then
    echo "Usage: rec-cli init <zsh|bash|fish>" >&2
    exit 1
  fi
  local share_dir
  if ! share_dir="$(find_share_dir)"; then
    echo "Error: could not locate rec-cli shell scripts directory." >&2
    exit 1
  fi
  case "$sh" in
    zsh|bash|fish)
      local file="$share_dir/shell/rec.${sh}"
      [[ -f "$file" ]] || { echo "Error: missing shell file: $file" >&2; exit 1; }
      cat "$file"
      ;;
    *)
      echo "Unsupported shell '$sh'. Supported: zsh, bash, fish." >&2
      exit 1
      ;;
  esac
}

cmd_status() {
  mkdir -p "$CAST_DIR" "$VIDEO_DIR"
  local disp_info counts
  disp_info="$(detect_display_info)"
  counts="$(run_session_mgr count 2>/dev/null || echo "0")"
  echo -e "${C_PURPLE}${C_BOLD}=== rec-cli v${VERSION} Status ===${C_RESET}"

  if [[ -n "${REC_PTY_PID:-}" && -f "${RUNTIME_DIR}/active/${REC_PTY_PID}" ]]; then
    local st
    st="$(cat "${RUNTIME_DIR}/active/${REC_PTY_PID}" 2>/dev/null || echo "REC")"
    if [[ "$st" == "PAUSED" ]]; then
      echo -e "  This tab:     ${C_YELLOW}${C_BOLD}❚❚ PAUSED${C_RESET} (PID ${REC_PTY_PID})"
    else
      echo -e "  This tab:     ${C_RED}${C_BOLD}● RECORDING${C_RESET} (PID ${REC_PTY_PID})"
    fi
  elif [[ -n "${REC_PTY_PID:-}" ]]; then
    echo -e "  This tab:     ${C_DIM}○ Standby${C_RESET} (PID ${REC_PTY_PID} - run 'rec start' to record)"
  elif [[ -n "${ASCIINEMA_REC:-}" ]]; then
    echo -e "  This tab:     ${C_RED}${C_BOLD}● RECORDING${C_RESET} (legacy asciinema)"
  else
    echo -e "  This tab:     ${C_DIM}○ Not recording${C_RESET}  ${C_DIM}(run 'rec start' to record)${C_RESET}"
  fi

  if is_auto_disabled; then
    echo -e "  Auto-record:  ${C_YELLOW}OFF (manual only)${C_RESET}  ${C_DIM}(run 'rec auto on' to enable)${C_RESET}"
  else
    echo -e "  Auto-record:  ${C_GREEN}ON (${REC_TERMINALS})${C_RESET}  ${C_DIM}(run 'rec auto off' for manual)${C_RESET}"
  fi

  echo -e "  Live panes:   ${C_CYAN}${counts}${C_RESET}  ${C_DIM}(run 'rec ps' to manage by PID)${C_RESET}"

  local mp4_cnt mp4_size
  mp4_cnt="$(find "$VIDEO_DIR" -maxdepth 1 -name '*.mp4' 2>/dev/null | wc -l)"
  mp4_size="$(du -sh "$VIDEO_DIR" 2>/dev/null | cut -f1)"
  echo -e "  Saved clips:  ${C_BOLD}${mp4_cnt}${C_RESET} videos (${mp4_size}) in ${C_CYAN}${VIDEO_DIR}${C_RESET}"
  echo -e "  Display:      ${C_DIM}${disp_info}${C_RESET}"
  echo -e "  Settings:     ${C_DIM}res: ${REC_RESOLUTION} | reels-copy: ${REC_REELS_COPY} | ${REC_SPEED}x | max $((REC_MAX_SECS / 60))m | frame: ${REC_FRAME} | redact: ${REC_REDACT} | theme: ${REC_THEME}${C_RESET}"
}

cmd_auto() {
  mkdir -p "$CONF_DIR"
  case "${1:-}" in
    on|enable|1)
      rm -f "$AUTO_OFF_FLAG" "$LEGACY_AUTO_OFF"
      set_config_key REC_AUTO_RECORD "on"
      echo -e "${C_GREEN}✓ Auto-recording ENABLED${C_RESET} for allowed terminals (${REC_TERMINALS})."
      ;;
    off|disable|0)
      set_config_key REC_AUTO_RECORD "off"
      touch "$AUTO_OFF_FLAG"
      echo -e "${C_YELLOW}✓ Auto-recording DISABLED${C_RESET} - new tabs start in standby and only record when you run ${C_BOLD}rec start${C_RESET}."
      ;;
    *)
      if is_auto_disabled; then
        echo -e "Auto-record is currently ${C_YELLOW}OFF (manual control)${C_RESET}. Use 'rec auto on' or 'rec auto off'."
      else
        echo -e "Auto-record is currently ${C_GREEN}ON${C_RESET}. Use 'rec auto on' or 'rec auto off'."
      fi
      ;;
  esac
}

set_config_key() {
  local key="$1" val="$2"
  mkdir -p "$CONF_DIR"
  touch "$CONF_FILE"
  local tmp
  tmp="$(mktemp)"
  grep -v "^${key}=" "$CONF_FILE" > "$tmp" || true
  printf '%s=%q\n' "$key" "$val" >> "$tmp"
  mv -f "$tmp" "$CONF_FILE"
}

cmd_config() {
  local disp_info
  disp_info="$(detect_display_info)"

  if [[ $# -eq 0 ]]; then
    echo -e "${C_PURPLE}${C_BOLD}rec-cli configuration${C_RESET} (${C_DIM}${CONF_FILE}${C_RESET}):"
    echo "  resolution = ${REC_RESOLUTION}   (auto | 720p | 1080p | 1440p | 4k | reels | reels-4k)"
    echo "  detected   = ${disp_info}"
    echo "  reels-copy = ${REC_REELS_COPY}   (on | off - also export a 9:16 cursor-follow Reels clip)"
    echo "  speed      = ${REC_SPEED}x"
    echo "  max-secs   = ${REC_MAX_SECS}s ($((REC_MAX_SECS / 60)) min)"
    echo "  frame      = ${REC_FRAME}   (on | off)"
    echo "  redact     = ${REC_REDACT}   (on | off)"
    echo "  theme      = ${REC_THEME}   (tokyo-night | dracula | catppuccin | gruvbox | nord)"
    echo "  terminals  = ${REC_TERMINALS}"
    echo "  video-dir  = ${VIDEO_DIR}"
    return 0
  fi

  if [[ "$1" == "auto" && $# -eq 1 ]]; then
    set_config_key REC_RESOLUTION "auto"
    echo -e "${C_GREEN}✓ Resolution set to auto${C_RESET} (detected display: ${C_CYAN}${disp_info}${C_RESET})"
    return 0
  fi

  local key="$1" val="${2:-}"
  if [[ -z "$val" ]]; then
    echo "Usage: rec config <auto | resolution|reels-copy|speed|max-secs|frame|redact|theme|terminals|video-dir> <value>" >&2
    exit 1
  fi
  case "$key" in
    resolution|res)   set_config_key REC_RESOLUTION "$val" ;;
    reels-copy|reels) set_config_key REC_REELS_COPY "$val" ;;
    speed)            set_config_key REC_SPEED "$val" ;;
    max-secs)         set_config_key REC_MAX_SECS "$val" ;;
    frame)            set_config_key REC_FRAME "$val" ;;
    redact)           set_config_key REC_REDACT "$val" ;;
    theme)            set_config_key REC_THEME "$val" ;;
    terminals)        set_config_key REC_TERMINALS "$val" ;;
    video-dir)        set_config_key REC_VIDEO_DIR "$val" ;;
    *)
      echo "Unknown config key: $key" >&2
      exit 1
      ;;
  esac
  echo -e "${C_GREEN}✓ Updated ${key} = ${val}${C_RESET} (saved to ${CONF_FILE})"
}

cmd_reels() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: rec reels <file.cast> [output.mp4]" >&2
    exit 1
  fi
  local input="$1" out="${2:-}"
  if [[ -n "$out" ]]; then
    cast2mp4 --res reels "$input" "$out"
  else
    cast2mp4 --res reels "$input"
  fi
  echo -e "${C_GREEN}✓ Rendered 9:16 cursor-following Reels clip to ${VIDEO_DIR}${C_RESET}"
}

cmd_play() {
  local clip
  clip="$(resolve_clip "${1:-latest}")" || exit 1
  echo -e "${C_CYAN}Playing:${C_RESET} $(basename "$clip")"
  if command -v mpv >/dev/null 2>&1; then
    setsid -f mpv "$clip" </dev/null >/dev/null 2>&1
  elif command -v parole >/dev/null 2>&1; then
    setsid -f parole "$clip" </dev/null >/dev/null 2>&1
  elif command -v vlc >/dev/null 2>&1; then
    setsid -f vlc "$clip" </dev/null >/dev/null 2>&1
  elif command -v xdg-open >/dev/null 2>&1; then
    setsid -f xdg-open "$clip" </dev/null >/dev/null 2>&1
  else
    echo "No player found. File: $clip"
  fi
}

cmd_gif() {
  local clip out width
  clip="$(resolve_clip "${1:-latest}")" || exit 1
  width="${2:-1280}"
  out="${clip%.mp4}.gif"
  echo -e "${C_CYAN}Exporting optimized GIF (${width}px wide):${C_RESET} $(basename "$out")..."
  ffmpeg -y -loglevel error -i "$clip" \
    -vf "fps=20,scale=${width}:-1:flags=lanczos,split[s0][s1];[s0]palettegen=max_colors=128:stats_mode=diff[p];[s1][p]paletteuse=dither=bayer:bayer_scale=3" \
    "$out"
  echo -e "${C_GREEN}✓ Saved GIF:${C_RESET} ${out} ($(du -h "$out" | cut -f1))"
}

cmd_thumb() {
  local clip out dur seek
  clip="$(resolve_clip "${1:-latest}")" || exit 1
  out="${clip%.mp4}.png"
  dur="2"
  if command -v ffprobe >/dev/null 2>&1; then
    dur="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$clip" 2>/dev/null || echo 2)"
  fi
  seek="$(python3 -c "print(f'{max(0.5, float(\"${dur}\") * 0.65):.2f}')" 2>/dev/null || echo 1)"
  ffmpeg -y -loglevel error -ss "$seek" -i "$clip" -frames:v 1 -q:v 2 "$out"
  echo -e "${C_GREEN}✓ Saved thumbnail:${C_RESET} ${out} ($(du -h "$out" | cut -f1))"
}

cmd_trim() {
  if [[ $# -lt 3 ]]; then
    echo "Usage: rec trim <clip|latest> <start> <end>" >&2
    exit 1
  fi
  local clip start end out
  clip="$(resolve_clip "$1")" || exit 1
  start="$2"; end="$3"
  out="${clip%.mp4}_trimmed.mp4"
  ffmpeg -y -loglevel error -ss "$start" -to "$end" -i "$clip" -c copy -movflags +faststart "$out"
  echo -e "${C_GREEN}✓ Saved trimmed clip:${C_RESET} ${out} ($(du -h "$out" | cut -f1))"
}

cmd_stats() {
  mkdir -p "$VIDEO_DIR"
  python3 - "$VIDEO_DIR" <<'PYEOF'
import collections, glob, os, subprocess, sys

vdir = sys.argv[1]
mp4s = sorted(glob.glob(os.path.join(vdir, "*.mp4")))
if not mp4s:
    print(f"No clips in {vdir} yet.")
    sys.exit(0)

total_bytes = sum(os.path.getsize(p) for p in mp4s)
total_secs = 0.0
tools = collections.Counter()

for p in mp4s:
    base = os.path.basename(p)
    tool = base.split("_", 1)[0]
    tools[tool] += 1
    try:
        out = subprocess.check_output(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "default=noprint_wrappers=1:nokey=1", p],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
        total_secs += float(out)
    except Exception:
        pass

def fmt_size(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} TB"

mins, secs = divmod(int(total_secs), 60)
hrs, mins = divmod(mins, 60)
dur_str = f"{hrs}h {mins}m {secs}s" if hrs else f"{mins}m {secs}s"

print("\033[38;2;187;154;247m\033[1m=== rec-cli Library Stats ===\033[0m")
print(f"  Folder:         {vdir}")
print(f"  Total clips:    {len(mp4s)}")
print(f"  Total runtime:  {dur_str}")
print(f"  Disk usage:     {fmt_size(total_bytes)}")
print("  Top tools:")
for tool, cnt in tools.most_common(8):
    print(f"    • {tool}: {cnt} clip(s)")
PYEOF
}

cmd_doctor() {
  local disp_info
  disp_info="$(detect_display_info)"
  echo -e "${C_PURPLE}${C_BOLD}=== rec-cli v${VERSION} Dependency Check ===${C_RESET}"
  local missing=0
  for dep in rec-pty agg ffmpeg python3 flock setsid; do
    if command -v "$dep" >/dev/null 2>&1; then
      echo -e "  ${C_GREEN}✓${C_RESET} ${dep}  ${C_DIM}($(command -v "$dep"))${C_RESET}"
    else
      echo -e "  ${C_RED}✗${C_RESET} ${dep}  ${C_YELLOW}(MISSING)${C_RESET}"
      missing=1
    fi
  done
  if python3 -c "import PIL" 2>/dev/null; then
    echo -e "  ${C_GREEN}✓${C_RESET} python3-pil  ${C_DIM}(window frames & Reels cursor-follow enabled)${C_RESET}"
  else
    echo -e "  ${C_YELLOW}•${C_RESET} python3-pil  ${C_DIM}(install pillow for window frames & Reels auto-reframe)${C_RESET}"
  fi
  echo ""
  echo -e "  ${C_CYAN}Display:${C_RESET}        ${disp_info}"
  echo -e "  ${C_CYAN}Resolution:${C_RESET}     ${REC_RESOLUTION}"
  echo -e "  ${C_CYAN}Detected shell:${C_RESET} ${SHELL:-unknown}"
  echo -e "  ${C_CYAN}Allowed terms:${C_RESET}  ${REC_TERMINALS}"
  if (( missing == 1 )); then
    echo ""
    echo -e "${C_YELLOW}Install missing deps:${C_RESET}"
    echo "  Debian/Ubuntu/Kali: sudo apt install ffmpeg python3 python3-pil util-linux"
    echo "  Arch/Manjaro:       sudo pacman -S ffmpeg python python-pillow util-linux"
    echo "  Fedora/RHEL:        sudo dnf install ffmpeg python3 python3-pillow util-linux"
    echo "  openSUSE:           sudo zypper install ffmpeg python3 python3-Pillow util-linux"
    echo "  agg (any distro):   https://github.com/asciinema/agg/releases"
    return 1
  fi
  echo -e "${C_GREEN}All dependencies look great!${C_RESET}"
}

cmd_list() {
  mkdir -p "$VIDEO_DIR"
  local count
  count="$(find "$VIDEO_DIR" -maxdepth 1 -name '*.mp4' 2>/dev/null | wc -l)"
  if (( count == 0 )); then
    echo -e "${C_DIM}No clips in ${VIDEO_DIR} yet.${C_RESET}"
    return 0
  fi
  echo -e "${C_PURPLE}${C_BOLD}Clips in ${VIDEO_DIR}:${C_RESET}"
  ls -lht --color=auto "$VIDEO_DIR"/*.mp4 2>/dev/null | head -n 30
  echo -e "${C_DIM}Total: ${count} clip(s), $(du -sh "$VIDEO_DIR" | cut -f1)${C_RESET}"
}

cmd_clear() {
  local yes=0
  [[ "${1:-}" == "--yes" || "${1:-}" == "-y" ]] && yes=1
  if (( yes == 0 )); then
    printf "Delete all MP4/GIF/PNG/chapter files in %s and raw casts? [y/N] " "$VIDEO_DIR"
    read -r ans
    [[ "$ans" != [yY]* ]] && { echo "Canceled."; return 0; }
  fi
  rm -f "$VIDEO_DIR"/*.mp4 "$VIDEO_DIR"/*.gif "$VIDEO_DIR"/*.png "$VIDEO_DIR"/*.chapters.txt "$CAST_DIR"/*.cast "$CAST_DIR"/*.meta
  echo -e "${C_GREEN}✓ Cleared all clips and raw casts.${C_RESET}"
}

cmd_open() {
  mkdir -p "$VIDEO_DIR"
  if command -v xdg-open >/dev/null 2>&1; then
    setsid -f xdg-open "$VIDEO_DIR" </dev/null >/dev/null 2>&1
    echo -e "Opened ${C_CYAN}${VIDEO_DIR}${C_RESET}"
  else
    echo "$VIDEO_DIR"
  fi
}

case "${1:-help}" in
  gui|ui|app)
    shift
    if ! command -v rec-gui >/dev/null 2>&1; then
      echo "Error: rec-gui not found in PATH." >&2
      exit 1
    fi
    if command -v setsid >/dev/null 2>&1; then
      setsid -f rec-gui "$@" </dev/null >/dev/null 2>&1
    else
      nohup rec-gui "$@" </dev/null >/dev/null 2>&1 &
    fi
    ;;
  ps|jobs|active) run_session_mgr ps ;;
  stop|off)       shift; run_session_mgr stop "$@" ;;
  save|snap|snapshot) shift; run_session_mgr save "$@" ;;
  cancel|discard) shift; run_session_mgr cancel "$@" ;;
  pause)          shift; run_session_mgr pause "$@" ;;
  resume|unpause) shift; run_session_mgr resume "$@" ;;
  mark|chapter)   shift; run_session_mgr mark "$@" ;;
  kill)           shift; run_session_mgr kill "$@" ;;
  start|on)
    shift
    # Separate optional --new flag from positional [pid] [name]
    _new_flag=()
    _pos=()
    for _a in "$@"; do
      if [[ "$_a" == "--new" || "$_a" == "--restart" || "$_a" == "-n" ]]; then
        _new_flag=("--new")
      else
        _pos+=("$_a")
      fi
    done
    # If first positional arg is a live PID, remotely start recording on that standby session!
    if [[ "${_pos[0]:-}" =~ ^[0-9]+$ ]]; then
      run_session_mgr start "${_new_flag[@]}" "${_pos[@]}"
    elif [[ -n "${REC_PTY_PID:-}" ]]; then
      run_session_mgr start "${_new_flag[@]}" "$REC_PTY_PID" "${_pos[0]:-}"
    else
      # Not yet inside rec-pty: spawn a fresh rec-pty session wrapping the current shell!
      exec rec-pty ${_pos[0]:+--name "${_pos[0]}"} -- "${SHELL:-/bin/sh}"
    fi
    ;;
  init) shift; cmd_init "${1:-}" ;;
  status|st) cmd_status ;;
  auto) shift; cmd_auto "${1:-}" ;;
  config|cfg) shift; cmd_config "$@" ;;
  reels|tiktok|shorts) shift; cmd_reels "$@" ;;
  doctor|check) cmd_doctor ;;
  list|ls) cmd_list ;;
  play|preview) shift; cmd_play "${1:-latest}" ;;
  gif) shift; cmd_gif "${1:-latest}" "${2:-1280}" ;;
  thumb|thumbnail) shift; cmd_thumb "${1:-latest}" ;;
  trim) shift; cmd_trim "$@" ;;
  stats) cmd_stats ;;
  render) shift; casts2mp4 ${1:+--speed "$1"} ;;
  open) cmd_open ;;
  clear|clean) shift; cmd_clear "${1:-}" ;;
  version|-v|--version) echo "rec-cli ${VERSION}" ;;
  help|-h|--help) show_help ;;
  *)
    echo "Unknown subcommand: $1" >&2
    show_help
    exit 1
    ;;
esac
